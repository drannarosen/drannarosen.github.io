---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClusterHero from "../components/ClusterHero.astro";
import JaxstroEcosystem from "../components/JaxstroEcosystem.astro";
import { getPackages } from "../lib/packages";

const title = "Anna Rosen — Computational Astrophysicist";
const description =
  "Anna Rosen builds physics-grounded models of stars and stellar systems, and the differentiable scientific software needed to understand them.";

/*
 * A package-backed card states the package's OWN tagline, looked up here.
 *
 * These notes used to be retyped: the gravax card carried its own sentence
 * about close encounters, which was a copy of a claim owned by gravax.mdx. A
 * copy cannot be kept in step — change the package and this page goes on
 * asserting the old version, silently and indefinitely. It is the same defect
 * that let a replaced figure leave /research quoting the previous run's number,
 * and that had /now announcing two semesters which had already ended.
 */
const packages = await getPackages();
function tagline(name: string): string {
  const found = packages.find((p) => p.data.name === name);
  if (!found) {
    throw new Error(
      `Homepage references package "${name}", which is not in the packages ` +
        `collection. Fix the name here or in src/content/packages/.`,
    );
  }
  return found.data.tagline;
}

/*
 * Ordered as the science runs — what clusters are born with, what rewrites
 * them, what observation can still recover — and then the teaching that comes
 * out of all three. They read as one argument rather than four topics.
 *
 * The titles stay here because they are this page's editorial framing, which is
 * a genuine per-page choice; the claims come from the collection.
 */
const nowBuilding = [
  {
    label: "The IMF, done honestly",
    note: "When ignoring unresolved binaries makes population inference confidently wrong.",
    href: "/research",
  },
  {
    label: "What rewrites a cluster",
    /* Package names are monospace everywhere (see the naming rule), and a
       plain string cannot carry that. `pkg` renders as <code> ahead of the
       note rather than smuggling markup into the text. */
    pkg: "gravax",
    note: tagline("gravax"),
    href: "/software#pkg-gravax",
  },
  {
    /* Not "What the data can recover" — that is almost word-for-word informax's
       own tagline, which renders directly beneath it. */
    label: "Differentiable cluster inference",
    pkg: "informax",
    note: tagline("informax"),
    href: "/software#pkg-informax",
  },
  {
    label: "Glass-box teaching tools",
    note: "Cosmic Playground and learner-centered documentation for real computational science.",
    href: "/teaching",
  },
];
---

<BaseLayout title={title} description={description} path="/">
  <ClusterHero
    eyebrow="Computational Astrophysics · SDSU"
    heading={"Stars shape the universe. I build the models — and the software — to understand how."}
  >
    {/* Jaxstro described as the whole chain rather than as connective tissue.
        The previous lede called it "the software that connects them", which
        reads as glue and no longer matched /software, where it is the model
        itself — two pages describing one thing differently is the drift this
        site keeps paying for. A slot, not the prop, because the title carries
        a link and a plain string cannot. */}
    <Fragment slot="lede">
      I'm an <a href="https://astronomy.sdsu.edu/people/anna-rosen/"
        >Assistant Professor of Astronomy</a
      > and a computational astrophysicist at San Diego State University. I build
      differentiable models of stars and star clusters — and <a
        class="hero__jaxstro"
        href="/software">Jaxstro</a
      >, the ecosystem that follows them from a cluster's birth through stellar
      evolution and collisional dynamics to survey observables, inference, and
      observing design.
    </Fragment>

    <div class="hero-cta">
      <a class="btn btn--primary" href="/research">Explore the research</a>
      <a class="btn" href="/software">See the software</a>
    </div>
  </ClusterHero>


  <section class="now wrap" aria-labelledby="now-heading">
    <p class="now__kicker">What I'm building now</p>
    <h2 id="now-heading">A single connected program</h2>
    <p class="now__lede prose">
      Research questions, scientific software, and teaching are not separate
      boxes — they are one effort to understand how stars shape the universe.
    </p>
    {/* The chain sits here because the sentence above it claims the work is one
        connected effort — this is that claim's evidence rather than a second
        assertion of it, and it doubles as a legend for the package cards
        directly below. Rendered from the same getPipeline() data as /software,
        so the two pages cannot show different chains. */}
    <JaxstroEcosystem compact />

    <ul class="now__grid" role="list">
      {
        nowBuilding.map((item) => (
          <li>
            <a class="now__card" href={item.href}>
              <h3 class="now__card-title">{item.label}</h3>
              <p class="now__card-note">
                {"pkg" in item && (
                  <>
                    <code>{item.pkg}</code>
                    {": "}
                  </>
                )}
                {item.note}
              </p>
              <span class="now__card-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* No "Work with me" block here on purpose: the nav carries it, and a
      homepage call to action reads as an advertised opening — funding secured,
      projects defined — which is a promise this page must not make. */}
</BaseLayout>

<style>
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }
  .btn {
    display: inline-block;
    padding: var(--space-2xs) var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .btn:hover {
    border-color: var(--spec-cyan);
    background: color-mix(in oklch, var(--spec-cyan) 12%, transparent);
  }
  .btn--primary {
    background: color-mix(in oklch, var(--spec-blue) 22%, transparent);
    border-color: color-mix(in oklch, var(--spec-blue) 55%, transparent);
  }
  .btn--primary:hover {
    background: color-mix(in oklch, var(--spec-blue) 32%, transparent);
    border-color: var(--spec-blue);
  }

  .now {
    padding-block: var(--space-3xl);
  }
  .now__kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--spec-rose);
    margin-block-end: var(--space-2xs);
  }
  .now__lede {
    color: var(--ink-soft);
    margin-block: var(--space-s) var(--space-xl);
  }
  .now__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-m);
  }
  .now__card {
    display: block;
    position: relative;
    block-size: 100%;
    padding: var(--space-m);
    background: var(--bg-deep);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }
  .now__card:hover {
    border-color: color-mix(in srgb, var(--spec-teal) 45%, var(--border));
    background: color-mix(in srgb, var(--spec-teal) 7%, var(--bg-deep));
  }
  .now__card-title {
    font-size: var(--step-1);
    color: var(--ink);
    margin-block-end: var(--space-2xs);
  }
  .now__card-note {
    font-size: var(--step-0);
    color: var(--ink-dim);
  }
  .now__card-arrow {
    display: inline-block;
    margin-block-start: var(--space-s);
    color: var(--spec-teal-bright);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .now__card:hover .now__card-arrow {
    transform: translateX(4px);
  }
</style>

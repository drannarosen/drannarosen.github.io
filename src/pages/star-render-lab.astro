---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { COLOR_SCHEMES } from "@novascope/core/colorimetry/schemes";
import { linearToSrgbRGB } from "@novascope/core/colorimetry";
import { spectralType } from "@novascope/core/stellar";
import { DEPTH_MAG_RANGE, DEFAULT_LUPTON_DEPTH_MAG } from "@novascope/core/imaging/lupton";
import { D0_PC, DISTANCE_PC_RANGE } from "@novascope/core/photometry";
import { PASSBANDS, bolometricCorrection } from "@novascope/core/photometry/passbands";
import { SURVEYS } from "@novascope/core/photometry/surveys";
import { INSTRUMENTS } from "@novascope/core/photometry/instruments";
import { TRANSFERS, type TransferFamily } from "@novascope/core/imaging/transfers";
import { LAB_PRESETS } from "@novascope/viz/starfield/labPresets";
import { clusterStarTable } from "@novascope/viz/starfield/source";
import { prepareStarField } from "@novascope/viz/starfield/prepare";

/*
 * Colour-scheme comparison, rendered at BUILD time. Every swatch is computed by
 * the same functions the GPU path will mirror, so this strip is a real preview
 * of the renderer's colour, not a mock-up drawn to look like one.
 */
const SAMPLE_TEFF = [2500, 3200, 4000, 4500, 5300, 5800, 6800, 8800, 12000, 20000, 30000, 40000];
const css = (c: readonly [number, number, number]): string => {
  const [r, g, b] = linearToSrgbRGB(c).map((v) => Math.round(v * 255));
  return `rgb(${r} ${g} ${b})`;
};
/*
 * Bands, grouped BY INSTRUMENT.
 *
 * These labels used to split on what kind of filter MODEL each band was — "Gaussian
 * model" against "measured curve" — because that was the honest distinction while
 * Johnson-Cousins and 2MASS were bells. Every band is now a measured curve, so the
 * distinction is gone and saying it here would be false. Grouping by instrument is
 * what is left to say, and it is the useful axis anyway: it puts the ground-based
 * surveys next to each other and the two space telescopes at the end, which is roughly
 * the order of what they can reach.
 */
const BAND_GROUPS: Array<{ label: string; ids: string[] }> = [
  { label: "Bolometric (total)", ids: ["bolometric"] },
  { label: "Johnson–Cousins / 2MASS", ids: ["U", "B", "V", "R", "I", "J", "H", "K"] },
  { label: "SDSS", ids: ["SDSS_u", "SDSS_g", "SDSS_r", "SDSS_i", "SDSS_z"] },
  { label: "Rubin / LSST", ids: ["LSST_u", "LSST_g", "LSST_r", "LSST_i", "LSST_z", "LSST_y"] },
  { label: "Gaia DR3", ids: ["Gaia_G", "Gaia_BP", "Gaia_RP"] },
  { label: "HST — no atmosphere, reaches the near-UV", ids: ["HST_F275W", "HST_F606W", "HST_F814W", "HST_F160W"] },
  { label: "JWST — reaches the mid-IR", ids: ["JWST_F090W", "JWST_F200W", "JWST_F444W", "JWST_F770W"] },
];
const bandLabel = (id: string): string =>
  id === "bolometric" ? "bolometric (total)" : (PASSBANDS[id]?.label ?? id);

/*
 * WHAT THE FILTER DOES TO A CLUSTER, measured at BUILD time on the same population
 * the canvas draws.
 *
 * The point is the trend, and it is a large one: the same 10,000 stars span ~30
 * magnitudes in the near-UV and ~14 in the mid-IR, because at 271 nm we are on the
 * Wien side where flux goes as exp(-hc/lkT) and at 7.7 um we are on the Rayleigh-Jeans
 * side where it goes as T. Choosing a filter is choosing how much dynamic range the
 * cluster has, and the visible sits in the middle of a factor-of-two swing.
 *
 * DERIVED HERE, NOT TYPED. Every one of these numbers moves if a curve, the IMF, the
 * sampling or the AB zero point changes, and a hand-typed table would go stale in
 * silence — which is precisely what happened to this page's "max/median 3.1 -> 1.9"
 * line, measured once and left behind. Sampling 10,000 stars per band at build time
 * costs milliseconds and buys a claim that cannot drift.
 */
const SPREAD_BANDS = ["HST_F275W", "U", "B", "V", "R", "K", "JWST_F200W", "JWST_F770W"];
const clusterForSpread = clusterStarTable({ sampling: { mode: "count", target: 10_000 } });
const BAND_SPREAD = SPREAD_BANDS.map((id) => {
  const { stats } = prepareStarField(clusterForSpread, { band: id, pixelRatio: 1 });
  return {
    id,
    label: bandLabel(id),
    lambdaEffNm: PASSBANDS[id]!.lambdaEffNm,
    range: stats.absMag.faintest - stats.absMag.brightest,
    visibleFraction: stats.visible / (clusterForSpread.length / 6),
    bcSun: bolometricCorrection(5772, PASSBANDS[id]!),
  };
});

/*
 * The depth slider is in MAGNITUDES below the display white point, which is the
 * physical statement the old "faint detail" slider was making opaquely: it read
 * dex of asinh softening, so the control could be tuned but never reported.
 *
 * IT DRIVES A DIFFERENT PARAMETER IN EACH MODE, which is why there are two defaults and why the
 * range must cover both. In PHOTOMETRIC mode it sets Lupton's Q — a per-pixel curve, where 8 mag
 * gives 34% black sky and 19.8 mag gives a saturated white rectangle. In POPULATION mode it sets the
 * per-STAR asinh softening, so it decides whether the faint majority renders at all, and 8 mag puts
 * the median star's signal at 1e-4 against a 0.02 visibility threshold — only the hot blue stars
 * survive, so the whole field reads as one colour.
 *
 * That is the bug this fixes. Narrowing the control to 6.25-16 for the Lupton path put the depth
 * population mode needs at its own maximum, and the default of 8 was the wrong end entirely.
 *
 * Bounds and defaults are IMPORTED from `core/imaging/lupton`, not restated here. A restated range
 * is exactly how this broke, and `check:star-optics` asserts the range brackets both defaults, so
 * narrowing one for the other's benefit fails the build.
 */
const DEPTH_STEP = 0.25;
const DEPTH_MIN = DEPTH_MAG_RANGE.min;
const DEPTH_MAX = DEPTH_MAG_RANGE.max;
const snap = (v: number): number => Math.round(v / DEPTH_STEP) * DEPTH_STEP;
/*
 * BOTH defaults are emitted, and the control switches between them, because `depthMag` drives a
 * different parameter in each mode — see `DEFAULT_POPULATION_DEPTH_MAG`. The page starts in
 * population mode, so that is the starting position.
 */
/*
 * BOTH MODES NOW DEFAULT TO THE MAXIMUM DEPTH, so every star clears the display floor. Anna's
 * call (2026-07-25), against the two measured per-mode defaults that preceded it.
 *
 * WHAT THE MEASUREMENTS SAY IT COSTS, recorded rather than argued. On the shipped population under
 * `vivid`, hue spread against depth runs:
 *
 *     depth   median signal   blue fraction   hue spread
 *       8         0.0001          0.738          0.179
 *      12         0.0035          0.449          0.349   <- peak colour separation
 *      16         0.1009          0.210          0.326   <- the previous default
 *      19.78      0.2845          0.147          0.281
 *
 * Separation peaks near 12 and falls away past 20 as everything lifts far enough that the hues
 * wash back together. So "every star visible" and "maximum colour separation" are different
 * optima and this now targets the first. `DEFAULT_POPULATION_DEPTH_MAG` and
 * `DEFAULT_LUPTON_DEPTH_MAG` still hold the measured figures in Layer 0 — they are what the
 * renderer falls back to when no depth is supplied at all — so nothing was overwritten to make
 * this change, and reverting it is a one-line edit here.
 *
 * The two entries are now equal, which makes `syncDepthForMode` inert. It is left in place
 * deliberately: it is the mechanism that keeps the modes honest if the defaults ever diverge
 * again, and deleting working machinery as a side effect of a defaults change is how the depth
 * bug got in the first time.
 */
const DEPTH_DEFAULTS = {
  photometric: snap(DEPTH_MAG_RANGE.max),
  population: snap(DEPTH_MAG_RANGE.max),
};
const depthStart = DEPTH_DEFAULTS.population;
/* The per-PIXEL curve's span. Its measured default is untouched — only `lupton` reads it. */
const LUPTON_DEPTH_START = snap(DEFAULT_LUPTON_DEPTH_MAG);
/*
 * The distance slider works in LOG10(pc), because the useful range spans 50 pc to 20 kpc — a
 * factor of 400 — and a linear slider would put every Galactic cluster in its first two percent.
 * The URL still carries parsecs; only the widget is logarithmic.
 */
const DIST_LOG_MIN = Math.log10(DISTANCE_PC_RANGE.min);
const DIST_LOG_MAX = Math.log10(DISTANCE_PC_RANGE.max);
/*
 * The transfer control's option groups, PARTITIONED from the registry rather than listed.
 *
 * The group labels state the one difference that is real and that a reader cannot see: what the
 * output of each family already is. An astronomical curve's output IS the pixel — astropy writes
 * `make_lupton_rgb` straight to a PNG — so it gets no sRGB encode. A photographic operator returns
 * display-LINEAR values and is still owed one. Both mistakes render a plausible image, so the
 * distinction has to be said out loud somewhere, and the control is where the choice is made.
 */
const FAMILY_LABEL: Record<TransferFamily, string> = {
  astronomical: "Astronomical — display-referred, no encode after",
  photographic: "Photographic — scene-referred, sRGB encode after",
};
const TRANSFER_GROUPS = (["astronomical", "photographic"] as const).map((family) => ({
  label: FAMILY_LABEL[family],
  items: TRANSFERS.filter((t) => t.family === family),
}));

const schemeRows = COLOR_SCHEMES.map((s) => ({
  id: s.id,
  label: s.label,
  kind: s.kind,
  note: s.note,
  swatches: SAMPLE_TEFF.map((T) => ({ teff: T, css: css(s.color(T)), type: spectralType(T) })),
}));
---

<BaseLayout
  title="Star-render lab — Anna Rosen"
  description="Internal prototype: a photographic observed-mode star-cluster renderer on an analytically sampled cluster."
  path="/star-render-lab"
  noindex
>
  <PageHeader
    eyebrow="Prototype · not linked"
    title="Star-render lab"
    lede="A testbed for the photographic star renderer: apparent flux through a chosen filter, a robust asinh exposure calibrated once against the population, a bounded unresolved core with a Moffat PSF, and a broad faint aureole on the brighter stars. The cluster is sampled analytically — masses from the IMF, positions from a Plummer profile, and each star's temperature and radius derived from its ZAMS state — by the same novascope core the homepage hero uses. The physics lives in pure, dependency-free modules; this page is the Three.js harness around them. Drag to orbit, scroll to zoom. Add ?forceWebGL to exercise the WebGL 2 fallback."
  />

  <div class="srl wrap-wide">
    <!--
      GROUPED BY THE THEORY-TO-OBSERVATION LADDER, which is the structure the physics already has
      and the UI previously hid. Each group is a contiguous run of rungs from the vision roadmap:
      light leaves the stars, an instrument records it, a display shows it. The old grouping
      ("what is shown" / "how it is displayed" / "which stars are counted") split on a different
      axis and left the reader to infer the theory-observation boundary from which dropdown they
      happened to touch.

      The boundary is DISTANCE, rung 4, and it sits at the end of group one on purpose: before it
      every star is at a common distance and you are looking at a population; after it the
      inverse-square law applies within the cluster and you are looking at an image.
    -->
    <script id="srl-depth-defaults" type="application/json" is:inline set:html={JSON.stringify(DEPTH_DEFAULTS)} />
    <script id="srl-instruments" type="application/json" is:inline set:html={JSON.stringify(
      Object.fromEntries(INSTRUMENTS.map((i) => [i.id, {
        label: i.label, composite: i.composite, brightnessBand: i.brightnessBand,
      }])),
    )} />

    <div class="srl__group">
      <h2 class="srl__grouph"><b>1</b> The cluster <span>rungs 1–4 · what light leaves the stars</span></h2>
      <div class="srl__controls">
      <label class="srl__ctl">Colour scheme
        <select data-scheme>
          {COLOR_SCHEMES.map((s) => <option value={s.id}>{s.label} — {s.kind}</option>)}
        </select>
      </label>
      <!--
        DISTANCE — rung 4, where theory becomes observation.
        It deliberately does not change the exposure: the white point is a percentile of the
        resulting fluxes, so moving the whole cluster rescales every flux identically and cancels.
        What moves is the MEANING — apparent magnitude slides while absolute magnitude does not —
        which is why the status line reports both, and why this control is worth having even
        though the picture barely changes.
      -->
      <label class="srl__ctl">Distance <span data-dist-val></span>
        <input type="range" min={DIST_LOG_MIN} max={DIST_LOG_MAX} step="any" value={Math.log10(D0_PC)} data-dist />
      </label>
      <!--
        A MODELLING SELECTION, not an observation — which is why it lives with the cluster rather
        than with the instrument, and why the page says so below whenever it is active.
      -->
      <label class="srl__ctl">Lowest mass shown <span data-minmass-val>all</span>
        <input type="range" min="0" max="2" step="0.05" value="0" data-min-mass />
      </label>
      </div>
    </div>

    <div class="srl__group">
      <h2 class="srl__grouph"><b>2</b> The instrument <span>rungs 6–8 · what records it</span></h2>
      <div class="srl__controls">
      <!--
        INSTRUMENT FIRST, because it drives two other controls.
        Choosing one sets both the colour composite and the brightness band together, which is the
        whole reason the registry exists: picking a band and a composite independently made it
        possible to show Rubin r brightness through a 2MASS composite — an image of nothing.
        "Population" is a genuinely different claim, not just a different colour source. Its hue
        comes from the scheme at UNIT LUMINANCE and its brightness from a per-star asinh signal, so a
        faint red dwarf is as saturated as a bright blue giant — which discards how much light each
        star actually emits. That discarding is exactly why the population is visible: measured hue
        spread 0.082 (true) or 0.150 (stretched) against 0.021 photometric, because 100 of these
        10,000 stars carry 92% of the light and they are all hot. It must not be described as what a
        telescope sees.
      -->
      <label class="srl__ctl">Instrument
        <select data-instrument>
          <option value="population" selected>None — the population itself</option>
          {INSTRUMENTS.map((i) => <option value={i.id}>{i.label}</option>)}
        </select>
      </label>
      <label class="srl__ctl">Brightness band <span data-band-note></span>
        <select data-band>
          {BAND_GROUPS.map((g) => (
            <optgroup label={g.label}>
              {g.ids.map((b) => (
                <option value={b} selected={b === "bolometric"}>{bandLabel(b)}</option>
              ))}
            </optgroup>
          ))}
        </select>
      </label>
      <label class="srl__ctl">Exposure <span data-exposure-val></span>
        <input type="range" min="0.25" max="4" step="0.05" value="1" data-exposure />
      </label>
      <!--
        BLOOM is rung 8 — the DETECTOR's response to a saturated source, not the optics. It keys on
        display white, the stars that overflow in a young cluster are the hot blue ones, and their
        glow spreads across the frame, so the background takes their hue. Turn it to 0 to see the
        difference: the CPU reference, which has no bloom pass, measures a blue fraction of 0.15
        where the live pipeline measured 0.75. The sky probe measures the same thing from the other
        side — 25% of pixels at zero with bloom on, 82% with it off.
      -->
      <label class="srl__ctl">Bloom <span data-bloom-val>0.35</span>
        <input type="range" min="0" max="1" step="0.01" value="0.35" data-bloom />
      </label>
      <!--
        THE TWO OPTICAL TERMS, rung 7, each as a multiple of the instrument's own amplitude. 1 is
        the instrument as modelled; 0 removes the term entirely.

        WHY THEY ARE CONTROLS AND NOT CONSTANTS. A quad is sized by SOLVING for where its profile
        drops below one display level, so a term's falloff exponent governs its reach far more
        than its amplitude does — which makes these terms much more consequential than their
        amplitudes suggest, and impossible to judge without being able to switch them off.
        Measured before the spike exponent was corrected: SEVEN stars of 1200 held 58.2% of all
        drawn quad area, at 121 px against 22 px for the other 1193. All seven were blue, because
        the seven brightest stars are the hottest.

        These change quad SIZE, so unlike bloom and the sky they are physics and pay for a full
        rebuild rather than being pipeline uniforms.
      -->
      <label class="srl__ctl">Scattered-light halo <span data-aureole-val>1.00x</span>
        <input type="range" min="0" max="2" step="0.05" value="1" data-aureole />
      </label>
      <label class="srl__ctl">Diffraction spikes <span data-spikes-val>1.00x</span>
        <input type="range" min="0" max="2" step="0.05" value="1" data-spikes />
      </label>
      </div>
    </div>

    <div class="srl__group">
      <h2 class="srl__grouph"><b>3</b> The display <span>rung 9 · how the pixels are made</span></h2>
      <div class="srl__controls">
      <!--
        THE DISPLAY TRANSFER — one control, twelve conventions, and no longer two mechanisms.
        Three's tone mappers used to be applied by `renderer.toneMapping` + `renderOutput()` while
        the astropy curves were TSL output nodes, so this control could only ever offer half the
        answer and AgX survived a refactor as a comment. They are all TSL functions; `transferNode`
        builds whichever is named and the page never learns the difference.

        GROUPED BY FAMILY, because the families genuinely disagree about whose job the sRGB encode
        is — astronomical curves are display-referred and get none, photographic operators are
        scene-referred and are owed one — and that is the honest answer to "why does astronomy not
        just use AgX". The groups are derived from the registry, not listed here.
      -->
      <label class="srl__ctl">Display transfer
        <select data-scaling>
          <option value="">Follow mode (asinh)</option>
          {TRANSFER_GROUPS.map((g) => (
            <optgroup label={g.label}>
              {g.items.map((t) => (
                <option value={t.id} title={t.note} selected={t.id === "asinh"}>{t.label}</option>
              ))}
            </optgroup>
          ))}
        </select>
      </label>
      <!--
        TWO DEPTHS, because they were always two parameters wearing one name.

        "Star reach" is the PER-STAR asinh curve: how far down the population it lifts, and so
        whether the faint majority renders at all. "Transfer span" is the PER-PIXEL curve's dynamic
        range — Lupton's Q — and only `lupton` varies with it, which is why it is disabled under
        any other transfer rather than silently doing nothing.

        Sharing one control made the default mode-dependent, and that produced two separate bugs:
        the median star at a display signal of 1e-4 against a 0.02 threshold (778a91b), and a
        shared link that reopened at a different depth than it recorded.
      -->
      <label class="srl__ctl">Star reach <span data-depth-val>{depthStart.toFixed(2)}</span> mag below white
        <input type="range" min={DEPTH_MIN} max={DEPTH_MAX} step={DEPTH_STEP} value={depthStart} data-depth />
      </label>
      <label class="srl__ctl">Transfer span <span data-curve-val></span>
        <input type="range" min={DEPTH_MIN} max={DEPTH_MAX} step={DEPTH_STEP} value={LUPTON_DEPTH_START} data-curve />
      </label>
      <!--
        SKY is the lever that produces a black background, and depth cannot substitute for it: depth
        lifts stars and sky together, because the background here is the summed PSF wings of every
        star rather than noise. Measured at star reach 24 in Rubin i/r/g, that background sits at
        2.84% of white.

        IT IS SUBTRACTED PER BAND, because the sky has a colour — the wings of hot stars, so blue
        (channel weights 0.72 / 0.90 / 1.38 about a unit mean). Removing one scalar from three
        unequal channels changes their ratios, which made this silently a colour control: at a
        large subtraction 100% of blue stars survived against 3.3% of red ones. Now the amount
        removed follows the colour of what is being removed.

        IT STILL COSTS THE FAINT MAJORITY, and the readout says so honestly. 0.5% of white takes
        10,000 stars above the floor down to 1,655.

        THE SLIDER IS CUBIC, not linear, and its top is 20% of white rather than 5%. Both were
        wrong for the quantity: the measured background's 25th percentile is 0.20% of white and its
        MEAN is 6.43%, so the old maximum sat BELOW the frame's own mean, and on a linear scale
        every useful setting was inside the first four steps. `skyFractionFromSlider` maps position
        to fraction and says why a cube rather than a logarithm — the short answer is that this
        control's default is exactly zero, which a logarithm cannot express.

        NO "measure it" CHECKBOX YET, deliberately. The probe (`viz/starfield/skyProbe`) works and
        is reachable as `?skyauto`. Its degenerate-percentile bug is fixed — the estimator now
        returns exactly the 25th percentile every run — but the FRAME IT READS still varies: at
        identical settings with motion and bloom off, eight probes gave three bit-identical
        results rather than eight noisy ones, which points at a tile readback that does not always
        reflect its own render. Until that is fixed the probe reports rather than decides.
      -->
      <label class="srl__ctl">Sky subtracted <span data-sky-val>none</span>
        <input type="range" min="0" max="1" step="any" value="0" data-sky />
      </label>
      <!--
        A READOUT, NOT A CONTROL. There is no "measure it" checkbox — `?skyauto` is the only way
        in, and it stays that way until the probe's unexplained zero-fraction is understood. But
        the flag already worked and reported NOTHING: this element did not exist, so the page ran
        the probe, subtracted its answer, and displayed "none". Shipping the numbers without the
        checkbox is the honest half — the estimate is visible and checkable, and nobody can reach
        it by mis-clicking.
      -->
      <p class="srl__hint" data-sky-auto-note></p>
      </div>
    </div>

    <p class="srl__selection" data-selection hidden>
      <strong>Population filtered.</strong> Stars below the mass cut are not drawn,
      so this is not what the cluster looks like — it is what its more massive stars
      contribute. The exposure is unchanged: the white point is still calibrated on
      the full population, so the remaining stars keep the brightness they had.
    </p>

    <!--
      WHAT YOU ARE LOOKING AT, generated from the live state rather than written.
      A projected frame has to explain itself: nobody at the back of a lecture theatre can read a
      control panel, and a screenshot in a talk carries no controls at all. Every clause is derived,
      so it cannot describe a configuration the renderer is not in — which is the failure mode of
      every hand-written caption.
    -->
    <!--
      PRESETS ARE URLS, which is the entire payoff of putting every control in the query string:
      no preset format, no serialisation, and no way for one to express a state the controls
      cannot. Each states something MEASURED — a preset that merely looked nice would be
      decoration on an instrument.

      Left/Right step through them, so a lecture is a sequence rather than a hunt through eleven
      controls. The buttons are real buttons: reachable by keyboard, announced as pressed.
    -->
    <div class="srl__presets" role="group" aria-label="Preset states">
      {LAB_PRESETS.map((p, i) => (
        <button type="button" class="srl__preset" data-preset={p.id} aria-pressed="false">
          <span class="srl__presetKey">{i + 1}</span>{p.label}
        </button>
      ))}
      <span class="srl__hint srl__presetHint">← → to step</span>
    </div>
    <p class="srl__presetNote" data-preset-note></p>

    <!--
      THE CONTACT SHEET. Every transfer on the CURRENT state, side by side.
      Flipping a dropdown and remembering is not a comparison: a transfer changes contrast and
      colour together, and human memory for both is poor over the second a re-render takes.
      Rendered on demand rather than always, because it costs one render and one readback per
      transfer — cheap once, wasteful on every slider tick.
    -->
    <div class="srl__sheetBar">
      <button type="button" class="srl__preset" data-sheet>Compare all transfers</button>
      <span class="srl__hint" data-sheet-note></span>
    </div>
    <div class="srl__sheet" data-sheet-out hidden></div>

    <p class="srl__claim" data-claim></p>

    <div class="srl__stage">
      <canvas class="srl__canvas" data-stage aria-label="A star cluster rendered in observed mode."></canvas>
      {/*
        A REAL button, not a div: it must be reachable by keyboard and announced as a
        toggle. `aria-pressed` carries the state, and the label is set from the
        renderer's own `drifting` rather than assumed, because the starting state
        depends on prefers-reduced-motion and a control that lies about it is worse
        than no control.
      */}
      <button class="srl__motion" type="button" data-motion aria-pressed="false">
        <span data-motion-label>Pause motion</span>
      </button>
      <p class="srl__status" data-status aria-live="polite">Loading…</p>
    </div>

    <section class="srl__schemes" aria-labelledby="schemes-h">
      <h2 id="schemes-h" class="srl__h">Colour schemes</h2>
      <p class="srl__intro">
        One physics, several presentations. True colour is faithful and
        deliberately subtle — stellar blackbody colours trace only a short arc of
        colour space, so a real cluster reads mostly white with restrained tints.
        The stretched scheme keeps each star's physical <em>hue</em> and exaggerates
        only its saturation. Two earlier schemes (a 5× chroma stretch, and one
        saturated colour per MK class) were <strong>removed</strong>: rendered on the
        real cluster they asserted colour differences far larger than the physics
        supports, which costs more credibility than the legibility it buys.
      </p>

      {schemeRows.map((row) => (
        <div class="srl__scheme">
          <div class="srl__schemeHead">
            <span class="srl__schemeName">{row.label}</span>
            <span class={`srl__kind srl__kind--${row.kind}`}>{row.kind}</span>
          </div>
          <div class="srl__ramp">
            {row.swatches.map((s) => (
              <span
                class="srl__sw"
                style={`background:${s.css}`}
                title={`${s.teff.toLocaleString()} K · ${s.type}`}
              />
            ))}
          </div>
          <p class="srl__note">{row.note}</p>
        </div>
      ))}

      <div class="srl__axis">
        <span>2,500 K · M</span>
        <span>cooler ← Teff → hotter</span>
        <span>40,000 K · O</span>
      </div>
    </section>

    {/*
      DESIGN RECORD. This page is noindex and unlinked — a development surface — so
      it carries its own reasoning instead of leaving it in commit messages. The
      point is that every visible feature can be traced to either a cited relation
      or an explicitly-labelled choice, and that the two are never mixed up.
    */}
    <section class="srl__doc" aria-labelledby="doc-h">
      <h2 id="doc-h" class="srl__h">Design record</h2>
      <p class="srl__intro">
        What is <strong>derived</strong> and what is <strong>chosen</strong>, kept
        separate on purpose. Anything in the second column is a judgement that could
        reasonably be made differently; anything in the first is not up for taste.
      </p>

      <h3 class="srl__h3">Derived from physics</h3>
      <dl class="srl__dl">
        <dt>Population</dt>
        <dd>
          Masses from a Maschberger IMF, positions from a continuous Plummer profile,
          Teff and radius per star from its ZAMS state. Same novascope core as the
          homepage hero. Deterministic in one seed. The half-mass radius used for
          framing is <em>measured from the stars actually drawn</em>, not declared.
        </dd>
        <dt>Brightness</dt>
        <dd>
          Apparent flux through the chosen filter, with each star at its own distance
          so the inverse-square law applies <em>within</em> the cluster. Depth is the
          star's own z in the cluster frame — never the live camera's axis, because a
          cluster 400 pc away cannot be orbited, and keying off the camera would make
          brightness pump as the view rotates.
        </dd>
        <dt>Colour</dt>
        <dd>
          Blackbody spectrum integrated against the CIE 1931 observer, then rescaled
          to <em>unit luminance</em> so the display signal alone sets how bright a
          star reads. Left peak-normalised, luminance ran 0.49 at 2500 K against 0.90
          at 5772 K — a Sun-like star rendered 1.86× more luminous than an O star at
          the same signal, and measured peak brightness came out non-monotonic in
          luminosity.
        </dd>
        <dt>Point-spread function</dt>
        <dd>
          One Moffat profile, <strong>the same width for every star</strong> — a PSF
          belongs to the atmosphere and optics, not the source. Brightness changes
          peak intensity only; a bright star looks larger because more of its wing
          clears the display threshold. Apparent size therefore goes as
          signal<sup>1/2β</sup>.
        </dd>
        <dt>Halo and spikes</dt>
        <dd>
          Both driven by <em>linear</em> flux, not the compressed display signal,
          because scattered light and diffraction are fixed fractions of what entered
          the aperture and know nothing about display. Spikes are Tier 3 only (~0.5%
          of stars) and fixed to the instrument, so they do not rotate with the sky.
        </dd>
        <dt>Filters</dt>
        <dd>
          All 30 bands are <strong>real measured curves</strong> — Johnson–Cousins,
          2MASS, SDSS, Rubin, Gaia, HST and JWST — spanning 271 nm to 7663 nm, a factor
          of 28. There is no Gaussian fallback: UBVRI and JHK were modelled as bells
          until measured curves for them turned up in the same repository as Rubin's,
          and keeping both a curve and a nominal width would be two descriptions of one
          filter. Effective wavelengths are derived from the curves, not copied, and
          reproduce published means within 2% (Rubin r: 622.1 nm vs 622.0).
        </dd>
        <dt>Absolute magnitudes and bolometric corrections</dt>
        <dd>
          On the AB zero point (3631 Jy). The Sun comes out at
          M<sub>V</sub> = 4.87 against a published ≈4.83. BC<sub>V</sub> = M<sub>bol</sub>
          − M<sub>V</sub> then falls out: −3.5 for an O star, −0.12 for the Sun, −1.5 for
          an M4 dwarf — negative at both ends because V misses the ultraviolet of hot
          stars and the infrared of cool ones. It is independent of radius and distance
          by construction, and that is gated, not asserted.
        </dd>
        <dt>Choosing a filter is choosing a dynamic range</dt>
        <dd>
          Measured at build time on the same 10,000 stars the canvas draws, so these
          cannot go stale. The spread collapses by a factor of two from the near-UV to
          the mid-IR — Wien's exponential at one end, Rayleigh–Jeans' linear
          <em>T</em> at the other — and the fraction of the cluster that clears the
          threshold collapses with it.
          <table class="srl__table">
            <thead>
              <tr><th>Band</th><th>λ<sub>eff</sub></th><th>M range</th><th>above threshold</th><th>BC<sub>☉</sub></th></tr>
            </thead>
            <tbody>
              {BAND_SPREAD.map((b) => (
                <tr>
                  <td>{b.label}</td>
                  <td>{b.lambdaEffNm < 1000 ? `${b.lambdaEffNm.toFixed(0)} nm` : `${(b.lambdaEffNm / 1000).toFixed(2)} µm`}</td>
                  <td>{b.range.toFixed(1)} mag</td>
                  <td>{(100 * b.visibleFraction).toFixed(0)}%</td>
                  <td>{b.bcSun.toFixed(2)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </dd>
        <dt>What the blackbody assumption costs</dt>
        <dd>
          Every flux here integrates a <em>Planck function</em> through a real curve, so
          the filter is exact and the spectrum is not. The size of that is measurable
          rather than hand-waved: the Sun's B−V comes out 0.46 against a real 0.65, and
          BC<sub>V</sub> is good to 0.05 mag near solar temperatures but 0.5 mag off for
          an O5V. The missing physics is line blanketing, the Balmer jump and molecular
          bands — and the error grows toward both temperature extremes, exactly where
          those matter most.
        </dd>
      </dl>

      <h3 class="srl__h3">Chosen, and revisable</h3>
      <dl class="srl__dl">
        <dt>Depth (default 19.8 mag below white)</dt>
        <dd>
          An <em>exposure</em>, not a fact. At the default, sub-solar stars — 88.5% of
          the cluster, emitting 0.05% of its V-band light — own ~74% of the summed
          display signal. That is a ~1500× over-representation, and it is a choice:
          the alternative hides most of the cluster. A 0.1 M<sub>☉</sub> star here is
          m<sub>bol</sub> ≈ 20.3 at 400 pc.
        </dd>
        <dt>White percentile (0.995)</dt>
        <dd>
          Kept high <em>against intuition</em>. Lowering it brightens the image but
          <strong>flattens</strong> it: max/median signal moves 4.15 → 2.33 as the
          percentile drops 0.995 → 0.90, because asinh compresses harder at larger
          argument.
        </dd>
        <dt>PSF width 2.2 px, β 3.2, aureole and spike amplitudes</dt>
        <dd>
          Tuned by looking at rendered output. Each has exactly one home in the code
          and the shader imports it, so they cannot drift apart — but they are taste,
          not measurement.
        </dd>
        <dt>Bloom threshold 1.0</dt>
        <dd>
          Display white, so only genuine HDR overflow glares (~50 of 10,000 stars).
          Anything lower would bloom the ordinary field and double-count the halo and
          spikes, which already model why bright stars spread.
        </dd>
        <dt>Mass cut</dt>
        <dd>
          A <em>modelling selection</em>, not an observation. The white point stays
          calibrated on the full population so the views stay comparable, and the page
          says so whenever the cut is active.
        </dd>
      </dl>

      <h3 class="srl__h3">Known limits</h3>
      <ul class="srl__limits">
        <li>
          <strong>No absolute zero point.</strong> Band fluxes are in arbitrary
          self-consistent units, so colour indices work and apparent AB magnitudes do
          not. The depth control reads in magnitudes below <em>this image's</em> white
          point, which is exact but is not a survey limit.
        </li>
        <li>
          <strong>Blackbody spectra.</strong> No line blanketing, no Balmer jump, no
          molecular bands — worst for the cool stars that dominate by number. A real
          filter curve removes one approximation, not this one.
        </li>
        <li><strong>No gas, no extinction, no binaries, no stellar evolution</strong> (t = 0 ZAMS throughout).</li>
        <li>
          <strong>Survey depths below are reference data, not calibration.</strong>
          They are published apparent AB magnitudes; the render is not tied to them.
        </li>
      </ul>

      <h3 class="srl__h3">Survey reference depths</h3>
      {SURVEYS.map((s) => (
        <div class="srl__survey">
          <p class="srl__surveyHead"><strong>{s.label}</strong> — <span class="srl__cite">{s.source}</span></p>
          <table class="srl__table">
            <thead>
              <tr><th>Band</th><th>Single visit</th><th>Coadd</th></tr>
            </thead>
            <tbody>
              {s.depths.map((d) => (
                <tr>
                  <td>{PASSBANDS[d.band]?.label ?? d.band}</td>
                  <td>{d.singleVisit.toFixed(1)}</td>
                  <td>{d.coadd.toFixed(1)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="srl__note">
            {s.keyNumbers.map(([k, v]) => `${k}: ${v}`).join(" · ")}
          </p>
        </div>
      ))}
      <p class="srl__note">
        Rubin's depths here follow the observatory's own Key Numbers page. fluxax
        carries different values (citing Ivezić et al. 2019 and the LSST Science
        Book) — up to 0.6 mag apart, with the coadds differing systematically. Both
        are recorded in <code>core/photometry/surveys.ts</code>; neither is treated as
        wrong. The filter curves themselves are fetched from their primary sources —
        <code>lsst/throughputs</code> and the SVO Filter Profile Service — so nothing
        here depends on my own packages.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import { initStarLab } from "@novascope/viz/starfield/scene";
  import { decode, encode } from "@novascope/core/params/urlState";
  import { D0_PC } from "@novascope/core/photometry";
  import { DEFAULT_LUPTON_DEPTH_MAG } from "@novascope/core/imaging/lupton";
  import { LAB_PRESETS } from "@novascope/viz/starfield/labPresets";
  import { TRANSFERS, type TransferId } from "@novascope/core/imaging/transfers";

  /* Order and family come from the registry, so the sheet cannot list a transfer that no longer
   * exists nor miss one that was added. */
  const TRANSFER_ORDER: TransferId[] = TRANSFERS.map((t) => t.id);
  const TRANSFER_FAMILY: Record<string, string> = Object.fromEntries(
    TRANSFERS.map((t) => [t.id, t.family === "photographic" ? "photographic" : "astronomical"]),
  );
  import {
    LAB_SCHEMA,
    PASSTHROUGH_KEYS,
    TRANSFER_AUTO,
    skyFractionFromSlider,
    sliderFromSkyFraction,
    type LabState,
    type MotionChoice,
  } from "@novascope/viz/starfield/labParams";

  /**
   * How a sky level is spelled, in ONE place.
   *
   * It is shown in three spots (the slider's own readout, the measured readout, the claim
   * sentence) and the three had drifted to two different precisions — `toFixed(2)` for the chosen
   * value and `toFixed(3)` for the measured one, so the same number read differently depending on
   * which produced it. At the low end that mattered: the useful settings start at 0.2% of white
   * and the probe returns values near 0.001%, both of which print as "0.00%" at two decimals.
   *
   * Significant figures rather than fixed decimals, so 0.002% and 6.4% are each legible.
   */
  const skyPercent = (fraction: number): string => {
    const s = (100 * fraction).toPrecision(fraction >= 0.001 ? 3 : 2);
    /* Trailing zeros only ever come off a fractional part. Stripping them from "100" would leave
     * "1", which the obvious one-line regex does — out of reach here, but not worth relying on. */
    return `${s.includes(".") ? s.replace(/0+$/, "").replace(/\.$/, "") : s}%`;
  };

  /** The sky slider's current position, as the fraction of white it means. */
  const readSky = (): number =>
    skyFractionFromSlider(Number(document.querySelector<HTMLInputElement>("[data-sky]")?.value ?? 0));

  /**
   * Whether the sky is MEASURED rather than chosen — from the checkbox if one exists, else the URL.
   *
   * THE SAME BUG TWICE, so it now has one home. The "measure it" checkbox was removed while the
   * probe was untrustworthy, and every site that asked the DOM for it kept asking. `readState`
   * defaulted to `false` and re-encoded `?skyauto` away, which killed the escape hatch; the
   * readout defaulted to `false` too, so with `?skyauto` genuinely on the page ran the probe,
   * subtracted its answer, and displayed "none" — the reading being least true of the picture on
   * screen. A `?? false` against a removed element is not a default, it is a wrong answer.
   */
  const readSkyAuto = (): boolean =>
    document.querySelector<HTMLInputElement>("[data-sky-auto]")?.checked ?? initialState.skyauto;

  const canvas = document.querySelector<HTMLCanvasElement>("[data-stage]");
  const status = document.querySelector<HTMLElement>("[data-status]");
  const setStatus = (t: string) => {
    if (status) status.textContent = t;
  };

  const params = new URLSearchParams(location.search);

  // ?forceWebGL exercises the WebGPURenderer's WebGL 2 fallback on a machine
  // that would otherwise always take the native path. Development affordance:
  // ~5% of visitors get that backend, so it needs to be checkable on demand.
  const forceWebGL = params.has("forceWebGL");

  /*
   * ?stars=N — a smaller population, for driving this page from a test harness.
   *
   * `prepareStarField` is 180-425 ms at the default 10,000 and runs on every rebuild, so a
   * headless browser stepping through twelve transfers spends most of its time in CPU
   * preparation. The cost is very nearly linear in the count, so 1,500 stars turns a
   * transfer sweep from minutes into seconds.
   *
   * IT CHANGES WHAT IS ON SCREEN, and not only how fast. Fewer stars means a fainter summed
   * background (the sky glow IS the summed wings of every star) and a different white point,
   * so a frame drawn at 1,500 is NOT the frame drawn at 10,000 and must not be compared
   * against numbers measured at the default. The status line reports the count for that
   * reason, and the parameter is deliberately absent from the UI: it is a harness affordance,
   * not a control, and offering it as one would invite exactly that comparison.
   *
   * Clamped rather than trusted. A URL is user input, and `clusterStarTable` would happily
   * accept a NaN or a ten-million-star request and hang the tab.
   */
  const starsParam = Number(params.get("stars"));
  const starCountOverride = Number.isFinite(starsParam) && starsParam > 0
    ? Math.min(50_000, Math.max(100, Math.floor(starsParam)))
    : undefined;

  /*
   * ── EVERY CONTROL IS IN THE URL ──
   *
   * An outstanding commitment from ADR 0012 ("One canonical cluster = (seed, params, t) …
   * Reproducible and URL-shareable"), and the thing that makes this page usable away from a
   * keyboard: a class gets one link per concept, a talk becomes bookmarks instead of live slider
   * drags, a figure becomes reproducible, and a bug report from a stranger arrives as a state
   * rather than a description. A preset needs no machinery — a preset is a named URL.
   *
   * The codec is `core/params/urlState`, gated by `check:url-state`; the schema is
   * `viz/starfield/labParams`, derived from the same registries that generate the options here.
   * This file owns only `location` and `history`, which is the part that cannot be node-tested.
   */
  const initialState: LabState = decode(LAB_SCHEMA, location.search);

  /*
   * ?project — PROJECTOR MODE: the frame, the claim and the presets, nothing else.
   *
   * A URL flag rather than a button, for the same reason presets are URLs: a talk is a set of
   * links, and the thing you least want to do live is hunt for a toggle. It hides the controls
   * and the long documentation below, leaving what a room can actually read from the back.
   *
   * Not in `LAB_SCHEMA` on purpose. It changes how the page is DISPLAYED, not what the renderer
   * computes — the same reason `stars` and `forceWebGL` are passthrough keys — so it must not
   * appear in a state comparison or make an otherwise-default link look non-default.
   */
  const projector = params.has("project");
  if (projector) document.documentElement.dataset.project = "";

  /** The harness keys, preserved verbatim so a debugging link survives being copied back. */
  const passthrough: Record<string, string> = {};
  for (const key of PASSTHROUGH_KEYS) {
    const raw = params.get(key);
    if (raw !== null) passthrough[key] = raw;
  }

  const setValue = (selector: string, value: string): void => {
    const el = document.querySelector<HTMLInputElement | HTMLSelectElement>(selector);
    if (el) el.value = value;
  };

  /**
   * Push the decoded state into the controls, BEFORE the renderer starts.
   *
   * Order matters: `read()` below builds the renderer's options by reading the DOM, so the DOM
   * has to be the state first. Setting the controls and letting one code path read them keeps a
   * single source of truth — the alternative, passing the state to the renderer AND setting the
   * controls separately, is two paths that can disagree, and the disagreement would show up as a
   * link whose picture does not match its own sliders.
   */
  const applyState = (s: LabState): void => {
    setValue("[data-instrument]", s.instrument);
    setValue("[data-scheme]", s.scheme);
    setValue("[data-band]", s.band);
    setValue("[data-scaling]", s.transfer === TRANSFER_AUTO ? "" : s.transfer);
    setValue("[data-depth]", String(s.depth));
    /* The URL carries the FRACTION; the widget carries its cubic position. Same split as `dist`. */
    setValue("[data-sky]", String(sliderFromSkyFraction(s.sky)));
    setValue("[data-dist]", String(Math.log10(s.dist)));
    setValue("[data-curve]", String(s.curve));
    const skyAutoEl = document.querySelector<HTMLInputElement>("[data-sky-auto]");
    if (skyAutoEl) skyAutoEl.checked = s.skyauto;
    setValue("[data-bloom]", String(s.bloom));
    setValue("[data-aureole]", String(s.aureole));
    setValue("[data-spikes]", String(s.spikes));
    setValue("[data-exposure]", String(s.exposure));
    setValue("[data-min-mass]", String(s.minmass));
  };

  const readValue = (selector: string, fallback: string): string =>
    document.querySelector<HTMLInputElement | HTMLSelectElement>(selector)?.value ?? fallback;

  /**
   * The current control state, for writing back to the URL.
   *
   * `motion` is passed in rather than read from the renderer, and that is the whole point of it
   * being tri-state: `lab.drifting` reports what the renderer is DOING, which is not the same as
   * what anyone CHOSE. Recording the former is what put `?spin` on every link and would have
   * overridden a reduced-motion visitor's setting. Only a deliberate click moves this off `auto`.
   */
  const readState = (motion: MotionChoice): LabState => ({
    instrument: readValue("[data-instrument]", initialState.instrument),
    scheme: readValue("[data-scheme]", initialState.scheme),
    band: readValue("[data-band]", initialState.band),
    transfer: readValue("[data-scaling]", "") || TRANSFER_AUTO,
    depth: Number(readValue("[data-depth]", String(initialState.depth))),
    sky: readSky(),
    /* Falls back to the URL, because the checkbox does not exist — see `readSkyAuto`. */
    skyauto: readSkyAuto(),
    bloom: Number(readValue("[data-bloom]", "0.35")),
    aureole: Number(readValue("[data-aureole]", "1")),
    spikes: Number(readValue("[data-spikes]", "1")),
    exposure: Number(readValue("[data-exposure]", "1")),
    minmass: Number(readValue("[data-min-mass]", "0")),
    /*
     * ROUNDED TO WHOLE PARSECS on the way into the URL. The slider is logarithmic and its raw
     * value carries more precision than the distance is known to; `dist=136` is a link someone can
     * read and retype from a lecture note, `dist=136.4782` is machine exhaust.
     */
    dist: Math.round(10 ** Number(readValue("[data-dist]", String(Math.log10(D0_PC))))),
    curve: Number(readValue("[data-curve]", String(DEFAULT_LUPTON_DEPTH_MAG))),
    motion,
  });

  /**
   * Write the state to the address bar.
   *
   * `replaceState`, not `pushState`: a slider drag would otherwise stack one history entry per
   * frame and make the back button unusable — the visitor would have to press it two hundred
   * times to leave the page. The URL is a live description of the state, not a trail through it.
   */
  const syncUrl = (motion: MotionChoice): void => {
    const query = encode(LAB_SCHEMA, readState(motion), passthrough);
    history.replaceState(null, "", query === "" ? location.pathname : `?${query}`);
  };

  applyState(initialState);

  /*
   * The registry, serialised at build time. Only the two fields the client needs, so the page
   * cannot drift from `core/photometry/instruments` by restating a composite: if a triple changes
   * there, this changes with it.
   */
  const INSTRUMENT_TABLE: Record<string, { label: string; composite: readonly [string, string, string]; brightnessBand: string }> =
    JSON.parse(document.querySelector<HTMLScriptElement>("#srl-instruments")!.textContent!);

  /*
   * Show that the brightness band is DRIVEN when an instrument is selected, rather than leaving an
   * enabled control that silently does nothing.
   *
   * A dead control is worse than an absent one: it invites the conclusion that the band does not
   * matter, which is the opposite of what this page is for. So it is disabled, moved to the
   * instrument's own band, and labelled with why.
   */
  const DEPTH_DEFAULTS: Record<string, number> = JSON.parse(
    document.querySelector<HTMLScriptElement>("#srl-depth-defaults")!.textContent!,
  );

  /*
   * MOVE THE DEPTH SLIDER WHEN THE MODE CHANGES, because the parameter it drives changes with it.
   *
   * In photometric mode `depthMag` sets Lupton's Q, a per-pixel curve; in population mode it sets the
   * per-star asinh softening, so it decides whether the faint majority renders at all. Leaving one
   * position across a mode switch is the regression this fixes: at the photometric default of 8 the
   * median star's signal is 1e-4 against a 0.02 threshold, so only the hot blue stars survived and
   * the whole field read as one colour.
   *
   * Only moved when the slider is still sitting on the OTHER mode's default — otherwise a value the
   * user chose deliberately would be discarded every time they compared modes.
   */
  /*
   * A DEPTH IN THE URL WINS OVER THE MODE DEFAULT, which this function would otherwise clobber.
   *
   * Its first call has `lastMode === null` and unconditionally forces the mode's default, which
   * is right on a cold load and wrong when a link said `?depth=12` — the slider would move to 16
   * before the first frame and the link would show a different picture from the one it recorded.
   * That is the failure mode a shared link exists to prevent, so an explicit depth suppresses the
   * initial forcing only. Every later mode switch behaves exactly as before.
   */
  const depthFromUrl = params.has("depth");

  let lastMode: string | null = null;
  const syncDepthForMode = (): void => {
    const el = document.querySelector<HTMLInputElement>("[data-depth]");
    const id = document.querySelector<HTMLSelectElement>("[data-instrument]")?.value ?? "population";
    const mode = id === "population" ? "population" : "photometric";
    if (!el || mode === lastMode) {
      lastMode = mode;
      return;
    }
    const other = mode === "population" ? "photometric" : "population";
    const firstCall = lastMode === null;
    const sittingOnOtherDefault = Number(el.value) === DEPTH_DEFAULTS[other];
    if (firstCall ? !depthFromUrl : sittingOnOtherDefault) {
      el.value = String(DEPTH_DEFAULTS[mode]);
    }
    lastMode = mode;
  };

  const syncBandControl = (): void => {
    const sel = document.querySelector<HTMLSelectElement>("[data-band]");
    const note = document.querySelector<HTMLElement>("[data-band-note]");
    const id = document.querySelector<HTMLSelectElement>("[data-instrument]")?.value ?? "population";
    const inst = INSTRUMENT_TABLE[id];
    if (!sel) return;
    sel.disabled = inst !== undefined;
    if (inst) sel.value = inst.brightnessBand;
    if (note) note.textContent = inst ? `— set by ${inst.label}` : "";
  };

  /** Short band name for the magnitude readout, e.g. "V", "Rubin r". */
  const bandLabelFor = (id: string): string =>
    document.querySelector<HTMLOptionElement>(`[data-band] option[value="${id}"]`)?.textContent ?? id;

  const read = () => {
    // Depth is OMITTED when its control is missing, so core/imaging's tuned default
    // applies. A fallback number here would be a second place the same fact lives,
    // and the previous one silently disagreed with it.
    const depth = document.querySelector<HTMLInputElement>("[data-depth]")?.value;
    const minMass = Number(document.querySelector<HTMLInputElement>("[data-min-mass]")?.value ?? 0);
    const instrumentId = document.querySelector<HTMLSelectElement>("[data-instrument]")?.value ?? "population";
    /*
     * Empty means "follow mode", so it is OMITTED rather than defaulted here — `prepare` owns the
     * per-mode default and a second copy of it would be a second thing to keep true.
     *
     * VALIDATED against the registry rather than cast. The select is generated from `TRANSFERS`,
     * so a bad value can only arise from a stale cached page or a hand-edited DOM — and in that
     * case falling back to "follow mode" is right, while `as never` would have handed `prepare` an
     * id it has no node for.
     */
    const rawScaling = document.querySelector<HTMLSelectElement>("[data-scaling]")?.value ?? "";
    /*
     * VALIDATED BY THE SCHEMA'S OWN FIELD, so "which transfer ids are legal" has exactly one
     * home — the registry that generated both the options above and the URL codec. An
     * independent Set here would be a third copy, and the one that silently kept accepting a
     * transfer after it was removed.
     */
    const parsed = LAB_SCHEMA.transfer.parse(rawScaling);
    const scaling: TransferId | "" =
      parsed === undefined || parsed === TRANSFER_AUTO ? "" : (parsed as TransferId);
    const inst = INSTRUMENT_TABLE[instrumentId];
    /*
     * An instrument supplies BOTH the composite and the brightness band; "population" supplies
     * neither, and that omission is what selects the temperature-ramp path in `prepare`. Passing an
     * invented triple for it would turn "this is a temperature ramp" into a false claim that three
     * named filters recorded something.
     */
    return {
      scheme: document.querySelector<HTMLSelectElement>("[data-scheme]")?.value ?? "true",
      band: inst ? inst.brightnessBand : (document.querySelector<HTMLSelectElement>("[data-band]")?.value ?? "V"),
      ...(inst ? { bandTriple: inst.composite } : {}),
      colorMode: inst ? ("photometric" as const) : ("population" as const),
      ...(scaling === "" ? {} : { scaling }),
      skyLevel: readSky(),
      skyAuto: readSkyAuto(),
      bloom: Number(document.querySelector<HTMLInputElement>("[data-bloom]")?.value ?? 0.35),
      aureoleStrength: Number(document.querySelector<HTMLInputElement>("[data-aureole]")?.value ?? 1),
      spikeStrength: Number(document.querySelector<HTMLInputElement>("[data-spikes]")?.value ?? 1),
      ...(depth === undefined ? {} : { starDepthMag: Number(depth) }),
      pixelDepthMag: Number(
        document.querySelector<HTMLInputElement>("[data-curve]")?.value ?? DEFAULT_LUPTON_DEPTH_MAG,
      ),
      exposure: Number(document.querySelector<HTMLInputElement>("[data-exposure]")?.value ?? 1),
      distancePc: 10 ** Number(document.querySelector<HTMLInputElement>("[data-dist]")?.value ?? Math.log10(D0_PC)),
      minMass,
    };
  };

  if (canvas) {
    /*
     * `onSkyMeasured` re-runs the readout when the async probe lands. `lab` is not yet bound when
     * this object is built, so the handler is installed through a mutable slot rather than
     * capturing it — the alternative is a second `initStarLab` call signature just to pass a
     * callback that needs the thing being constructed.
     */
    let onSkyLanded: () => void = () => {};
    initStarLab(canvas, {
      forceWebGL,
      onSkyMeasured: () => onSkyLanded(),
      // Omitted unless asked for, so `initStarLab`'s own default stays the single home for it.
      ...(starCountOverride === undefined ? {} : { count: starCountOverride }),
      ...read(),
    })
      .then((lab) => {
        const label = lab.backend === "webgpu" ? "WebGPU" : "WebGL 2";
        const depthVal = document.querySelector<HTMLElement>("[data-depth-val]");
        const massVal = document.querySelector<HTMLElement>("[data-minmass-val]");
        const selection = document.querySelector<HTMLElement>("[data-selection]");
        /*
         * THE CHEAP HALF OF THE READOUT — everything derivable from the controls themselves.
         *
         * Split out from `show` so a slider's own number tracks the thumb immediately while the
         * expensive rebuild is coalesced (see `scheduleUpdate`). Reading these from the DOM
         * rather than from `stats` is correct here precisely BECAUSE they are the control's
         * value, not a result: they are what was asked for, and they should update the moment it
         * is asked.
         */
        const showInputs = () => {
          const minMass = Number(
            document.querySelector<HTMLInputElement>("[data-min-mass]")?.value ?? 0,
          );
          const bloomEl = document.querySelector<HTMLInputElement>("[data-bloom]");
          const bloomVal = document.querySelector<HTMLElement>("[data-bloom-val]");
          if (bloomVal && bloomEl) bloomVal.textContent = Number(bloomEl.value).toFixed(2);
          /*
           * "off", not "0.00x". Zero removes the term from the model rather than scaling it to
           * nothing, and the readout should say which of those happened — it is the difference
           * between an instrument without a spider and one whose spikes are too faint to see.
           */
          for (const [sel, out] of [
            ["[data-aureole]", "[data-aureole-val]"],
            ["[data-spikes]", "[data-spikes-val]"],
          ] as const) {
            const el = document.querySelector<HTMLInputElement>(sel);
            const val = document.querySelector<HTMLElement>(out);
            if (el && val) {
              const n = Number(el.value);
              val.textContent = n === 0 ? "off" : `${n.toFixed(2)}x`;
            }
          }
          if (massVal) massVal.textContent = minMass > 0 ? `${minMass.toFixed(2)} M☉` : "all";
          const expEl = document.querySelector<HTMLInputElement>("[data-exposure]");
          const expVal = document.querySelector<HTMLElement>("[data-exposure-val]");
          if (expEl && expVal) {
            const e = Number(expEl.value);
            // In stops, because that is how an exposure is actually discussed.
            const stops = Math.log2(e);
            expVal.textContent =
              e === 1 ? "1x" : `${e.toFixed(2)}x — ${stops > 0 ? "+" : ""}${stops.toFixed(1)} stops`;
          }
          /*
           * Distance reads in pc or kpc, with a familiar cluster named nearby. A number alone is
           * not a scale to anyone who does not already know the answer, and this control exists to
           * teach — "1.4 kpc" means little, "1.4 kpc — beyond Westerlund 1" places it.
           */
          /*
           * The transfer-span control is DISABLED unless Lupton is selected, because every other
           * transfer has a fixed shape and ignores it. A live control that does nothing invites
           * the conclusion that the parameter does not matter, which is the opposite of true —
           * the same reasoning that disables the band control under an instrument.
           */
          const curveEl = document.querySelector<HTMLInputElement>("[data-curve]");
          const curveVal = document.querySelector<HTMLElement>("[data-curve-val]");
          const transferNow = document.querySelector<HTMLSelectElement>("[data-scaling]")?.value;
          const luptonSelected = transferNow === "lupton";
          if (curveEl) curveEl.disabled = !luptonSelected;
          if (curveVal && curveEl) {
            curveVal.textContent = luptonSelected
              ? `${Number(curveEl.value).toFixed(2)} mag — Lupton's Q`
              : "— only Lupton varies with it";
          }
          const distEl = document.querySelector<HTMLInputElement>("[data-dist]");
          const distVal = document.querySelector<HTMLElement>("[data-dist-val]");
          if (distEl && distVal) {
            const pc = 10 ** Number(distEl.value);
            const near = [
              [136, "the Pleiades"],
              [400, "the Orion Nebula Cluster"],
              [1600, "the Carina Nebula"],
              [4000, "Westerlund 1"],
              [7000, "NGC 3603"],
            ] as const;
            let label = "";
            for (const [d, name] of near) {
              if (pc >= d * 0.75 && pc <= d * 1.33) { label = ` — near ${name}`; break; }
            }
            distVal.textContent =
              (pc >= 1000 ? `${(pc / 1000).toFixed(2)} kpc` : `${Math.round(pc)} pc`) + label;
          }
          // The filtered-population warning is driven by the CUT, not by the star
          // count, so it cannot fall out of step with what is actually drawn.
          if (selection) selection.hidden = minMass <= 0;
        };

        const show = (s: typeof lab.stats) => {
          showInputs();
          if (depthVal) depthVal.textContent = s.depthMag.toFixed(2);
          /*
           * THE SKY READOUT SHOWS THE CONSEQUENCE, NOT THE SETTING.
           *
           * "0.5% of white" says nothing about whether the background went black — which is the
           * only question being asked of this control. So when the sky is MEASURED the readout
           * reports what came back and how much of the sampled frame sat at or below it, and the
           * slider is disabled because it is no longer what decides.
           *
           * `lab.sky.pixels === 0` means the probe has not returned yet (it is async, a frame or
           * two behind a rebuild), and that is shown as "measuring…" rather than as a zero — a
           * zero would read as "the sky is black", which is the opposite of the truth.
           */
          const skyVal = document.querySelector<HTMLElement>("[data-sky-val]");
          const skyEl = document.querySelector<HTMLInputElement>("[data-sky]");
          const autoOn = readSkyAuto();
          if (skyEl) skyEl.disabled = autoOn;
          const chosenSky = readSky();
          if (skyVal) {
            skyVal.textContent = autoOn
              ? lab.sky.pixels > 0
                ? `measured ${skyPercent(lab.sky.level)} of white`
                : "measuring…"
              : chosenSky > 0
                ? `${skyPercent(chosenSky)} of white`
                : "none";
          }
          const autoNote = document.querySelector<HTMLElement>("[data-sky-auto-note]");
          if (autoNote) {
            /*
             * `empty` IS REPORTED, not just used. It is the fraction of sampled pixels no quad
             * reached, and excluding those from the percentile is the fix that made this probe
             * repeatable at all — so the number that governs the estimate has to be visible next
             * to the estimate. It is also the one measurement here still unexplained (it rises
             * with bloom, then falls), and a diagnostic you have to re-instrument to see is a
             * diagnostic nobody checks.
             */
            autoNote.textContent = autoOn
              ? lab.sky.pixels > 0
                ? `${(100 * lab.sky.sampled).toFixed(0)}% of ${lab.sky.pixels.toLocaleString()} covered px at or below · ${(100 * lab.sky.empty).toFixed(0)}% of the sample uncovered · ${lab.reach.count.toLocaleString()} stars reach`
                : ""
              : "";
          }
          // "above threshold", not "visible": the count is a property of each
          // star's display signal, and says nothing about whether it is inside
          // the frame. A Plummer sphere has a long tail, so some of these stars
          // are off-screen, and calling them visible would overstate the readout.
          const limit = Number.isFinite(s.faintestVisibleMbol)
            ? ` · faintest m_bol ${s.faintestVisibleMbol.toFixed(1)}`
            : "";
          /*
           * ABSOLUTE magnitude range of the drawn stars, in the selected band's own
           * system. Reported separately from the depth because the two are different
           * kinds of thing: this describes the STARS and does not move when the
           * exposure or the camera does, which is what makes it the teaching number.
           */
          const bandId = read().band;
          const sys = s.absMag.system === "AB" ? `M(${bandLabelFor(bandId)})` : "M_bol";
          const abs = Number.isFinite(s.absMag.brightest)
            ? ` · ${sys} ${s.absMag.brightest.toFixed(1)} to ${s.absMag.faintest.toFixed(1)}`
            : "";
          /*
           * THE COUNT COMES FROM THE TRANSFER ACTUALLY APPLIED, via `lab.reach`.
           *
           * It used to come from `stats.visible`, which counts through `asinhResponse` — the
           * per-star curve POPULATION mode uses — whatever transfer was selected. In photometric
           * mode that is not the applied curve, and the number moved the WRONG WAY: measured at
           * 1,500 stars, raising depth from 8 to 14 took it from 11.7% to 66.8% while the count of
           * stars standing clear of the background fell from 786 to 706. The image got worse while
           * the readout got better, which is how a lab tool wastes its owner's afternoon.
           *
           * `mean` is the other half, and it is deliberately NOT a verdict. In photometric mode the
           * background is the summed wings of every star, so a star can clear the transfer's floor
           * and still be invisible against what it sits on — the count is necessary and not
           * sufficient. The analytic mean is reported as a companion so that regime is visible,
           * labelled as a MEAN because on a heavy-tailed star field it runs well above the median
           * pixel. A boolean "sky-limited" flag was tried and removed: it came out true even on a
           * frame that was a quarter pure black, which is the same confident-and-wrong failure this
           * change exists to remove. The honest background needs a percentile readback.
           */
          const r = lab.reach;
          const reachPct = ((100 * r.count) / lab.starCount).toFixed(1);
          const skyNote = ` · mean frame level ${(100 * r.meanLevel).toFixed(0)}%`;
          /*
           * THE CLAIM SENTENCE. Ordered along the ladder — population, then distance, then
           * instrument, then display — so it reads as the path the light took.
           *
           * The mode clause is the one that matters most and is stated most carefully: population
           * mode discards how much light each star emits, so it must never be described as what a
           * telescope sees. That is a site-claims obligation, not a stylistic preference.
           */
          const claim = document.querySelector<HTMLElement>("[data-claim]");
          if (claim) {
            const instId =
              document.querySelector<HTMLSelectElement>("[data-instrument]")?.value ?? "population";
            const inst = INSTRUMENT_TABLE[instId];
            const minMass = Number(
              document.querySelector<HTMLInputElement>("[data-min-mass]")?.value ?? 0,
            );
            const pc = s.distancePc;
            const dist = pc >= 1000 ? `${(pc / 1000).toFixed(1)} kpc` : `${Math.round(pc)} pc`;
            const shown = s.shown.toLocaleString();
            const what = inst
              ? `as ${inst.label} records it through ${bandLabelFor(inst.brightnessBand)}`
              : "by temperature at unit luminance — the population itself, not what a telescope sees";
            const cut = minMass > 0 ? ` above ${minMass.toFixed(2)} M☉` : "";
            claim.textContent =
              `${shown} stars${cut} at ${dist}, ${what}. ` +
              `Shown with ${s.scaling}, reaching ${s.depthMag.toFixed(0)} magnitudes below white.`;
          }
          setStatus(
            `${label}${forceWebGL ? " (forced)" : ""} · ${s.shown.toLocaleString()} of ` +
              `${lab.starCount.toLocaleString()} drawn · ${r.count.toLocaleString()} reach the ` +
              `display (${reachPct}%) · ${s.clipping} clipping · depth ${s.depthMag.toFixed(1)} mag` +
              `${limit}${abs}${skyNote}`,
          );
        };
        show(lab.stats);
        onSkyLanded = () => show(lab.stats);

        /*
         * PRESETS. Applying one is: encode its partial state over the defaults, push that to the
         * address bar, then re-read the controls from it — the same path a pasted link takes. So a
         * preset cannot reach a state a URL could not, and there is exactly one code path from
         * "some state" to "the controls and the renderer agree".
         */
        const presetBtns = [...document.querySelectorAll<HTMLButtonElement>("[data-preset]")];
        const presetNote = document.querySelector<HTMLElement>("[data-preset-note]");
        let activePreset = -1;

        const markActive = () => {
          presetBtns.forEach((b, i) => b.setAttribute("aria-pressed", String(i === activePreset)));
          if (presetNote) {
            presetNote.textContent = activePreset >= 0 ? (LAB_PRESETS[activePreset]?.note ?? "") : "";
          }
        };

        const applyPreset = (i: number) => {
          const preset = LAB_PRESETS[i];
          if (!preset) return;
          /*
           * MOTION SURVIVES A PRESET, everything else is reset.
           *
           * A preset is a complete statement about the IMAGE, so fields it does not name go back
           * to their defaults — otherwise stepping through a talk would carry stray settings from
           * whatever was fiddled with three presets ago. But motion is not part of the image: it
           * is a presenter's or a viewer's choice, in the same class as `stars` and `forceWebGL`,
           * and resetting it would restart the drift mid-talk for someone who had deliberately
           * stopped it — or override a reduced-motion preference on every keypress.
           */
          const next = { ...decode(LAB_SCHEMA, ""), ...preset.state, motion: motionChoice };
          history.replaceState(null, "", `?${encode(LAB_SCHEMA, next, passthrough)}`);
          applyState(next);
          // The mode-following controls have to catch up before anything reads them.
          lastMode = null;
          syncDepthForMode();
          syncBandControl();
          showInputs();
          activePreset = i;
          markActive();
          show(lab.update(read()));
        };

        presetBtns.forEach((b, i) => b.addEventListener("click", () => applyPreset(i)));

        /*
         * ARROW KEYS STEP, so a demo needs no mouse — and NUMBER KEYS jump, so a slide can name
         * one directly. Ignored while a control has focus, because Left/Right on a focused slider
         * already means something and stealing it would make the sliders unusable by keyboard,
         * which is precisely the audience this feature is for.
         */
        addEventListener("keydown", (e) => {
          const t = e.target as HTMLElement | null;
          if (t && /^(INPUT|SELECT|TEXTAREA)$/.test(t.tagName)) return;
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
            const step = e.key === "ArrowRight" ? 1 : -1;
            const n = LAB_PRESETS.length;
            applyPreset(((activePreset < 0 ? (step > 0 ? -1 : 0) : activePreset) + step + n) % n);
            e.preventDefault();
          } else if (/^[1-9]$/.test(e.key)) {
            const i = Number(e.key) - 1;
            if (i < LAB_PRESETS.length) {
              applyPreset(i);
              e.preventDefault();
            }
          }
        });
        markActive();

        /*
         * THE CONTACT SHEET, rendered on demand.
         *
         * Each tile is drawn with `putImageData` from the renderer's own readback — not a second
         * drawing path, so a tile cannot differ from the pipeline by anything except the transfer
         * it names. The caption carries the family, because that is the one difference a reader
         * cannot see: astronomical curves are display-referred, photographic ones are
         * scene-referred and get the sRGB encode.
         */
        const sheetBtn = document.querySelector<HTMLButtonElement>("[data-sheet]");
        const sheetOut = document.querySelector<HTMLElement>("[data-sheet-out]");
        const sheetNote = document.querySelector<HTMLElement>("[data-sheet-note]");
        sheetBtn?.addEventListener("click", async () => {
          if (!sheetOut) return;
          sheetBtn.disabled = true;
          if (sheetNote) sheetNote.textContent = "rendering…";
          try {
            const current = lab.stats.scaling;
            const tiles = await lab.contactSheet(TRANSFER_ORDER);
            sheetOut.replaceChildren(
              ...tiles.map((t) => {
                const fig = document.createElement("figure");
                fig.className = "srl__tile" + (t.id === current ? " srl__tile--current" : "");
                const c = document.createElement("canvas");
                c.width = t.width;
                c.height = t.height;
                const ctx = c.getContext("2d");
                if (ctx) {
                  // `createImageData` then `set`, rather than `new ImageData(pixels, …)`: the
                  // renderer's buffer is typed `Uint8ClampedArray<ArrayBufferLike>` and the
                  // constructor wants an `ArrayBuffer`-backed one. Copying is the honest fix; a
                  // cast would assert a backing store this code does not control.
                  const img = ctx.createImageData(t.width, t.height);
                  img.data.set(t.pixels);
                  ctx.putImageData(img, 0, 0);
                }
                const cap = document.createElement("figcaption");
                const name = document.createElement("b");
                name.textContent = t.id;
                const fam = document.createElement("span");
                fam.textContent = TRANSFER_FAMILY[t.id] ?? "";
                cap.append(name, fam);
                fig.append(c, cap);
                return fig;
              }),
            );
            sheetOut.hidden = false;
            if (sheetNote) {
              sheetNote.textContent =
                "same field, camera, white point and sky — only the transfer differs. Tiles are rendered smaller than the canvas, so each differs from the full frame; they are all the same size, so the comparison between them is exact.";
            }
          } finally {
            sheetBtn.disabled = false;
          }
        });

        /*
         * ONE REBUILD PER FRAME, COALESCED — and this is a hang fix, not a polish item.
         *
         * `lab.update` re-runs `prepareStarField`, which is 180-425 ms for 10,000 stars (413 ms
         * through a three-band Rubin triple, because it integrates a Planck function through a
         * real filter curve per star per band — roughly 40,000 numerical integrals). That cost is
         * the physics and is not going away.
         *
         * A range input fires `input` CONTINUOUSLY while dragged. Calling `update` straight from
         * the handler therefore queued ~25 seconds of blocking main-thread work per second of
         * dragging, and the backlog grew without bound — the renderer stops responding while
         * holding a live WebGPU context, which is how the tab gets killed rather than merely
         * being slow.
         *
         * Coalescing to a single rAF bounds it: however many events arrive, at most one rebuild
         * runs per frame and the backlog cannot grow. The controls' own numbers still update
         * synchronously via `showInputs`, so the slider stays responsive to the hand while the
         * image catches up — which is the honest split, since those numbers are the REQUEST and
         * the rest of the readout is the RESULT.
         *
         * The right long-term fix is narrower: sky and bloom are pure display uniforms and need
         * no re-prepare at all. That is a change to `StarLab`'s surface rather than to this page,
         * so it is left for the renderer work rather than smuggled in here.
         */
        /*
         * A CLICK IS A CHOICE, and only a click moves this off `auto`.
         *
         * The renderer's own starting state is a viewer preference, not a decision — so it must
         * never be written into a link. Once someone toggles the button they HAVE decided, and
         * that decision is worth carrying to whoever opens the link next.
         */
        let motionChoice: MotionChoice = initialState.motion;

        let pendingUpdate = 0;
        let pendingRebuild = false;
        /*
         * ONE UPDATE PER FRAME, of whichever KIND is needed.
         *
         * Both paths are coalesced, and the display-only one had to be: `setDisplay` skips
         * `prepareStarField` but still recalibrates the exposure and recounts what reaches the
         * display, which is ~26 ms for 10,000 stars. Run straight from the handler that is 26 ms
         * of blocking work per input event — better than 425, still a drag rather than a slider.
         *
         * `pendingRebuild` latches: if any event in a frame needs the physics, the frame's single
         * update is a full rebuild. So dragging sky is cheap, dragging exposure is not, and
         * dragging both in one frame is correct rather than merely fast.
         */
        const schedule = (rebuild: boolean) => {
          if (rebuild) pendingRebuild = true;
          if (pendingUpdate !== 0) return;
          pendingUpdate = requestAnimationFrame(() => {
            pendingUpdate = 0;
            if (pendingRebuild) {
              pendingRebuild = false;
              show(lab.update(read()));
              return;
            }
            lab.setDisplay({
              bloom: Number(document.querySelector<HTMLInputElement>("[data-bloom]")?.value ?? 0.35),
              skyLevel: readSky(),
              skyAuto: readSkyAuto(),
            });
            show(lab.stats); // stats are unchanged; the readout still needs the new sky
          });
        };

        for (const el of document.querySelectorAll<HTMLElement>(
          "[data-instrument],[data-scheme],[data-band],[data-scaling],[data-sky],[data-sky-auto],[data-bloom],[data-depth],[data-exposure],[data-min-mass],[data-dist],[data-curve],[data-aureole],[data-spikes]",
        )) {
          /*
           * DISPLAY-ONLY CONTROLS SKIP THE FIELD REBUILD.
           *
           * Bloom, the sky level and the sky mode are pipeline uniforms — they change no star
           * data — so they go through `setDisplay` and take effect in the next frame instead of
           * paying `prepareStarField`'s 180-425 ms. Everything else genuinely changes the physics
           * and still goes through the coalesced rebuild.
           *
           * The split is by DATA ATTRIBUTE rather than by a list of ids kept somewhere else,
           * because the two facts — "this control is display-only" and "this control is wired to
           * setDisplay" — must not be able to drift apart.
           *
           * THE OPTICS STRENGTHS ARE DELIBERATELY NOT HERE, and they look like they should be —
           * `starGraph` drives the aureole and spike amplitudes as live uniforms, so changing them
           * without a rebuild would visibly work. It would also be wrong: those amplitudes set how
           * far each profile reaches, and the quad is SOLVED against that reach. Shading a wider
           * wing inside a quad sized for a narrower one does not merely clip it — the shader
           * subtracts the profile's value at the quad EDGE across the whole star, so the core dims
           * and the halo truncates. They pay for the rebuild because they change the geometry.
           */
          const displayOnly = el.matches("[data-sky],[data-bloom],[data-sky-auto]");
          el.addEventListener("input", () => {
            syncDepthForMode();
            syncBandControl();
            showInputs(); // instant: the control's own value
            syncUrl(motionChoice); // instant: the address bar tracks the controls
            schedule(!displayOnly); // coalesced; a rebuild only when the physics changed
          });
        }
        syncDepthForMode();
        syncBandControl();

        // Motion toggle. The label is DERIVED from the renderer's state so it cannot
        // disagree with it — the starting state comes from prefers-reduced-motion.
        const motionBtn = document.querySelector<HTMLButtonElement>("[data-motion]");
        const motionLabel = document.querySelector<HTMLElement>("[data-motion-label]");
        const syncMotion = () => {
          if (!motionBtn || !motionLabel) return;
          const drifting = lab.drifting;
          motionBtn.setAttribute("aria-pressed", String(!drifting));
          motionLabel.textContent = drifting ? "Pause motion" : "Resume motion";
        };
        motionBtn?.addEventListener("click", () => {
          lab.setDrifting(!lab.drifting);
          motionChoice = lab.drifting ? "on" : "off";
          syncMotion();
          syncUrl(motionChoice);
        });
        /*
         * `auto` DEFERS to the viewer; `on` and `off` override in either direction.
         *
         * Silence in the URL means the visitor's `prefers-reduced-motion` decides, which is why
         * this only acts when the link said something explicit. Someone presenting a talk asks for
         * motion by name; someone who reduces motion system-wide keeps their setting unless a link
         * deliberately overrides it, and can still start it by hand either way.
         */
        if (motionChoice === "on" && !lab.drifting) lab.setDrifting(true);
        if (motionChoice === "off" && lab.drifting) lab.setDrifting(false);
        syncMotion();
        syncUrl(motionChoice);
        // Expose live state for verification without relying on a screenshot.
        (window as unknown as { starlab?: unknown }).starlab = {
          backend: lab.backend,
          get stats() {
            return lab.stats;
          },
          get reach() {
            return lab.reach;
          },
          get sky() {
            return lab.sky;
          },
          get info() {
            return lab.info;
          },
          get frames() {
            return lab.frames;
          },
          get drifting() {
            return lab.drifting;
          },
        };
      })
      .catch((err: unknown) => {
        setStatus(`Failed: ${String(err)}`);
      });
  }
</script>


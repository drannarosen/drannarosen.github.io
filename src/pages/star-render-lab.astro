---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { COLOR_SCHEMES } from "@novascope/core/colorimetry/schemes";
import { linearToSrgbRGB } from "@novascope/core/colorimetry";
import { spectralType } from "@novascope/core/stellar";
import {
  DEFAULT_LUPTON_DEPTH_MAG,
  DEFAULT_POPULATION_DEPTH_MAG,
  DEPTH_MAG_RANGE,
} from "@novascope/core/imaging/lupton";
import { PASSBANDS, bolometricCorrection } from "@novascope/core/photometry/passbands";
import { SURVEYS } from "@novascope/core/photometry/surveys";
import { INSTRUMENTS } from "@novascope/core/photometry/instruments";
import { TRANSFERS, type TransferFamily } from "@novascope/core/imaging/transfers";
import { clusterStarTable } from "@novascope/viz/starfield/source";
import { prepareStarField } from "@novascope/viz/starfield/prepare";

/*
 * Colour-scheme comparison, rendered at BUILD time. Every swatch is computed by
 * the same functions the GPU path will mirror, so this strip is a real preview
 * of the renderer's colour, not a mock-up drawn to look like one.
 */
const SAMPLE_TEFF = [2500, 3200, 4000, 4500, 5300, 5800, 6800, 8800, 12000, 20000, 30000, 40000];
const css = (c: readonly [number, number, number]): string => {
  const [r, g, b] = linearToSrgbRGB(c).map((v) => Math.round(v * 255));
  return `rgb(${r} ${g} ${b})`;
};
/*
 * Bands, grouped BY INSTRUMENT.
 *
 * These labels used to split on what kind of filter MODEL each band was — "Gaussian
 * model" against "measured curve" — because that was the honest distinction while
 * Johnson-Cousins and 2MASS were bells. Every band is now a measured curve, so the
 * distinction is gone and saying it here would be false. Grouping by instrument is
 * what is left to say, and it is the useful axis anyway: it puts the ground-based
 * surveys next to each other and the two space telescopes at the end, which is roughly
 * the order of what they can reach.
 */
const BAND_GROUPS: Array<{ label: string; ids: string[] }> = [
  { label: "Bolometric (total)", ids: ["bolometric"] },
  { label: "Johnson–Cousins / 2MASS", ids: ["U", "B", "V", "R", "I", "J", "H", "K"] },
  { label: "SDSS", ids: ["SDSS_u", "SDSS_g", "SDSS_r", "SDSS_i", "SDSS_z"] },
  { label: "Rubin / LSST", ids: ["LSST_u", "LSST_g", "LSST_r", "LSST_i", "LSST_z", "LSST_y"] },
  { label: "Gaia DR3", ids: ["Gaia_G", "Gaia_BP", "Gaia_RP"] },
  { label: "HST — no atmosphere, reaches the near-UV", ids: ["HST_F275W", "HST_F606W", "HST_F814W", "HST_F160W"] },
  { label: "JWST — reaches the mid-IR", ids: ["JWST_F090W", "JWST_F200W", "JWST_F444W", "JWST_F770W"] },
];
const bandLabel = (id: string): string =>
  id === "bolometric" ? "bolometric (total)" : (PASSBANDS[id]?.label ?? id);

/*
 * WHAT THE FILTER DOES TO A CLUSTER, measured at BUILD time on the same population
 * the canvas draws.
 *
 * The point is the trend, and it is a large one: the same 10,000 stars span ~30
 * magnitudes in the near-UV and ~14 in the mid-IR, because at 271 nm we are on the
 * Wien side where flux goes as exp(-hc/lkT) and at 7.7 um we are on the Rayleigh-Jeans
 * side where it goes as T. Choosing a filter is choosing how much dynamic range the
 * cluster has, and the visible sits in the middle of a factor-of-two swing.
 *
 * DERIVED HERE, NOT TYPED. Every one of these numbers moves if a curve, the IMF, the
 * sampling or the AB zero point changes, and a hand-typed table would go stale in
 * silence — which is precisely what happened to this page's "max/median 3.1 -> 1.9"
 * line, measured once and left behind. Sampling 10,000 stars per band at build time
 * costs milliseconds and buys a claim that cannot drift.
 */
const SPREAD_BANDS = ["HST_F275W", "U", "B", "V", "R", "K", "JWST_F200W", "JWST_F770W"];
const clusterForSpread = clusterStarTable({ sampling: { mode: "count", target: 10_000 } });
const BAND_SPREAD = SPREAD_BANDS.map((id) => {
  const { stats } = prepareStarField(clusterForSpread, { band: id, pixelRatio: 1 });
  return {
    id,
    label: bandLabel(id),
    lambdaEffNm: PASSBANDS[id]!.lambdaEffNm,
    range: stats.absMag.faintest - stats.absMag.brightest,
    visibleFraction: stats.visible / (clusterForSpread.length / 6),
    bcSun: bolometricCorrection(5772, PASSBANDS[id]!),
  };
});

/*
 * The depth slider is in MAGNITUDES below the display white point, which is the
 * physical statement the old "faint detail" slider was making opaquely: it read
 * dex of asinh softening, so the control could be tuned but never reported.
 *
 * IT DRIVES A DIFFERENT PARAMETER IN EACH MODE, which is why there are two defaults and why the
 * range must cover both. In PHOTOMETRIC mode it sets Lupton's Q — a per-pixel curve, where 8 mag
 * gives 34% black sky and 19.8 mag gives a saturated white rectangle. In POPULATION mode it sets the
 * per-STAR asinh softening, so it decides whether the faint majority renders at all, and 8 mag puts
 * the median star's signal at 1e-4 against a 0.02 visibility threshold — only the hot blue stars
 * survive, so the whole field reads as one colour.
 *
 * That is the bug this fixes. Narrowing the control to 6.25-16 for the Lupton path put the depth
 * population mode needs at its own maximum, and the default of 8 was the wrong end entirely.
 *
 * Bounds and defaults are IMPORTED from `core/imaging/lupton`, not restated here. A restated range
 * is exactly how this broke, and `check:star-optics` asserts the range brackets both defaults, so
 * narrowing one for the other's benefit fails the build.
 */
const DEPTH_STEP = 0.25;
const DEPTH_MIN = DEPTH_MAG_RANGE.min;
const DEPTH_MAX = DEPTH_MAG_RANGE.max;
const snap = (v: number): number => Math.round(v / DEPTH_STEP) * DEPTH_STEP;
/*
 * BOTH defaults are emitted, and the control switches between them, because `depthMag` drives a
 * different parameter in each mode — see `DEFAULT_POPULATION_DEPTH_MAG`. The page starts in
 * population mode, so that is the starting position.
 */
const DEPTH_DEFAULTS = {
  photometric: snap(DEFAULT_LUPTON_DEPTH_MAG),
  population: snap(DEFAULT_POPULATION_DEPTH_MAG),
};
const depthStart = DEPTH_DEFAULTS.population;
/*
 * The transfer control's option groups, PARTITIONED from the registry rather than listed.
 *
 * The group labels state the one difference that is real and that a reader cannot see: what the
 * output of each family already is. An astronomical curve's output IS the pixel — astropy writes
 * `make_lupton_rgb` straight to a PNG — so it gets no sRGB encode. A photographic operator returns
 * display-LINEAR values and is still owed one. Both mistakes render a plausible image, so the
 * distinction has to be said out loud somewhere, and the control is where the choice is made.
 */
const FAMILY_LABEL: Record<TransferFamily, string> = {
  astronomical: "Astronomical — display-referred, no encode after",
  photographic: "Photographic — scene-referred, sRGB encode after",
};
const TRANSFER_GROUPS = (["astronomical", "photographic"] as const).map((family) => ({
  label: FAMILY_LABEL[family],
  items: TRANSFERS.filter((t) => t.family === family),
}));

const schemeRows = COLOR_SCHEMES.map((s) => ({
  id: s.id,
  label: s.label,
  kind: s.kind,
  note: s.note,
  swatches: SAMPLE_TEFF.map((T) => ({ teff: T, css: css(s.color(T)), type: spectralType(T) })),
}));
---

<BaseLayout
  title="Star-render lab — Anna Rosen"
  description="Internal prototype: a photographic observed-mode star-cluster renderer on an analytically sampled cluster."
  path="/star-render-lab"
  noindex
>
  <PageHeader
    eyebrow="Prototype · not linked"
    title="Star-render lab"
    lede="A testbed for the photographic star renderer: apparent flux through a chosen filter, a robust asinh exposure calibrated once against the population, a bounded unresolved core with a Moffat PSF, and a broad faint aureole on the brighter stars. The cluster is sampled analytically — masses from the IMF, positions from a Plummer profile, and each star's temperature and radius derived from its ZAMS state — by the same novascope core the homepage hero uses. The physics lives in pure, dependency-free modules; this page is the Three.js harness around them. Drag to orbit, scroll to zoom. Add ?forceWebGL to exercise the WebGL 2 fallback."
  />

  <div class="srl wrap-wide">
    <!--
      GROUPED BY WHAT THE CONTROL DECIDES, because a flat row of seven gave no clue which ones
      interact. "What is shown" is a claim about the cluster; "How it is displayed" is a choice about
      pixels. That split is the same one `colorMode` makes in `prepare`, so the UI now says out loud
      what the code already distinguished.
    -->
    <div class="srl__group">
      <h2 class="srl__grouph">What is shown <span>a claim about the cluster</span></h2>
      <div class="srl__controls">
      <!--
        INSTRUMENT FIRST, because it drives two other controls.
        Choosing one sets both the colour composite and the brightness band together, which is the
        whole reason the registry exists: picking a band and a composite independently made it
        possible to show Rubin r brightness through a 2MASS composite — an image of nothing.
        "Population" is a genuinely different claim, not just a different colour source. Its hue
        comes from the scheme at UNIT LUMINANCE and its brightness from a per-star asinh signal, so a
        faint red dwarf is as saturated as a bright blue giant — which discards how much light each
        star actually emits. That discarding is exactly why the population is visible: measured hue
        spread 0.082 (true) or 0.150 (stretched) against 0.021 photometric, because 100 of these
        10,000 stars carry 92% of the light and they are all hot. It must not be described as what a
        telescope sees.
      -->
      <script id="srl-depth-defaults" type="application/json" is:inline set:html={JSON.stringify(DEPTH_DEFAULTS)} />
      <script id="srl-instruments" type="application/json" is:inline set:html={JSON.stringify(
        Object.fromEntries(INSTRUMENTS.map((i) => [i.id, {
          label: i.label, composite: i.composite, brightnessBand: i.brightnessBand,
        }])),
      )} />
      <label class="srl__ctl">Instrument
        <select data-instrument>
          <option value="population" selected>Population — temperature, not a camera</option>
          {INSTRUMENTS.map((i) => <option value={i.id}>{i.label}</option>)}
        </select>
      </label>
      <label class="srl__ctl">Colour scheme
        <select data-scheme>
          {COLOR_SCHEMES.map((s) => <option value={s.id}>{s.label} — {s.kind}</option>)}
        </select>
      </label>
      <label class="srl__ctl">Brightness band <span data-band-note></span>
        <select data-band>
          {BAND_GROUPS.map((g) => (
            <optgroup label={g.label}>
              {g.ids.map((b) => (
                <option value={b} selected={b === "V"}>{bandLabel(b)}</option>
              ))}
            </optgroup>
          ))}
        </select>
      </label>
      </div>
    </div>
    <div class="srl__group">
      <h2 class="srl__grouph">How it is displayed <span>choices about pixels, not about the stars</span></h2>
      <div class="srl__controls">
      <label class="srl__ctl">Depth <span data-depth-val>{depthStart.toFixed(2)}</span> mag below white
        <input type="range" min={DEPTH_MIN} max={DEPTH_MAX} step={DEPTH_STEP} value={depthStart} data-depth />
      </label>
      <!--
        THE DISPLAY TRANSFER — one control, twelve conventions, and no longer two mechanisms.
        Three's tone mappers used to be applied by `renderer.toneMapping` + `renderOutput()` while
        the astropy curves were TSL output nodes, so this control could only ever offer half the
        answer and AgX survived a refactor as a comment. They are all TSL functions; `transferNode`
        builds whichever is named and the page never learns the difference.

        GROUPED BY FAMILY, because the families genuinely disagree about whose job the sRGB encode
        is — astronomical curves are display-referred and get none, photographic operators are
        scene-referred and are owed one — and that is the honest answer to "why does astronomy not
        just use AgX". The groups are derived from the registry, not listed here.

        The default follows the MODE rather than being remembered: photometric wants Lupton (its
        input is linear and uncompressed), population wants linear (its per-star signal is already
        asinh-compressed, so a second curve would compress twice).
      -->
      <label class="srl__ctl">Display transfer
        <select data-scaling>
          <option value="" selected>Follow mode (Lupton / linear)</option>
          {TRANSFER_GROUPS.map((g) => (
            <optgroup label={g.label}>
              {g.items.map((t) => (
                <option value={t.id} title={t.note}>{t.label}</option>
              ))}
            </optgroup>
          ))}
        </select>
      </label>
      <!--
        SKY defaults to 0 and cannot be derived — the right level is a percentile of the rendered
        pixels, and unlike the white point it is not a stable fraction of anything computable without
        them (97x spread across configurations, against 1.45x). So it is a knob with an honest
        default rather than a fabricated one. Raising it is what makes the background go black
        instead of glowing blue: the glow is the summed wings of ten thousand stars, and it is blue
        because the light is dominated by hot ones.
      -->
      <label class="srl__ctl">Sky subtracted <span data-sky-val>none</span>
        <input type="range" min="0" max="0.05" step="0.0005" value="0" data-sky />
      </label>
      <!--
        BLOOM was the actual cause of the blue wash, not the stretch. It keys on display white, the
        stars that overflow in a young cluster are the hot blue ones, and their glow is spread across
        the frame — so the background takes their hue. Turn it to 0 to see the difference; the CPU
        reference, which has no bloom pass, measures a blue fraction of 0.15 where the live pipeline
        measured 0.75.
      -->
      <label class="srl__ctl">Bloom <span data-bloom-val>0.35</span>
        <input type="range" min="0" max="1" step="0.01" value="0.35" data-bloom />
      </label>
      <label class="srl__ctl">Exposure
        <input type="range" min="0.25" max="4" step="0.05" value="1" data-exposure />
      </label>
      </div>
    </div>
    <div class="srl__group">
      <h2 class="srl__grouph">Which stars are counted <span>a selection, and the page says so below</span></h2>
      <div class="srl__controls">
      <label class="srl__ctl">Lowest mass shown <span data-minmass-val>all</span>
        <input type="range" min="0" max="2" step="0.05" value="0" data-min-mass />
      </label>
      </div>
    </div>

    <p class="srl__selection" data-selection hidden>
      <strong>Population filtered.</strong> Stars below the mass cut are not drawn,
      so this is not what the cluster looks like — it is what its more massive stars
      contribute. The exposure is unchanged: the white point is still calibrated on
      the full population, so the remaining stars keep the brightness they had.
    </p>

    <div class="srl__stage">
      <canvas class="srl__canvas" data-stage aria-label="A star cluster rendered in observed mode."></canvas>
      {/*
        A REAL button, not a div: it must be reachable by keyboard and announced as a
        toggle. `aria-pressed` carries the state, and the label is set from the
        renderer's own `drifting` rather than assumed, because the starting state
        depends on prefers-reduced-motion and a control that lies about it is worse
        than no control.
      */}
      <button class="srl__motion" type="button" data-motion aria-pressed="false">
        <span data-motion-label>Pause motion</span>
      </button>
      <p class="srl__status" data-status aria-live="polite">Loading…</p>
    </div>

    <section class="srl__schemes" aria-labelledby="schemes-h">
      <h2 id="schemes-h" class="srl__h">Colour schemes</h2>
      <p class="srl__intro">
        One physics, several presentations. True colour is faithful and
        deliberately subtle — stellar blackbody colours trace only a short arc of
        colour space, so a real cluster reads mostly white with restrained tints.
        The stretched scheme keeps each star's physical <em>hue</em> and exaggerates
        only its saturation. Two earlier schemes (a 5× chroma stretch, and one
        saturated colour per MK class) were <strong>removed</strong>: rendered on the
        real cluster they asserted colour differences far larger than the physics
        supports, which costs more credibility than the legibility it buys.
      </p>

      {schemeRows.map((row) => (
        <div class="srl__scheme">
          <div class="srl__schemeHead">
            <span class="srl__schemeName">{row.label}</span>
            <span class={`srl__kind srl__kind--${row.kind}`}>{row.kind}</span>
          </div>
          <div class="srl__ramp">
            {row.swatches.map((s) => (
              <span
                class="srl__sw"
                style={`background:${s.css}`}
                title={`${s.teff.toLocaleString()} K · ${s.type}`}
              />
            ))}
          </div>
          <p class="srl__note">{row.note}</p>
        </div>
      ))}

      <div class="srl__axis">
        <span>2,500 K · M</span>
        <span>cooler ← Teff → hotter</span>
        <span>40,000 K · O</span>
      </div>
    </section>

    {/*
      DESIGN RECORD. This page is noindex and unlinked — a development surface — so
      it carries its own reasoning instead of leaving it in commit messages. The
      point is that every visible feature can be traced to either a cited relation
      or an explicitly-labelled choice, and that the two are never mixed up.
    */}
    <section class="srl__doc" aria-labelledby="doc-h">
      <h2 id="doc-h" class="srl__h">Design record</h2>
      <p class="srl__intro">
        What is <strong>derived</strong> and what is <strong>chosen</strong>, kept
        separate on purpose. Anything in the second column is a judgement that could
        reasonably be made differently; anything in the first is not up for taste.
      </p>

      <h3 class="srl__h3">Derived from physics</h3>
      <dl class="srl__dl">
        <dt>Population</dt>
        <dd>
          Masses from a Maschberger IMF, positions from a continuous Plummer profile,
          Teff and radius per star from its ZAMS state. Same novascope core as the
          homepage hero. Deterministic in one seed. The half-mass radius used for
          framing is <em>measured from the stars actually drawn</em>, not declared.
        </dd>
        <dt>Brightness</dt>
        <dd>
          Apparent flux through the chosen filter, with each star at its own distance
          so the inverse-square law applies <em>within</em> the cluster. Depth is the
          star's own z in the cluster frame — never the live camera's axis, because a
          cluster 400 pc away cannot be orbited, and keying off the camera would make
          brightness pump as the view rotates.
        </dd>
        <dt>Colour</dt>
        <dd>
          Blackbody spectrum integrated against the CIE 1931 observer, then rescaled
          to <em>unit luminance</em> so the display signal alone sets how bright a
          star reads. Left peak-normalised, luminance ran 0.49 at 2500 K against 0.90
          at 5772 K — a Sun-like star rendered 1.86× more luminous than an O star at
          the same signal, and measured peak brightness came out non-monotonic in
          luminosity.
        </dd>
        <dt>Point-spread function</dt>
        <dd>
          One Moffat profile, <strong>the same width for every star</strong> — a PSF
          belongs to the atmosphere and optics, not the source. Brightness changes
          peak intensity only; a bright star looks larger because more of its wing
          clears the display threshold. Apparent size therefore goes as
          signal<sup>1/2β</sup>.
        </dd>
        <dt>Halo and spikes</dt>
        <dd>
          Both driven by <em>linear</em> flux, not the compressed display signal,
          because scattered light and diffraction are fixed fractions of what entered
          the aperture and know nothing about display. Spikes are Tier 3 only (~0.5%
          of stars) and fixed to the instrument, so they do not rotate with the sky.
        </dd>
        <dt>Filters</dt>
        <dd>
          All 30 bands are <strong>real measured curves</strong> — Johnson–Cousins,
          2MASS, SDSS, Rubin, Gaia, HST and JWST — spanning 271 nm to 7663 nm, a factor
          of 28. There is no Gaussian fallback: UBVRI and JHK were modelled as bells
          until measured curves for them turned up in the same repository as Rubin's,
          and keeping both a curve and a nominal width would be two descriptions of one
          filter. Effective wavelengths are derived from the curves, not copied, and
          reproduce published means within 2% (Rubin r: 622.1 nm vs 622.0).
        </dd>
        <dt>Absolute magnitudes and bolometric corrections</dt>
        <dd>
          On the AB zero point (3631 Jy). The Sun comes out at
          M<sub>V</sub> = 4.87 against a published ≈4.83. BC<sub>V</sub> = M<sub>bol</sub>
          − M<sub>V</sub> then falls out: −3.5 for an O star, −0.12 for the Sun, −1.5 for
          an M4 dwarf — negative at both ends because V misses the ultraviolet of hot
          stars and the infrared of cool ones. It is independent of radius and distance
          by construction, and that is gated, not asserted.
        </dd>
        <dt>Choosing a filter is choosing a dynamic range</dt>
        <dd>
          Measured at build time on the same 10,000 stars the canvas draws, so these
          cannot go stale. The spread collapses by a factor of two from the near-UV to
          the mid-IR — Wien's exponential at one end, Rayleigh–Jeans' linear
          <em>T</em> at the other — and the fraction of the cluster that clears the
          threshold collapses with it.
          <table class="srl__table">
            <thead>
              <tr><th>Band</th><th>λ<sub>eff</sub></th><th>M range</th><th>above threshold</th><th>BC<sub>☉</sub></th></tr>
            </thead>
            <tbody>
              {BAND_SPREAD.map((b) => (
                <tr>
                  <td>{b.label}</td>
                  <td>{b.lambdaEffNm < 1000 ? `${b.lambdaEffNm.toFixed(0)} nm` : `${(b.lambdaEffNm / 1000).toFixed(2)} µm`}</td>
                  <td>{b.range.toFixed(1)} mag</td>
                  <td>{(100 * b.visibleFraction).toFixed(0)}%</td>
                  <td>{b.bcSun.toFixed(2)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </dd>
        <dt>What the blackbody assumption costs</dt>
        <dd>
          Every flux here integrates a <em>Planck function</em> through a real curve, so
          the filter is exact and the spectrum is not. The size of that is measurable
          rather than hand-waved: the Sun's B−V comes out 0.46 against a real 0.65, and
          BC<sub>V</sub> is good to 0.05 mag near solar temperatures but 0.5 mag off for
          an O5V. The missing physics is line blanketing, the Balmer jump and molecular
          bands — and the error grows toward both temperature extremes, exactly where
          those matter most.
        </dd>
      </dl>

      <h3 class="srl__h3">Chosen, and revisable</h3>
      <dl class="srl__dl">
        <dt>Depth (default 19.8 mag below white)</dt>
        <dd>
          An <em>exposure</em>, not a fact. At the default, sub-solar stars — 88.5% of
          the cluster, emitting 0.05% of its V-band light — own ~74% of the summed
          display signal. That is a ~1500× over-representation, and it is a choice:
          the alternative hides most of the cluster. A 0.1 M<sub>☉</sub> star here is
          m<sub>bol</sub> ≈ 20.3 at 400 pc.
        </dd>
        <dt>White percentile (0.995)</dt>
        <dd>
          Kept high <em>against intuition</em>. Lowering it brightens the image but
          <strong>flattens</strong> it: max/median signal moves 4.15 → 2.33 as the
          percentile drops 0.995 → 0.90, because asinh compresses harder at larger
          argument.
        </dd>
        <dt>PSF width 2.2 px, β 3.2, aureole and spike amplitudes</dt>
        <dd>
          Tuned by looking at rendered output. Each has exactly one home in the code
          and the shader imports it, so they cannot drift apart — but they are taste,
          not measurement.
        </dd>
        <dt>Bloom threshold 1.0</dt>
        <dd>
          Display white, so only genuine HDR overflow glares (~50 of 10,000 stars).
          Anything lower would bloom the ordinary field and double-count the halo and
          spikes, which already model why bright stars spread.
        </dd>
        <dt>Mass cut</dt>
        <dd>
          A <em>modelling selection</em>, not an observation. The white point stays
          calibrated on the full population so the views stay comparable, and the page
          says so whenever the cut is active.
        </dd>
      </dl>

      <h3 class="srl__h3">Known limits</h3>
      <ul class="srl__limits">
        <li>
          <strong>No absolute zero point.</strong> Band fluxes are in arbitrary
          self-consistent units, so colour indices work and apparent AB magnitudes do
          not. The depth control reads in magnitudes below <em>this image's</em> white
          point, which is exact but is not a survey limit.
        </li>
        <li>
          <strong>Blackbody spectra.</strong> No line blanketing, no Balmer jump, no
          molecular bands — worst for the cool stars that dominate by number. A real
          filter curve removes one approximation, not this one.
        </li>
        <li><strong>No gas, no extinction, no binaries, no stellar evolution</strong> (t = 0 ZAMS throughout).</li>
        <li>
          <strong>Survey depths below are reference data, not calibration.</strong>
          They are published apparent AB magnitudes; the render is not tied to them.
        </li>
      </ul>

      <h3 class="srl__h3">Survey reference depths</h3>
      {SURVEYS.map((s) => (
        <div class="srl__survey">
          <p class="srl__surveyHead"><strong>{s.label}</strong> — <span class="srl__cite">{s.source}</span></p>
          <table class="srl__table">
            <thead>
              <tr><th>Band</th><th>Single visit</th><th>Coadd</th></tr>
            </thead>
            <tbody>
              {s.depths.map((d) => (
                <tr>
                  <td>{PASSBANDS[d.band]?.label ?? d.band}</td>
                  <td>{d.singleVisit.toFixed(1)}</td>
                  <td>{d.coadd.toFixed(1)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="srl__note">
            {s.keyNumbers.map(([k, v]) => `${k}: ${v}`).join(" · ")}
          </p>
        </div>
      ))}
      <p class="srl__note">
        Rubin's depths here follow the observatory's own Key Numbers page. fluxax
        carries different values (citing Ivezić et al. 2019 and the LSST Science
        Book) — up to 0.6 mag apart, with the coadds differing systematically. Both
        are recorded in <code>core/photometry/surveys.ts</code>; neither is treated as
        wrong. The filter curves themselves are fetched from their primary sources —
        <code>lsst/throughputs</code> and the SVO Filter Profile Service — so nothing
        here depends on my own packages.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import { initStarLab } from "@novascope/viz/starfield/scene";
  import { TRANSFER_IDS, type TransferId } from "@novascope/core/imaging/transfers";

  /*
   * The valid transfer ids, from the same registry that generated the control's options — so the
   * page validates against the list rather than against a copy of it.
   */
  const TRANSFER_ID_SET: ReadonlySet<string> = new Set(TRANSFER_IDS);

  const canvas = document.querySelector<HTMLCanvasElement>("[data-stage]");
  const status = document.querySelector<HTMLElement>("[data-status]");
  const setStatus = (t: string) => {
    if (status) status.textContent = t;
  };

  // ?forceWebGL exercises the WebGPURenderer's WebGL 2 fallback on a machine
  // that would otherwise always take the native path. Development affordance:
  // ~5% of visitors get that backend, so it needs to be checkable on demand.
  const forceWebGL = new URLSearchParams(location.search).has("forceWebGL");

  /*
   * The registry, serialised at build time. Only the two fields the client needs, so the page
   * cannot drift from `core/photometry/instruments` by restating a composite: if a triple changes
   * there, this changes with it.
   */
  const INSTRUMENT_TABLE: Record<string, { label: string; composite: readonly [string, string, string]; brightnessBand: string }> =
    JSON.parse(document.querySelector<HTMLScriptElement>("#srl-instruments")!.textContent!);

  /*
   * Show that the brightness band is DRIVEN when an instrument is selected, rather than leaving an
   * enabled control that silently does nothing.
   *
   * A dead control is worse than an absent one: it invites the conclusion that the band does not
   * matter, which is the opposite of what this page is for. So it is disabled, moved to the
   * instrument's own band, and labelled with why.
   */
  const DEPTH_DEFAULTS: Record<string, number> = JSON.parse(
    document.querySelector<HTMLScriptElement>("#srl-depth-defaults")!.textContent!,
  );

  /*
   * MOVE THE DEPTH SLIDER WHEN THE MODE CHANGES, because the parameter it drives changes with it.
   *
   * In photometric mode `depthMag` sets Lupton's Q, a per-pixel curve; in population mode it sets the
   * per-star asinh softening, so it decides whether the faint majority renders at all. Leaving one
   * position across a mode switch is the regression this fixes: at the photometric default of 8 the
   * median star's signal is 1e-4 against a 0.02 threshold, so only the hot blue stars survived and
   * the whole field read as one colour.
   *
   * Only moved when the slider is still sitting on the OTHER mode's default — otherwise a value the
   * user chose deliberately would be discarded every time they compared modes.
   */
  let lastMode: string | null = null;
  const syncDepthForMode = (): void => {
    const el = document.querySelector<HTMLInputElement>("[data-depth]");
    const id = document.querySelector<HTMLSelectElement>("[data-instrument]")?.value ?? "population";
    const mode = id === "population" ? "population" : "photometric";
    if (!el || mode === lastMode) {
      lastMode = mode;
      return;
    }
    const other = mode === "population" ? "photometric" : "population";
    if (lastMode === null || Number(el.value) === DEPTH_DEFAULTS[other]) {
      el.value = String(DEPTH_DEFAULTS[mode]);
    }
    lastMode = mode;
  };

  const syncBandControl = (): void => {
    const sel = document.querySelector<HTMLSelectElement>("[data-band]");
    const note = document.querySelector<HTMLElement>("[data-band-note]");
    const id = document.querySelector<HTMLSelectElement>("[data-instrument]")?.value ?? "population";
    const inst = INSTRUMENT_TABLE[id];
    if (!sel) return;
    sel.disabled = inst !== undefined;
    if (inst) sel.value = inst.brightnessBand;
    if (note) note.textContent = inst ? `— set by ${inst.label}` : "";
  };

  /** Short band name for the magnitude readout, e.g. "V", "Rubin r". */
  const bandLabelFor = (id: string): string =>
    document.querySelector<HTMLOptionElement>(`[data-band] option[value="${id}"]`)?.textContent ?? id;

  const read = () => {
    // Depth is OMITTED when its control is missing, so core/imaging's tuned default
    // applies. A fallback number here would be a second place the same fact lives,
    // and the previous one silently disagreed with it.
    const depth = document.querySelector<HTMLInputElement>("[data-depth]")?.value;
    const minMass = Number(document.querySelector<HTMLInputElement>("[data-min-mass]")?.value ?? 0);
    const instrumentId = document.querySelector<HTMLSelectElement>("[data-instrument]")?.value ?? "population";
    /*
     * Empty means "follow mode", so it is OMITTED rather than defaulted here — `prepare` owns the
     * per-mode default and a second copy of it would be a second thing to keep true.
     *
     * VALIDATED against the registry rather than cast. The select is generated from `TRANSFERS`,
     * so a bad value can only arise from a stale cached page or a hand-edited DOM — and in that
     * case falling back to "follow mode" is right, while `as never` would have handed `prepare` an
     * id it has no node for.
     */
    const rawScaling = document.querySelector<HTMLSelectElement>("[data-scaling]")?.value ?? "";
    const scaling: TransferId | "" = (TRANSFER_ID_SET.has(rawScaling) ? rawScaling : "") as
      | TransferId
      | "";
    const inst = INSTRUMENT_TABLE[instrumentId];
    /*
     * An instrument supplies BOTH the composite and the brightness band; "population" supplies
     * neither, and that omission is what selects the temperature-ramp path in `prepare`. Passing an
     * invented triple for it would turn "this is a temperature ramp" into a false claim that three
     * named filters recorded something.
     */
    return {
      scheme: document.querySelector<HTMLSelectElement>("[data-scheme]")?.value ?? "true",
      band: inst ? inst.brightnessBand : (document.querySelector<HTMLSelectElement>("[data-band]")?.value ?? "V"),
      ...(inst ? { bandTriple: inst.composite } : {}),
      colorMode: inst ? ("photometric" as const) : ("population" as const),
      ...(scaling === "" ? {} : { scaling }),
      skyLevel: Number(document.querySelector<HTMLInputElement>("[data-sky]")?.value ?? 0),
      bloom: Number(document.querySelector<HTMLInputElement>("[data-bloom]")?.value ?? 0.35),
      ...(depth === undefined ? {} : { depthMag: Number(depth) }),
      exposure: Number(document.querySelector<HTMLInputElement>("[data-exposure]")?.value ?? 1),
      minMass,
    };
  };

  if (canvas) {
    initStarLab(canvas, { forceWebGL, ...read() })
      .then((lab) => {
        const label = lab.backend === "webgpu" ? "WebGPU" : "WebGL 2";
        const depthVal = document.querySelector<HTMLElement>("[data-depth-val]");
        const massVal = document.querySelector<HTMLElement>("[data-minmass-val]");
        const selection = document.querySelector<HTMLElement>("[data-selection]");
        /*
         * THE CHEAP HALF OF THE READOUT — everything derivable from the controls themselves.
         *
         * Split out from `show` so a slider's own number tracks the thumb immediately while the
         * expensive rebuild is coalesced (see `scheduleUpdate`). Reading these from the DOM
         * rather than from `stats` is correct here precisely BECAUSE they are the control's
         * value, not a result: they are what was asked for, and they should update the moment it
         * is asked.
         */
        const showInputs = () => {
          const minMass = Number(
            document.querySelector<HTMLInputElement>("[data-min-mass]")?.value ?? 0,
          );
          const bloomEl = document.querySelector<HTMLInputElement>("[data-bloom]");
          const bloomVal = document.querySelector<HTMLElement>("[data-bloom-val]");
          if (bloomVal && bloomEl) bloomVal.textContent = Number(bloomEl.value).toFixed(2);
          if (massVal) massVal.textContent = minMass > 0 ? `${minMass.toFixed(2)} M☉` : "all";
          // The filtered-population warning is driven by the CUT, not by the star
          // count, so it cannot fall out of step with what is actually drawn.
          if (selection) selection.hidden = minMass <= 0;
        };

        const show = (s: typeof lab.stats) => {
          const pct = ((100 * s.visible) / lab.starCount).toFixed(1);
          showInputs();
          if (depthVal) depthVal.textContent = s.depthMag.toFixed(2);
          const skyVal = document.querySelector<HTMLElement>("[data-sky-val]");
          if (skyVal) {
            skyVal.textContent =
              s.skyLevel > 0 ? `${(100 * s.skyLevel).toFixed(2)}% of white` : "none";
          }
          // "above threshold", not "visible": the count is a property of each
          // star's display signal, and says nothing about whether it is inside
          // the frame. A Plummer sphere has a long tail, so some of these stars
          // are off-screen, and calling them visible would overstate the readout.
          const limit = Number.isFinite(s.faintestVisibleMbol)
            ? ` · faintest m_bol ${s.faintestVisibleMbol.toFixed(1)}`
            : "";
          /*
           * ABSOLUTE magnitude range of the drawn stars, in the selected band's own
           * system. Reported separately from the depth because the two are different
           * kinds of thing: this describes the STARS and does not move when the
           * exposure or the camera does, which is what makes it the teaching number.
           */
          const bandId = read().band;
          const sys = s.absMag.system === "AB" ? `M(${bandLabelFor(bandId)})` : "M_bol";
          const abs = Number.isFinite(s.absMag.brightest)
            ? ` · ${sys} ${s.absMag.brightest.toFixed(1)} to ${s.absMag.faintest.toFixed(1)}`
            : "";
          setStatus(
            `${label}${forceWebGL ? " (forced)" : ""} · ${s.shown.toLocaleString()} of ` +
              `${lab.starCount.toLocaleString()} drawn · ${s.visible.toLocaleString()} above ` +
              `threshold (${pct}%) · ${s.clipping} clipping · depth ${s.depthMag.toFixed(1)} mag${limit}${abs}`,
          );
        };
        show(lab.stats);

        /*
         * ONE REBUILD PER FRAME, COALESCED — and this is a hang fix, not a polish item.
         *
         * `lab.update` re-runs `prepareStarField`, which is 180-425 ms for 10,000 stars (413 ms
         * through a three-band Rubin triple, because it integrates a Planck function through a
         * real filter curve per star per band — roughly 40,000 numerical integrals). That cost is
         * the physics and is not going away.
         *
         * A range input fires `input` CONTINUOUSLY while dragged. Calling `update` straight from
         * the handler therefore queued ~25 seconds of blocking main-thread work per second of
         * dragging, and the backlog grew without bound — the renderer stops responding while
         * holding a live WebGPU context, which is how the tab gets killed rather than merely
         * being slow.
         *
         * Coalescing to a single rAF bounds it: however many events arrive, at most one rebuild
         * runs per frame and the backlog cannot grow. The controls' own numbers still update
         * synchronously via `showInputs`, so the slider stays responsive to the hand while the
         * image catches up — which is the honest split, since those numbers are the REQUEST and
         * the rest of the readout is the RESULT.
         *
         * The right long-term fix is narrower: sky and bloom are pure display uniforms and need
         * no re-prepare at all. That is a change to `StarLab`'s surface rather than to this page,
         * so it is left for the renderer work rather than smuggled in here.
         */
        let pendingUpdate = 0;
        const scheduleUpdate = () => {
          if (pendingUpdate !== 0) return;
          pendingUpdate = requestAnimationFrame(() => {
            pendingUpdate = 0;
            show(lab.update(read()));
          });
        };

        for (const el of document.querySelectorAll<HTMLElement>(
          "[data-instrument],[data-scheme],[data-band],[data-scaling],[data-sky],[data-bloom],[data-depth],[data-exposure],[data-min-mass]",
        )) {
          el.addEventListener("input", () => {
            syncDepthForMode();
            syncBandControl();
            showInputs(); // instant: the control's own value
            scheduleUpdate(); // coalesced: the image and the derived readout
          });
        }
        syncDepthForMode();
        syncBandControl();

        // Motion toggle. The label is DERIVED from the renderer's state so it cannot
        // disagree with it — the starting state comes from prefers-reduced-motion.
        const motionBtn = document.querySelector<HTMLButtonElement>("[data-motion]");
        const motionLabel = document.querySelector<HTMLElement>("[data-motion-label]");
        const syncMotion = () => {
          if (!motionBtn || !motionLabel) return;
          const drifting = lab.drifting;
          motionBtn.setAttribute("aria-pressed", String(!drifting));
          motionLabel.textContent = drifting ? "Pause motion" : "Resume motion";
        };
        motionBtn?.addEventListener("click", () => {
          lab.setDrifting(!lab.drifting);
          syncMotion();
        });
        syncMotion();
        // Expose live state for verification without relying on a screenshot.
        (window as unknown as { starlab?: unknown }).starlab = {
          backend: lab.backend,
          get stats() {
            return lab.stats;
          },
          get info() {
            return lab.info;
          },
          get frames() {
            return lab.frames;
          },
          get drifting() {
            return lab.drifting;
          },
        };
      })
      .catch((err: unknown) => {
        setStatus(`Failed: ${String(err)}`);
      });
  }
</script>

<style>
  .srl { padding-block: var(--space-l) var(--space-3xl); display: grid; gap: var(--space-m); }
  .srl__stage { position: relative; aspect-ratio: 16 / 10; max-block-size: min(70vh, 620px); margin-inline: auto; inline-size: 100%; max-inline-size: calc(min(70vh, 620px) * 1.6); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: #05060a; }
  .srl__canvas { inline-size: 100%; block-size: 100%; display: block; }
  .srl__status { position: absolute; inset-block-end: 0.5rem; inset-inline-start: 0.6rem; margin: 0; font-family: var(--font-mono); font-size: var(--step--3, 0.68rem); color: var(--ink-faint); } /* type-scale-exempt: overlay status */

  /* Always visible, not hover-revealed: a motion control that only appears on hover
     is unreachable on touch and invisible to anyone who needs it most. */
  .srl__motion {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-end: 0.6rem;
    padding: 0.25rem 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink);
    background: color-mix(in oklab, #05060a 72%, transparent);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
  }
  .srl__motion:hover { border-color: var(--spec-teal-bright, #4fd6c4); }
  .srl__motion:focus-visible { outline: 2px solid var(--spec-teal-bright, #4fd6c4); outline-offset: 2px; }

  /* The filtered-population warning. Deliberately prominent: a mass-cut image is
     not the cluster, and the page must not let that pass unstated. */
  .srl__selection {
    margin: 0;
    padding: var(--space-2xs) var(--space-s);
    border-inline-start: 3px solid var(--spec-teal-bright, #4fd6c4);
    border-radius: 4px;
    background: color-mix(in oklab, var(--spec-teal-bright, #4fd6c4) 8%, transparent);
    max-inline-size: var(--width-prose);
    font-size: var(--step--1);
    color: var(--ink-dim);
  }
  .srl__selection[hidden] { display: none; }

  .srl__group { margin-block-start: var(--space-s); }
  .srl__grouph {
    font-family: var(--font-mono); font-size: var(--step--2); font-weight: 500;
    color: var(--ink); margin-block-end: 0.35rem;
  }
  .srl__grouph span { color: var(--ink-faint); font-weight: 400; }
  .srl__grouph span::before { content: "— "; }
  .srl__controls { display: flex; flex-wrap: wrap; gap: var(--space-s) var(--space-m); align-items: end; }
  .srl__ctl { display: grid; gap: 0.2rem; font-family: var(--font-mono); font-size: var(--step--2); color: var(--ink-dim); }
  .srl__ctl select, .srl__ctl input { font-family: inherit; font-size: var(--step--2); accent-color: var(--spec-teal-bright, #4fd6c4); }
  .srl__schemes { display: grid; gap: var(--space-m); padding: var(--space-m); border: 1px solid var(--border); border-radius: 10px; }
  .srl__h { margin: 0; font-size: var(--step-1); }
  .srl__intro { margin: 0; max-inline-size: var(--width-prose); color: var(--ink-dim); font-size: var(--step--1); }
  .srl__scheme { display: grid; gap: 0.4rem; }
  .srl__schemeHead { display: flex; gap: 0.6rem; align-items: baseline; }
  .srl__schemeName { font-size: var(--step-0); font-weight: 600; }
  .srl__kind { font-family: var(--font-mono); font-size: var(--step--2); text-transform: uppercase; letter-spacing: 0.05em; padding: 0.05rem 0.45rem; border-radius: 999px; border: 1px solid var(--border); color: var(--ink-dim); }
  .srl__kind--physical { color: var(--spec-teal-bright, #4fd6c4); border-color: currentColor; }
  .srl__kind--schematic { color: var(--ink-faint); }
  .srl__ramp { display: flex; block-size: 2.75rem; border-radius: 6px; overflow: hidden; border: 1px solid var(--border); }
  .srl__sw { flex: 1; }
  .srl__note { margin: 0; max-inline-size: var(--width-prose); color: var(--ink-dim); font-size: var(--step--2); }
  .srl__axis { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: var(--step--2); color: var(--ink-faint); }

  /* The design record. Internal page, so it is allowed to be long — but it still
     caps its measure, because unbounded body text is unreadable at 1440px. */
  .srl__doc { display: grid; gap: var(--space-m); padding: var(--space-m); border: 1px solid var(--border); border-radius: 10px; }
  .srl__h3 { margin: 0; font-size: var(--step-0); color: var(--spec-teal-bright, #4fd6c4); }
  .srl__dl { margin: 0; display: grid; gap: var(--space-s); max-inline-size: var(--width-prose); }
  .srl__dl dt { font-weight: 600; font-size: var(--step--1); }
  .srl__dl dd { margin: 0.15rem 0 0; font-size: var(--step--1); color: var(--ink-dim); }
  .srl__limits { margin: 0; padding-inline-start: 1.1rem; display: grid; gap: 0.4rem; max-inline-size: var(--width-prose); font-size: var(--step--1); color: var(--ink-dim); }
  .srl__survey { display: grid; gap: 0.3rem; }
  .srl__surveyHead { margin: 0; font-size: var(--step--1); }
  .srl__cite { color: var(--ink-faint); font-size: var(--step--2); }
  /* Wide content scrolls in its own container rather than the page body. */
  .srl__table { display: block; overflow-x: auto; border-collapse: collapse; font-family: var(--font-mono); font-size: var(--step--2); }
  .srl__table th, .srl__table td { padding: 0.15rem 0.8rem 0.15rem 0; text-align: start; }
  .srl__table th { color: var(--ink-faint); font-weight: 500; }
</style>

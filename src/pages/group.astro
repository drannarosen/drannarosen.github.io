---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { siteConfig } from "../lib/site";
import {
  cvProfile,
  currentOf,
  formerOf,
  graduateAdvisees,
  undergraduateAdvisees,
  type Advisee,
} from "../data/cv";
import { publicationByDoi, shortCitation, workUrl } from "../data/allPublications";

/*
 * A project that produced a paper links to it, with the citation read from the
 * synced publication record rather than retyped here. `paperDoi` is the only
 * thing this page states about the paper; if the DOI does not resolve, the
 * entry renders unlinked instead of printing a citation nothing backs.
 */
function paperFor(a: Advisee) {
  const w = a.paperDoi ? publicationByDoi(a.paperDoi) : undefined;
  return w ? { href: workUrl(w), cite: shortCitation(w) } : null;
}

/*
 * The roster is DERIVED from the CV record, never retyped. A second hand-kept
 * list of real people is one where someone graduates, one page is updated and
 * the other goes on calling them a current student — under their own name.
 *
 * SDSU group only (the `group` flag). The students advised at other
 * institutions and everyone advised before SDSU stay on the CV, which this
 * page links to as the complete record.
 */
const roster: { title: string; people: Advisee[] }[] = [
  { title: "Graduate students", people: currentOf(graduateAdvisees) },
  { title: "Undergraduates", people: currentOf(undergraduateAdvisees) },
];
const alumni: { title: string; people: Advisee[] }[] = [
  { title: "Graduate", people: formerOf(graduateAdvisees) },
  { title: "Undergraduate", people: formerOf(undergraduateAdvisees) },
];
/* Empty groups do not render: a heading with nothing under it reads as a bug
   rather than as the fact that there is nobody in that category right now. */
const filled = <T extends { people: Advisee[] }>(g: T[]): T[] =>
  g.filter((s) => s.people.length > 0);

/*
 * /group — for SDSU Astronomy students deciding whether to work with me.
 *
 * Written as a THRESHOLD, not an advertisement. The previous version stated no
 * eligibility and ended in a bare "Email me" button — a zero-friction
 * invitation to everyone, which drew mail from people I cannot advise. Two
 * things filter now, neither of them a scolding: eligibility stated plainly in
 * the lede, and an email that asks for three specifics only a reader of this
 * page can supply.
 *
 * The links out to /explore, /software and the package docs are part of that
 * mechanism rather than decoration: they give a reader something to DO before
 * writing, which is what separates a prepared student from a mass email.
 */

/** Prefilled so the tag is already there for anyone who follows the page. */
const mailto = `mailto:${siteConfig.email}?subject=${encodeURIComponent("SDSU-ASTRO: ")}`;
---

<BaseLayout
  title="Group — Anna Rosen, Ph.D."
  description="The SDSU students working with me on differentiable models of stars and star clusters, what they built, and where they went next."
  path="/group"
>
  {/* "A question you can actually finish" used to be the H1. It is an argument
      about the WORK — modular software makes a project self-contained — so it
      now heads the section that makes that argument, rather than standing above
      a roster where it read as a recruiting slogan. */}
  <PageHeader eyebrow="Group" title="Students, and what they built">
    {/* Eligibility stays in the lede — it is the first filter, and it has to be
        read before anything else. What follows it used to be the pitch ("so you
        can own a real project end to end"); that argument now lives in its own
        section below the people, where a reader meets it after the evidence
        rather than instead of it. */}
    <Fragment slot="lede">
      I advise <strong>SDSU Astronomy undergraduate and Master's students</strong>,
      building differentiable models of stars and star clusters. Below: who is in
      the group, what they worked on, and where they went next.
    </Fragment>
  </PageHeader>

  <section class="wrap gr-section" aria-labelledby="people-heading">
    <h2 id="people-heading" class="gr-title">The group</h2>
    {
      filled(roster).map((s) => (
        <>
          <h3 class="gr-sub">{s.title}</h3>
          <ul class="gr-people" role="list">
            {s.people.map((p) => (
              <li class="gr-person">
                <span class="gr-person__name">{p.name}</span>
                <span class="gr-person__meta">{p.affiliation} · {p.date}</span>
                {p.project && (
                  <span class="gr-person__project">
                    {paperFor(p)?.href ? (
                      <a href={paperFor(p)!.href!} rel="noopener">{p.project}</a>
                    ) : (
                      p.project
                    )}
                    {paperFor(p)?.cite && (
                      <span class="gr-person__cite">{paperFor(p)!.cite}</span>
                    )}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </>
      ))
    }

    <h3 class="gr-sub">Alumni</h3>
    {
      filled(alumni).map((s) => (
        <>
          <p class="gr-alumni-label">{s.title}</p>
          <ul class="gr-people" role="list">
            {s.people.map((p) => (
              <li class="gr-person">
                <span class="gr-person__name">{p.name}</span>
                <span class="gr-person__meta">{p.affiliation} · {p.date}</span>
                {p.project && (
                  <span class="gr-person__project">
                    {paperFor(p)?.href ? (
                      <a href={paperFor(p)!.href!} rel="noopener">{p.project}</a>
                    ) : (
                      p.project
                    )}
                    {paperFor(p)?.cite && (
                      <span class="gr-person__cite">{paperFor(p)!.cite}</span>
                    )}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </>
      ))
    }

    <p class="gr-fullrecord">
      This is the SDSU group. For everyone I've advised — including students at
      other institutions and before SDSU — see <a href="/cv#advising-and-mentoring"
        >the full advising record</a
      >.
    </p>
  </section>

  <section class="wrap gr-section" aria-labelledby="work-heading">
    <h2 id="work-heading" class="gr-title">A question you can actually finish</h2>
    <div class="prose gr-prose">
      <p>
        The Jaxstro ecosystem is deliberately modular. Because each package owns
        one scientific stage and exposes clean, differentiable interfaces, a
        single well-scoped question — a new IMF prescription, a dynamical
        benchmark, a survey systematic, an identifiability test — becomes a
        self-contained project with a beginning and an end.
      </p>
      <p>
        That is the point: many compact, finishable contributions rather than a
        few monolithic ones, on tools you can actually read.
      </p>
      {/* Explicit {" "} before every inline element that follows a line break:
          Astro collapses that whitespace, which silently produced
          "thejaxstro andprogenaxdocumentation" here. */}
      <p class="gr-start">
        <strong>Where to start looking:</strong>{" "}
        <a href="/explore">the explorables</a> to see the models running,{" "}
        <a href="/software">the software</a> for what each package does, and the{" "}
        <a href="https://jaxstro.github.io/jaxstro/" rel="noopener">jaxstro</a> and{" "}
        <a href="https://jaxstro.github.io/progenax/" rel="noopener">progenax</a>{" "}
        documentation if you want to read the interfaces themselves.
      </p>
    </div>
  </section>

  <section class="wrap gr-section" aria-labelledby="interests-heading">
    <h2 id="interests-heading" class="gr-title">Research interests</h2>
    <ul class="gr-tags" role="list">
      {cvProfile.interests.map((i) => <li class="gr-tag">{i}</li>)}
    </ul>
  </section>

  <section class="wrap gr-section" aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="gr-title">Recommended skills</h2>
    <div class="prose gr-prose">
      <p>
        None of this is a checklist you must clear before talking to me. It is
        what makes the first month go well.
      </p>
    </div>
    <ul class="gr-skills" role="list">
      <li>
        You can <strong>write and debug your own Python</strong> — not only run
        someone else's notebook.
      </li>
      <li>
        You are comfortable thinking in arrays: NumPy, or the willingness to learn
        it quickly.
      </li>
      <li>A terminal and <code>git</code>, or no fear of picking them up.</li>
      <li>
        <span class="gr-skills__soft">Helpful, not required:</span> modular
        programming, JAX, matplotlib, LaTeX, any experience on a cluster.
      </li>
    </ul>
    <div class="prose gr-prose">
      {/* Deliberately no "if you took course X you're ready" line: naming
          specific courses ties the page to a teaching schedule that changes,
          and the COMP courses are rarely taken by Astronomy students anyway. */}
      <p>
        You do <strong>not</strong> need prior research experience, and you do not
        need astronomy and physics beyond the introductory sequence. If you have written
        code for a class or a project and had to make it actually work, that is
        the relevant experience.
      </p>
    </div>
  </section>

  <section class="wrap gr-section" aria-labelledby="email-heading">
    <h2 id="email-heading" class="gr-title">Before you email me</h2>
    {/* The three asks are about the PAST, not about proposed research.
        They used to ask which question you'd work on and one thing you'd want
        to try — both speculative, and a speculative prompt is exactly what a
        language model answers fluently, so the ask selected for whoever was
        willing to paste something in. What someone has already done is
        concrete, personal, and cannot be generated for them, and it filters
        just as hard without inviting anyone to invent a proposal. */}
    <div class="prose gr-prose">
      <p>
        Have a look around first, then tell me three things. Two or three sentences
        each is plenty. I am not looking for a research proposal — you are not
        expected to have one yet — just for a sense of who you are and what caught
        your attention.
      </p>
    </div>
    <ol class="gr-ask" role="list">
      <li>
        <strong>What you're curious about</strong> — a topic, a class that clicked,
        something you read here or elsewhere. It does not have to be a research
        question.
      </li>
      <li>
        <strong>Where you are</strong>: your year, your major, and which of my
        courses you've taken, if any.
      </li>
      <li>
        <strong>Something you've built or debugged</strong> — a class project, a
        script, anything you had to make actually work. It does not have to be
        astronomy, and it does not have to have gone well.
      </li>
    </ol>
    <p class="gr-tag-note">
      Please put <code>SDSU-ASTRO</code> in the subject line.
    </p>
    <p class="gr-cta">
      <a class="gr-btn" href={mailto}>Email me →</a>
    </p>
  </section>

  <section class="wrap gr-section" aria-labelledby="collab-heading">
    <h2 id="collab-heading" class="gr-title">Potential collaborators</h2>
    <div class="prose gr-prose">
      <p>
        The software is open and built to be extended. If you work on star
        clusters, stellar populations, or survey inference and want to run new
        models, test a prescription against your own, or design an observing
        program around what these models predict, I'd like to hear from you — the
        three items above don't apply.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .gr-section {
    padding-block: var(--space-l) var(--space-xl);
  }
  .gr-title {
    font-size: var(--step-2);
    padding-block-end: var(--space-2xs);
    margin-block-end: var(--space-m);
    border-block-end: 1px solid var(--border);
  }
  .gr-prose p {
    color: var(--ink-soft);
    margin-block-end: var(--space-s);
  }

  .gr-sub {
    font-size: var(--step-0);
    color: var(--ink);
    margin-block: var(--space-m) var(--space-2xs);
  }
  .gr-alumni-label {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ink-faint);
    margin-block: var(--space-s) var(--space-2xs);
  }
  .gr-people {
    display: grid;
    gap: var(--space-s);
    margin: 0;
    padding: 0;
  }
  .gr-person {
    display: grid;
    gap: 2px;
    padding-inline-start: var(--space-s);
    border-inline-start: 2px solid var(--border);
  }
  .gr-person__name {
    color: var(--ink);
    font-size: var(--step-0);
  }
  .gr-person__meta {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-dim);
  }
  .gr-person__project {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-soft);
    max-inline-size: var(--width-prose);
    line-height: 1.5;
  }
  /* The citation sits under the title it belongs to rather than running on. */
  .gr-person__cite {
    display: block;
    margin-block-start: 2px;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-faint);
  }
  .gr-fullrecord {
    margin-block-start: var(--space-l);
    font-size: var(--step--1);
    color: var(--ink-dim);
    max-inline-size: var(--width-prose);
  }
  .gr-prose code,
  .gr-skills code,
  .gr-tag-note code {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--spec-teal-bright);
  }
  .gr-start {
    padding-block-start: var(--space-2xs);
  }

  .gr-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
  }
  .gr-tag {
    padding: var(--space-3xs) var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-soft);
    background: var(--bg-deep);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  /* Both lists keep the prose measure, so each section reads as one argument
     rather than a form to fill in. */
  .gr-skills,
  .gr-ask {
    max-inline-size: var(--width-prose);
    display: grid;
    gap: var(--space-2xs);
    color: var(--ink-soft);
    margin-block-end: var(--space-m);
  }
  .gr-skills {
    list-style: none;
    padding-inline-start: 0;
  }
  .gr-skills li {
    position: relative;
    padding-inline-start: var(--space-m);
  }
  .gr-skills li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.62em;
    inline-size: 6px;
    block-size: 6px;
    border-radius: 999px;
    background: var(--spec-teal-bright);
  }
  .gr-skills__soft {
    color: var(--ink-dim);
  }
  .gr-ask {
    padding-inline-start: var(--space-m);
  }
  .gr-ask li::marker {
    color: var(--spec-cyan);
    font-family: var(--font-mono);
  }
  .gr-ask strong,
  .gr-skills strong {
    color: var(--ink);
  }

  .gr-tag-note {
    max-inline-size: var(--width-prose);
    color: var(--ink-soft);
  }

  .gr-cta {
    margin-block-start: var(--space-m);
  }
  .gr-btn {
    display: inline-block;
    padding: var(--space-2xs) var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .gr-btn:hover {
    border-color: var(--spec-teal-bright);
    color: var(--spec-teal-bright);
  }
</style>

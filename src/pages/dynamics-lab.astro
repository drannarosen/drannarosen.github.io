---
/*
 * dynamics-lab.astro — an instrument for looking at integrators, not a published page.
 *
 * noindex and unlinked, in the mould of /star-render-lab.
 *
 * ── WHAT CHANGED, AND WHY THE CHART IS THE POINT ──
 *
 * The first version showed the energy drift as ONE NUMBER, and that number could not express the
 * thing the page is actually about. A symplectic map's error is bounded and oscillatory; an
 * asymmetric predictor-corrector's is secular. Those are two SHAPES, not two magnitudes — at any
 * single instant the secular one may be the smaller of the two, and a reader watching one digit
 * would conclude the wrong scheme was better. Measured on the two-body fixture at 128 steps per
 * orbit: symmetric holds 2.4e-5 whether the run is 4 orbits or 256, while asymmetric climbs
 * 2.3e-4 -> 1.2e-2. You cannot see a factor of 51 accumulate by staring at a digit.
 *
 * So the strip chart is not decoration. `monitor.history` was already retaining 600 samples and
 * nothing plotted them.
 *
 * ── AND WHY SCENARIOS ──
 *
 * The softening slider let a reader build configurations no scheme on offer could integrate, and
 * the page presented the results anyway. `core/dynamics/scenarios.ts` now owns which schemes are
 * honest for which configuration, and its `limits` string is rendered rather than paraphrased.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { SCENARIOS } from "@novascope/core/dynamics";
---

<BaseLayout
  title="Dynamics lab — Anna Rosen"
  description="Development surface: N-body integrators, time symmetry, and what conservation costs."
  path="/dynamics-lab"
  noindex
>
  <PageHeader
    eyebrow="Development surface · not linked"
    title="How you choose the timestep is the physics"
    lede="Four integrators on identical initial conditions. The energy trace below the field is the subject — not how large the error is, but whether it grows."
  />

  <div class="wrap-wide lab">
    <div class="lab__stage">
      <canvas
        class="lab__canvas"
        data-canvas
        aria-label="A gravitational N-body configuration, integrated in real time."></canvas>
      <canvas
        class="lab__chart"
        data-chart
        aria-label="Energy drift against time, on a logarithmic scale."></canvas>
      <p class="lab__note" data-status aria-live="polite">Starting…</p>
    </div>

    <div class="lab__side flow">
      <fieldset class="ctl">
        <legend>Scenario</legend>
        {
          SCENARIOS.map((s, i) => (
            <label class="ctl__row">
              <input type="radio" name="scenario" value={s.id} checked={i === 0} />
              <span><strong>{s.label}</strong></span>
            </label>
          ))
        }
        <p class="ctl__hint" data-blurb></p>
      </fieldset>

      <fieldset class="ctl">
        <legend>Integrator</legend>
        <div data-schemes></div>
        <p class="ctl__hint" data-scheme-note></p>
      </fieldset>

      <fieldset class="ctl" data-param="eccentricity">
        <legend>Eccentricity <span class="ctl__val" data-ecc-label>0.50</span></legend>
        <input type="range" data-ecc min="0" max="0.9" step="0.05" value="0.5" />
      </fieldset>

      <fieldset class="ctl" data-param="n">
        <legend>Stars <span class="ctl__val" data-n-label>200</span></legend>
        <input type="range" data-n min="20" max="512" step="20" value="200" />
      </fieldset>

      <fieldset class="ctl" data-param="softening">
        <legend>Softening <span class="ctl__val" data-eps-label>0.5 d</span></legend>
        <input type="range" data-eps min="0" max="6" step="1" value="0" />
        <p class="ctl__hint">
          ε = fraction · r<sub>h</sub> · N<sup>−1/3</sup>, where d ≡ r<sub>h</sub>N<sup>−1/3</sup>.
          The last stop is exactly zero.
        </p>
      </fieldset>

      <div class="ctl ctl--buttons">
        <button type="button" data-play aria-pressed="true">Pause</button>
        <button type="button" data-reverse>Reverse</button>
        <button type="button" data-reset>Reset</button>
      </div>

      <dl class="meter" data-meter>
        <div class="meter__row"><dt>|ΔE/E|</dt><dd data-de>—</dd></div>
        <div class="meter__row"><dt>worst |ΔE/E|</dt><dd data-dew>—</dd></div>
        <div class="meter__row"><dt>Q = T/|U|</dt><dd data-q>—</dd></div>
        <div class="meter__row"><dt>elapsed</dt><dd data-tc>—</dd></div>
        <div class="meter__row"><dt>bound</dt><dd data-bound>—</dd></div>
        <div class="meter__row"><dt>force evals / frame</dt><dd data-cost>—</dd></div>
      </dl>
      <p class="meter__verdict" data-health>—</p>
      <p class="ctl__hint" data-limits></p>
    </div>
  </div>

  <div class="wrap">
    <div class="prose flow">
      <h2>What the trace shows that the number cannot</h2>
      <p>
        Pick <strong>Two-body orbit</strong> and watch the energy trace under the field. On
        <strong>Symmetric</strong> it settles into a band and stays there however long you run.
        Switch to <strong>Hermite</strong> — the same order, the same corrector, the same
        softening — and the trace climbs. Neither scheme is less accurate per step. The
        difference is entirely in <em>how the step size is chosen</em>.
      </p>
      <p>
        Hermite sizes its step from the state it is leaving, <em>dt</em> = h(ξ₀). A map whose
        step depends on only one of its two endpoints is not invariant under reversing time, and
        so has no reason to give the energy back. The symmetric scheme takes
        <em>dt</em> = ½[h(ξ₀) + h(ξ₁)] — a rule that reads the same forwards and backwards — and
        pays for it by having to solve a fixed point, because ξ₁ depends on the step that depends
        on ξ₁.
      </p>
      <p>
        Press <strong>Reverse</strong> on the two-body orbit. The velocities flip and the run
        retraces itself; the symmetric scheme returns to where it began, and the others do not.
        That is the property, and everything else on this page is downstream of it.
      </p>

      <h2>Measured</h2>
      <table class="tbl">
        <caption>Peak |ΔE/E| on the eccentric two-body fixture, 128 steps per orbit.</caption>
        <thead>
          <tr
            ><th scope="col">orbits</th><th scope="col">symmetric</th><th scope="col"
              >asymmetric</th
            ></tr
          >
        </thead>
        <tbody>
          <tr><th scope="row">4</th><td>2.38e−5</td><td>2.28e−4</td></tr>
          <tr><th scope="row">16</th><td>2.39e−5</td><td>7.77e−4</td></tr>
          <tr><th scope="row">64</th><td>2.43e−5</td><td>2.96e−3</td></tr>
          <tr><th scope="row">256</th><td>2.56e−5</td><td>1.16e−2</td></tr>
        </tbody>
      </table>
      <p>
        Flat to 7% against a factor of 51. The cost is real and runs the other way: one symmetric
        step is eight force evaluations against one, so on a 200-star cluster it conserves five
        orders better and takes 39× the work — 147 806 force evaluations per crossing time
        against 3758, and 222 seconds of wall clock against 7. That is why it is the default for
        two bodies and an opt-in for a cluster, and why the scenario decides rather than the
        reader.
      </p>
      <p>
        Softening, on the cluster, is scaffolding for the <em>fixed-step</em> schemes rather than
        physics. Take it to zero and watch FSI4 and the leapfrog come apart while the two
        adaptive schemes carry on: an adaptive step is the mechanism that resolves a close pair,
        and softening is the substitute a fixed step is forced to use instead.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    SCENARIOS,
    chooseIntegrator,
    createConservationMonitor,
    measure,
    scenario,
    softeningForCluster,
    stepsForSoftening,
    type ConservationMonitor,
    type ForceModel,
    type Integrator,
    type Scenario,
    type ScenarioBuild,
    type ScenarioId,
    type Scheme,
    type Vec3Array,
  } from "@novascope/core/dynamics";

  const el = <T extends Element>(sel: string): T => {
    const found = document.querySelector<T>(sel);
    if (!found) throw new Error(`dynamics-lab: ${sel} missing`);
    return found;
  };

  const canvas = el<HTMLCanvasElement>("[data-canvas]");
  const chart = el<HTMLCanvasElement>("[data-chart]");
  const status = el<HTMLElement>("[data-status]");
  const ctx = canvas.getContext("2d");
  const cctx = chart.getContext("2d");
  if (!ctx || !cctx) throw new Error("dynamics-lab: no 2d context");
  const field: CanvasRenderingContext2D = ctx;
  const trace: CanvasRenderingContext2D = cctx;

  const playBtn = el<HTMLButtonElement>("[data-play]");
  const reverseBtn = el<HTMLButtonElement>("[data-reverse]");
  const resetBtn = el<HTMLButtonElement>("[data-reset]");
  const eccInput = el<HTMLInputElement>("[data-ecc]");
  const nInput = el<HTMLInputElement>("[data-n]");
  const epsInput = el<HTMLInputElement>("[data-eps]");
  const schemeBox = el<HTMLElement>("[data-schemes]");

  /* The last stop is EXACTLY zero, not a small number. On the cluster that is the configuration
     that separates the two adaptive schemes from the two fixed-step ones, so it has to be
     reachable — a slider that stopped just short would hide the result. */
  const FRACTIONS = [0.5, 0.25, 0.125, 0.0625, 0.03125, 0.015625, 0];
  const FRAMES_PER_UNIT = 64;

  interface Run {
    build: ScenarioBuild;
    scenario: Scenario;
    integrator: Integrator;
    monitor: ConservationMonitor;
    scheme: Scheme;
    evals: () => number;
    stepsPerUnit: number | null;
    /** Recent positions for the trail, only for configurations small enough to read. */
    trail: number[][];
  }

  /** Wraps a force model to count evaluations — the cost readout, without touching the core. */
  function counted(force: ForceModel): { force: ForceModel; evals: () => number } {
    let n = 0;
    const bump = () => {
      n++;
    };
    return {
      evals: () => n,
      force: {
        id: force.id,
        accelerations: (p, m, a, t) => {
          bump();
          force.accelerations(p, m, a, t);
        },
        potentialEnergy: (p, m, t) => force.potentialEnergy(p, m, t),
        potentials: (p, m, o, t) => force.potentials(p, m, o, t),
        forceGradient: force.forceGradient
          ? (p, m, a, g, t) => {
              bump();
              force.forceGradient!(p, m, a, g, t);
            }
          : undefined,
        accelerationsAndJerk: force.accelerationsAndJerk
          ? (p: Vec3Array, v: Vec3Array, m: Float64Array, a: Vec3Array, j: Vec3Array, t: number) => {
              bump();
              force.accelerationsAndJerk!(p, v, m, a, j, t);
            }
          : undefined,
      },
    };
  }

  let run: Run | null = null;
  let running = true;
  let lastEvals = 0;
  let evalsPerFrame = 0;

  const currentScenarioId = (): ScenarioId =>
    (document.querySelector<HTMLInputElement>('input[name="scenario"]:checked')?.value ??
      "two-body") as ScenarioId;

  const currentScheme = (): Scheme | null =>
    (document.querySelector<HTMLInputElement>('input[name="scheme"]:checked')?.value ??
      null) as Scheme | null;

  /** Rebuild the integrator radios for the scenario — a scenario OWNS what is honest for it. */
  function renderSchemes(s: Scenario, keep: Scheme | null): void {
    // `keep` is only ever non-null when the scenario did NOT change — see reset().
    const chosen = keep && s.schemes.includes(keep) ? keep : s.defaultScheme;
    schemeBox.innerHTML = s.schemes
      .map(
        (id) =>
          `<label class="ctl__row"><input type="radio" name="scheme" value="${id}"${
            id === chosen ? " checked" : ""
          } /><span>${SCHEME_LABEL[id]}</span></label>`,
      )
      .join("");
    for (const r of schemeBox.querySelectorAll('input[name="scheme"]')) {
      r.addEventListener("change", () => reset(true));
    }
  }

  const SCHEME_LABEL: Record<Scheme, string> = {
    symmetric: "<strong>Symmetric</strong> — 4th-order, time-symmetric <em>and</em> adaptive",
    fsi4: "<strong>FSI4</strong> — 4th-order forward symplectic, fixed step",
    hermite: "<strong>Hermite</strong> — 4th-order adaptive, <em>not</em> time-symmetric",
    leapfrog: "<strong>Leapfrog</strong> — 2nd-order symplectic, fixed step",
  };

  const SCHEME_NOTE: Record<Scheme, string> = {
    symmetric: "dt = ½[h(ξ₀) + h(ξ₁)] — reads the same backwards. 8 force evals per step.",
    fsi4: "Bounded energy error, but no way to shorten its step for a close pair.",
    hermite: "dt = h(ξ₀) — asymmetric, so its energy error is secular. 1 eval per step.",
    leapfrog: "The second-order baseline. Present so 'fourth order' means something.",
  };

  /** Which parameter controls this scenario actually has. */
  const PARAMS: Record<ScenarioId, string[]> = {
    "two-body": ["eccentricity"],
    cluster: ["n", "softening"],
    "binary-in-cluster": ["n"],
  };

  function build(): Run {
    const s = scenario(currentScenarioId());
    const scheme = currentScheme() ?? s.defaultScheme;
    const fraction = FRACTIONS[Number(epsInput.value)];
    const built = s.build({
      eccentricity: Number(eccInput.value),
      n: Number(nInput.value),
      softeningFraction: fraction,
    });

    const { force, evals } = counted(built.force);
    const adaptive = scheme === "hermite" || scheme === "symmetric";
    const requested = s.id === "two-body" ? 256 : stepsForSoftening(Math.max(fraction, 1e-3));
    const maxStep = built.timeUnit / requested;
    const picked = chooseIntegrator(built.state, force, {
      prefer: scheme,
      maxStep: adaptive ? built.timeUnit / FRAMES_PER_UNIT : maxStep,
      adaptive,
    });

    return {
      build: built,
      scenario: s,
      integrator: picked.integrator,
      monitor: createConservationMonitor(picked.integrator),
      scheme: picked.scheme,
      evals,
      /* DERIVED, not echoed: a frame subdivides by ceil(dt/maxStep), an integer, so the rate a
         run actually takes is the request rounded up to a multiple of the frame rate. */
      stepsPerUnit: adaptive
        ? null
        : Math.ceil(requested / FRAMES_PER_UNIT) * FRAMES_PER_UNIT,
      trail: [],
    };
  }

  function syncControls(s: Scenario): void {
    const shown = PARAMS[s.id];
    for (const box of document.querySelectorAll<HTMLElement>("[data-param]")) {
      box.hidden = !shown.includes(box.dataset.param ?? "");
    }
    el<HTMLElement>("[data-blurb]").textContent = s.blurb;
    el<HTMLElement>("[data-limits]").textContent = `Limits: ${s.limits}`;
    reverseBtn.hidden = s.id !== "two-body";
  }

  /**
   * @param keepScheme  true when only a parameter moved, so the radios are already correct.
   *                    false when the SCENARIO changed, which drops back to that scenario's own
   *                    default rather than carrying the previous choice across.
   *
   * Carrying it across was the first version's behaviour and it was a real trap: `symmetric` is
   * offered by every scenario, so choosing it on the two-body orbit — where it is free — left it
   * selected on the cluster, where it costs 39x as much and drops the page to a fraction of a
   * frame per second. A scenario states its own default precisely because the honest choice is
   * different in each, and silently inheriting one made that statement decorative.
   */
  function reset(keepScheme = false): void {
    const s = scenario(currentScenarioId());
    if (!keepScheme) renderSchemes(s, null);
    syncControls(s);
    run = build();
    lastEvals = 0;
    evalsPerFrame = 0;

    const fraction = FRACTIONS[Number(epsInput.value)];
    el<HTMLElement>("[data-ecc-label]").textContent = Number(eccInput.value).toFixed(2);
    el<HTMLElement>("[data-n-label]").textContent = String(run.build.state.n);
    el<HTMLElement>("[data-eps-label]").textContent = fraction === 0 ? "0 (exact)" : `${fraction} d`;
    el<HTMLElement>("[data-scheme-note]").textContent = SCHEME_NOTE[run.scheme];

    const rate =
      run.stepsPerUnit === null
        ? "adaptive step"
        : `${run.stepsPerUnit} steps/${run.build.timeUnitLabel}`;
    /* The RUNNING scheme, from chooseIntegrator's own report rather than from the radio that was
       clicked — those can differ, and echoing the request is the confidently-wrong readout this
       codebase keeps designing against. */
    status.textContent =
      `${run.scheme} · ${run.build.state.n} bodies · ${run.build.softeningNote}` +
      ` · 1 ${run.build.timeUnitLabel} = ${run.build.timeUnit.toFixed(4)} Myr · ${rate}`;

    draw();
    drawChart();
    readout();
  }

  const fmt = (x: number): string => (x === 0 ? "0" : x.toExponential(2));

  function draw(): void {
    if (!run) return;
    const { width: w, height: h } = canvas;
    const dpr = w / Math.max(1, canvas.getBoundingClientRect().width);
    field.clearRect(0, 0, w, h);
    const view = run.build.viewPc;
    const scale = Math.min(w, h) / (2 * view);
    const { pos, mass, n } = run.build.state;

    // Trails, only where they can be read: an orbit is a shape, a 200-star field is a smear.
    if (n <= 8) {
      run.trail.push(Array.from(pos.slice(0, n * 3)));
      if (run.trail.length > 400) run.trail.shift();
      field.lineWidth = dpr;
      for (let i = 0; i < n; i++) {
        field.beginPath();
        for (let k = 0; k < run.trail.length; k++) {
          const x = w / 2 + run.trail[k][i * 3] * scale;
          const y = h / 2 + run.trail[k][i * 3 + 1] * scale;
          if (k === 0) field.moveTo(x, y);
          else field.lineTo(x, y);
        }
        field.strokeStyle = "rgba(79, 214, 196, 0.30)";
        field.stroke();
      }
    }

    for (let i = 0; i < n; i++) {
      const x = w / 2 + pos[i * 3] * scale;
      const y = h / 2 + pos[i * 3 + 1] * scale;
      /* Radius from mass, cube root so AREA scales with mass^(2/3) and a massive star does not
         blot out its neighbours. Scaled by dpr because the canvas is in DEVICE pixels, and by
         the SCENARIO's markerScale because the right marker in a 200-star field is invisible
         when there are only two bodies. */
      const r = Math.max(0.6, Math.cbrt(mass[i]) * 1.4) * run.build.markerScale * dpr;
      const z = pos[i * 3 + 2];
      const a = Math.max(0.35, Math.min(1, 0.8 + z / (2 * view)));
      field.fillStyle = `rgba(232, 240, 248, ${a})`;
      field.beginPath();
      field.arc(x, y, r, 0, Math.PI * 2);
      field.fill();
    }
  }

  /**
   * The energy trace: log10 |dE/E| against elapsed time.
   *
   * LOGARITHMIC, because the quantity spans ten orders across the schemes on offer and a linear
   * axis would render every well-behaved run as an identical flat line at zero — which is
   * exactly the distinction the chart exists to draw.
   *
   * The axis is FIXED at 1e-16..1e0 rather than fitted to the data. An autoscaled axis rescales
   * itself as the trace grows, so a secular climb would be redrawn as a stationary line: the
   * chart would erase the one thing it is for.
   */
  function drawChart(): void {
    if (!run) return;
    const { width: w, height: h } = chart;
    const dpr = w / Math.max(1, chart.getBoundingClientRect().width);
    trace.clearRect(0, 0, w, h);
    const LO = -16;
    const HI = 0;
    const padL = 34 * dpr;
    const py = (log: number): number =>
      h - 6 * dpr - ((log - LO) / (HI - LO)) * (h - 18 * dpr);

    trace.font = `${9 * dpr}px ui-monospace, monospace`;
    trace.strokeStyle = "rgba(255,255,255,0.10)";
    trace.fillStyle = "rgba(255,255,255,0.40)";
    trace.lineWidth = dpr;
    for (let e = LO; e <= HI; e += 4) {
      trace.beginPath();
      trace.moveTo(padL, py(e));
      trace.lineTo(w, py(e));
      trace.stroke();
      trace.fillText(`1e${e}`, 2 * dpr, py(e) + 3 * dpr);
    }

    // The health line: monitor.ts's own tolerance, drawn where it actually sits.
    trace.strokeStyle = "rgba(226, 122, 122, 0.55)";
    trace.setLineDash([4 * dpr, 4 * dpr]);
    trace.beginPath();
    trace.moveTo(padL, py(Math.log10(run.monitor.energyTolerance)));
    trace.lineTo(w, py(Math.log10(run.monitor.energyTolerance)));
    trace.stroke();
    trace.setLineDash([]);

    const hist = run.monitor.history;
    if (hist.length < 2) return;
    /* The x axis is the SCENARIO's clock (s.t / timeUnit), for the same reason the elapsed
       readout is — `sample.tCross` normalises by the monitor's own crossing time, which is not
       an orbit. `history` is capped at 600 samples and shifts, so this window is a ROLLING one:
       the axis label says so rather than implying the trace starts at t = 0. */
    const unit = run.build.timeUnit;
    const t0 = hist[0].t / unit;
    const t1 = hist[hist.length - 1].t / unit;
    const span = Math.max(1e-12, t1 - t0);
    const px = (tt: number): number => padL + ((tt - t0) / span) * (w - padL - 2 * dpr);

    trace.strokeStyle = "#4fd6c4";
    trace.lineWidth = 1.5 * dpr;
    trace.beginPath();
    let pen = false;
    for (const s of hist) {
      if (!(s.energyDrift > 0)) continue;
      const y = py(Math.max(LO, Math.min(HI, Math.log10(s.energyDrift))));
      const x = px(s.t / unit);
      if (pen) trace.lineTo(x, y);
      else trace.moveTo(x, y);
      pen = true;
    }
    trace.stroke();

    trace.fillStyle = "rgba(255,255,255,0.40)";
    trace.fillText(
      `|ΔE/E| · ${t0.toFixed(1)}–${t1.toFixed(1)} ${run.build.timeUnitLabel}`,
      padL + 4 * dpr,
      11 * dpr,
    );
  }

  function readout(): void {
    if (!run) return;
    const s = run.monitor.sample();
    const d = measure(run.build.state, run.build.force);
    el<HTMLElement>("[data-de]").textContent = fmt(s.energyDrift);
    el<HTMLElement>("[data-dew]").textContent = fmt(run.monitor.worst.energy);
    el<HTMLElement>("[data-q]").textContent = s.virialRatio.toFixed(3);
    /* Elapsed in the SCENARIO's clock, not the monitor's.
       `sample.tCross` is normalised by `monitor`'s own crossingTime(), which is the right unit
       for a cluster and the WRONG one for a two-body orbit: measured, 40 orbits of the default
       pair reported as 193.5, because the pair's crossing time is 4.8x shorter than its period.
       A number that is off by a factor of five under a label that names the unit is precisely
       the confidently-wrong readout this page exists to argue against. */
    el<HTMLElement>("[data-tc]").textContent =
      `${(s.t / run.build.timeUnit).toFixed(2)} ${run.build.timeUnitLabel}`;
    el<HTMLElement>("[data-bound]").textContent = `${(d.boundMassFraction * 100).toFixed(1)}%`;
    el<HTMLElement>("[data-cost]").textContent = evalsPerFrame.toFixed(0);

    const verdict = el<HTMLElement>("[data-health]");
    verdict.textContent = run.monitor.healthy
      ? `${run.scheme}: energy held inside ${fmt(run.monitor.energyTolerance)}`
      : `${run.scheme}: energy drift EXCEEDED ${fmt(run.monitor.energyTolerance)} — this run is not trustworthy`;
    verdict.dataset.bad = String(!run.monitor.healthy);
  }

  /* Sized from a ResizeObserver rather than a window `resize` listener: the window event does
     not fire for the INITIAL layout, so a one-shot call at startup measures the canvas before
     CSS has given it a width and everything draws into a corner. */
  function resize(): void {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    for (const c of [canvas, chart]) {
      const rect = c.getBoundingClientRect();
      const w = Math.max(1, Math.round(rect.width * dpr));
      const h = Math.max(1, Math.round(rect.height * dpr));
      if (c.width !== w || c.height !== h) {
        c.width = w;
        c.height = h;
      }
    }
    draw();
    drawChart();
  }

  function tick(): void {
    requestAnimationFrame(tick);
    if (!run || !running) return;
    try {
      run.integrator.step(run.build.timeUnit / FRAMES_PER_UNIT);
    } catch (err) {
      running = false;
      playBtn.textContent = "Play";
      status.textContent = `Stopped: ${(err as Error).message}`;
      return;
    }
    const now = run.evals();
    evalsPerFrame = now - lastEvals;
    lastEvals = now;
    draw();
    readout();
    drawChart();
  }

  playBtn.addEventListener("click", () => {
    running = !running;
    playBtn.textContent = running ? "Pause" : "Play";
    playBtn.setAttribute("aria-pressed", String(running));
  });

  /* Reverse: negate every velocity in place. A time-symmetric map then retraces its own
     trajectory back to where it started; the others visibly do not. The trail is cleared so what
     is drawn from here is the RETURN path rather than the outbound one drawn over itself. */
  reverseBtn.addEventListener("click", () => {
    if (!run) return;
    const v = run.build.state.vel;
    for (let i = 0; i < v.length; i++) v[i] = -v[i];
    run.integrator.invalidateAcceleration();
    run.trail = [];
  });

  resetBtn.addEventListener("click", () => reset());
  for (const input of [eccInput, nInput, epsInput]) {
    input.addEventListener("input", () => reset(true));
  }
  for (const radio of document.querySelectorAll('input[name="scenario"]')) {
    radio.addEventListener("change", () => reset());
  }
  new ResizeObserver(resize).observe(canvas);

  // Respect the OS setting: start paused rather than autoplaying motion.
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    running = false;
    playBtn.textContent = "Play";
    playBtn.setAttribute("aria-pressed", "false");
  }

  reset();
  resize();
  tick();
</script>


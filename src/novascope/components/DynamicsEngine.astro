---
/*
 * DynamicsEngine — the /explore/dynamics explorable.
 *
 * Structure deliberately mirrors CensusEngine: a panel grid, lens chips that
 * swap control groups, `data-lit` panels that highlight when the lens driving
 * them is active, and a live `<dl>` summary. Copying that vocabulary is not
 * only cosmetic — census wraps every `<input>` INSIDE its `<label>`, which is
 * what gives the controls accessible names. The dynamics LAB put the value in a
 * `<legend>` and left the sliders unnamed, so a screen reader announces
 * "slider, 1". Mimicking census fixes that by construction.
 *
 * HEARTBEAT TOGGLE: gravity isolated <-> N-body. Isolated holds the cluster
 * static, which is literally what the spec asks for ("a static scatter becomes
 * a living, segregating cluster"), and avoids inventing a zero-force model.
 *
 * RUNG: the backend knows ZAMS values and a main-sequence lifetime. Stars here
 * MOVE; they do not evolve. The page states that. Nothing in this component may
 * imply otherwise.
 *
 * NAMING: this is `dynamics`, never "gravax". The browser does not run gravax;
 * it runs a symplectic integrator of the same family. See explore-authoring.
 */
import Math from "../../components/Math.astro";
const m = (tex: string) => tex;
---

<div class="xpl-dyn" data-dyn>
  <div class="xpl-dyn__grid">
    <figure class="xpl-dyn__panel" data-lit="gravity">
      <figcaption>
        The cluster
        <span>drag to orbit</span>
      </figcaption>
      {/* The clock and the transport ride ON the frame, as census's readout card
          rides on the H–R panel. They belong to the view rather than to the page,
          and lifting them out of the caption is what lets the canvas square up
          against the plot beside it instead of sitting a control-bar lower. */}
      <div class="xpl-dyn__stage">
        <canvas data-field aria-label="Star cluster in projection; brighter, larger points are more luminous stars"></canvas>
        <div class="xpl-dyn__hud">
          <span class="xpl-dyn__modes" role="group" aria-label="Clock">
            <button type="button" data-play class="is-active">▶ run</button>
            <button type="button" data-reset>↻ reset</button>
          </span>
          <span class="xpl-dyn__clock" data-clock aria-live="off">t = 0.0 Myr</span>
        </div>
      </div>
      <small class="xpl-dyn__hint" data-hint>frozen as drawn</small>
      {/* THE HEARTBEAT TOGGLE SITS UNDER THE CLUSTER IT RESHAPES — census's own
          rule for its presets row, and this is the control that rule was written
          for: it is the one switch the whole page is about, and it was buried in
          a lens you had to open. The explanation of what each mode means stays in
          the console; only the switch moves. */}
      <div class="xpl-dyn__modes xpl-dyn__modes--under" role="group" aria-label="Gravity model">
        <button type="button" data-grav="off" class="is-active" aria-pressed="true">isolated</button>
        <button type="button" data-grav="on" aria-pressed="false">N-body</button>
      </div>
    </figure>

    <figure class="xpl-dyn__panel" data-lit="gravity segregation">
      <figcaption>
        Half-mass radius
        <span>relative to its own start</span>
      </figcaption>
      <div class="xpl-dyn__plot">
        <span class="xpl-dyn__ytitle"><Math tex={m("r_h(t)\\,/\\,r_h(0)")} /></span>
        <canvas data-radii aria-label="Half-mass radius of the most massive stars and of the least massive stars, against time"></canvas>
        <span class="xpl-dyn__xtitle"><Math tex={m("t\\;(\\mathrm{Myr})")} /></span>
      </div>
      <small class="xpl-dyn__hint">
        Solid: heaviest 10% of stars. Dashed: lightest half. Each relative to its own starting
        radius, so both begin at 1 and any gap is what gravity did.
      </small>
    </figure>

    <div class="xpl-dyn__panel xpl-dyn__panel--pad">
      <div class="xpl-dyn__toolbar">
        <div
          class="xpl-dyn__lenses"
          role="group"
          aria-label="Lenses — the controls that change what you are looking at"
        >
          <button type="button" data-lens-chip="gravity" class="is-active" aria-pressed="true">
            Gravity
          </button>
          <button type="button" data-lens-chip="cluster" aria-pressed="false">Cluster</button>
        </div>
        <button type="button" class="xpl-dyn__reseed" data-reseed>↻ new draw</button>
      </div>

      <div class="xpl-dyn__controls">
        <section class="xpl-dyn__lens" data-lens="gravity" aria-label="Gravity controls">
          <p class="xpl-dyn__lenshd"><b>Gravity</b> — does every star pull on every other?</p>
          <p class="xpl-dyn__note" data-gravnote>
            Isolated: the stars hold the positions they were born with. Nothing moves, and
            nothing segregates.
          </p>
        </section>

        <section class="xpl-dyn__lens" data-lens="cluster" aria-label="Cluster controls" hidden>
          <p class="xpl-dyn__lenshd"><b>Cluster</b> — what is being integrated?</p>
          <div class="xpl-dyn__lensgrid">
            <label class="xpl-dyn__ctrl">
              <span class="xpl-dyn__ctrl-name">stars</span>
              <span class="xpl-dyn__ctrl-val"><Math tex={m("N")} /> = <output data-n-val>400</output></span>
              <input type="range" data-n min="100" max="1200" step="50" value="400" />
              <small>fewer = faster, noisier</small>
            </label>
            <label class="xpl-dyn__ctrl">
              <span class="xpl-dyn__ctrl-name">speed</span>
              <span class="xpl-dyn__ctrl-val"><output data-speed-val>1.0</output><Math tex={m("\\times")} /></span>
              <input type="range" data-speed min="0.25" max="4" step="0.25" value="1" />
              <small>time per frame</small>
            </label>
          </div>
        </section>
      </div>

      <dl class="xpl-dyn__stats" data-summary aria-live="polite">
        <div><dt>time</dt><dd><span data-v="t">0.0</span> <Math tex={m("\\mathrm{Myr}")} /></dd></div>
        <div><dt>crossings</dt><dd data-v="tcr">0.0</dd></div>
        <div>
          <dt><Math tex={m("r_h")} /> heavy</dt>
          <dd><span data-v="rhi">—</span> <Math tex={m("\\mathrm{pc}")} /></dd>
        </div>
        <div>
          <dt><Math tex={m("r_h")} /> light</dt>
          <dd><span data-v="rlo">—</span> <Math tex={m("\\mathrm{pc}")} /></dd>
        </div>
        <div><dt>bound</dt><dd><span data-v="bound">—</span>%</dd></div>
      </dl>
    </div>

    {/* The energy strip is the RECEIPT, not a co-star. On the lab, drift is the
        subject; here it is the evidence that the run above can be trusted, so it
        is persistent and small rather than a fourth equal panel. */}
    <figure class="xpl-dyn__panel xpl-dyn__panel--strip">
      <figcaption>
        Energy drift
        <span data-drift>—</span>
      </figcaption>
      <canvas data-energy aria-label="Fractional energy error against time"></canvas>
      <small class="xpl-dyn__hint">
        A symplectic integrator's error stays bounded rather than growing. If this wanders off
        the strip, stop believing the panel above it.
      </small>
    </figure>
  </div>

  <noscript>
    <p class="xpl-dyn__noscript">
      This explorable integrates a star cluster in your browser, so it needs JavaScript. The
      physics it demonstrates is described in the text below.
    </p>
  </noscript>
</div>

<script>
  import {
    scenario,
    chooseIntegrator,
    createConservationMonitor,
    measure,
    lagrangianRadii,
  } from "@novascope/core/dynamics";
  /* The renderer is named directly, never through the `starfield` barrel: that
     barrel is deliberately three-free so the node gates can import the pure
     modules (see viz/starfield/index.ts). */
  import { initStarLab, type StarLab } from "@novascope/viz/starfield/scene";
  import { star } from "@novascope/core/stellar";
  /* Shared with the H–R diagram and the IMF histogram. AXIS_FONT is a LITERAL
     font string on purpose — see the note in axis.ts; this page is the reason it
     is there. */
  import { AXIS_FONT, niceTicks } from "@novascope/viz/axis";

  const root = document.querySelector<HTMLElement>("[data-dyn]");
  if (root) {
    const $ = <T extends HTMLElement>(sel: string): T => root.querySelector<T>(sel)!;

    const field = $<HTMLCanvasElement>("[data-field]");
    const radiiCv = $<HTMLCanvasElement>("[data-radii]");
    const energyCv = $<HTMLCanvasElement>("[data-energy]");
    const nInput = $<HTMLInputElement>("[data-n]");
    const nVal = $<HTMLOutputElement>("[data-n-val]");
    const speedInput = $<HTMLInputElement>("[data-speed]");
    const speedVal = $<HTMLOutputElement>("[data-speed-val]");
    const playBtn = $<HTMLButtonElement>("[data-play]");
    const clockEl = $<HTMLElement>("[data-clock]");
    const hint = $<HTMLElement>("[data-hint]");
    const gravNote = $<HTMLElement>("[data-gravnote]");
    const driftEl = $<HTMLElement>("[data-drift]");
    const summary = $<HTMLElement>("[data-summary]");

    const gravBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-grav]"));
    const lensChips = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-lens-chip]"));
    const lensSections = Array.from(root.querySelectorAll<HTMLElement>("[data-lens]"));
    const litPanels = Array.from(root.querySelectorAll<HTMLElement>("[data-lit]"));

    const setStat = (key: string, v: string) => {
      const el = summary.querySelector<HTMLElement>(`[data-v="${key}"]`);
      if (el) el.textContent = v;
    };

    /* ── state ─────────────────────────────────────────────────── */
    let gravity = false;
    let playing = false;
    let run: ReturnType<typeof build> | null = null;
    /* History of (t, r_h heavy, r_h light) and of fractional energy error. */
    let hist: { t: number; hi: number; lo: number; e: number }[] = [];
    /* Halving threshold, not a cap on the run: see the decimation in sample().
       600 samples is already ~4x the horizontal pixels of the plot at 1440px. */
    const MAX_SAMPLES = 600;
    let hi0: number | null = null;
    let lo0: number | null = null;

    /* Bumped by "new draw" only. Reset keeps the seed, so "reset" means "same
       cluster from t=0" and "new draw" means "a different cluster" — two
       distinct things that were previously the same button twice. */
    let seed = 2026;

    function build() {
      const s = scenario("cluster");
      const built = s.build({ n: Number(nInput.value), seed });
      /*
       * The scenario's OWN default scheme, not a faster one chosen here.
       * Forcing leapfrog measured 1.3e-2 energy drift by ten crossing times —
       * past the monitor's 1e-3 tolerance, so `healthy` latched false and the
       * page's own "stop believing this" threshold had been crossed while the
       * page went on presenting the result. fsi4 holds 6e-5..3.8e-4 over the
       * same run with identical segregation. The scenario knows which schemes
       * are honest for its configuration; overriding that was the bug.
       */
      const picked = chooseIntegrator(built.state, built.force, {
        prefer: s.defaultScheme,
        maxStep: built.timeUnit / 64,
      });
      /* Mass split is fixed once per draw, so the two curves follow the SAME
         stars all run — a split recomputed each frame would track whichever
         stars happen to be heavy now and could not show sinking. */
      const idx = Array.from({ length: built.state.n }, (_, i) => i).sort(
        (a, b) => built.state.mass[b] - built.state.mass[a],
      );
      const nHeavy = Math.max(1, Math.round(idx.length * 0.1));
      const heavy = new Set(idx.slice(0, nHeavy));
      const light = new Set(idx.slice(Math.floor(idx.length * 0.5)));
      return {
        built,
        integrator: picked.integrator,
        monitor: createConservationMonitor(picked.integrator),
        heavy,
        light,
      };
    }

    /*
     * The monitor is the source for time, the crossing-time clock and the drift
     * — all three come off one `sample()`. Keeping a separate `t` accumulator
     * and a separate crossingTime() call would be two clocks that can disagree,
     * and the monitor's own docs call tCross "the meaningful clock".
     */
    function sample() {
      if (!run) return;
      const st = run.built.state;
      const s = run.monitor.sample();
      const d = measure(st, run.built.force, s.t);
      const hi = lagrangianRadii(st, [0.5], (i) => run!.heavy.has(i))[0];
      const lo = lagrangianRadii(st, [0.5], (i) => run!.light.has(i))[0];
      /* Baseline on the FIRST sample so both curves start at exactly 1.
         Absolute r_h of the heaviest 10% is a ~40-star estimate and lands well
         off the light-star value at t=0 by sampling noise alone — measured 0.48
         vs 0.70 pc with no primordial segregation in the ICs at all
         (params.ts defaults segregation to 0). Plotting the raw radii would
         show the curves already apart before gravity had done anything, which
         reads as segregation that was imposed. The claim is about CHANGE, so
         the plot shows change; the absolute radii stay in the readout below. */
      if (hi0 === null) hi0 = hi || 1;
      if (lo0 === null) lo0 = lo || 1;
      hist.push({ t: s.t, hi: hi / hi0, lo: lo / lo0, e: s.energyDrift });
      /*
       * KEEP THE WHOLE RUN, at coarser resolution — never drop the beginning.
       *
       * This used to `shift()` past 600 samples, which discards the OLDEST point
       * while the x-axis still spans 0..t_now. The visible result is a curve that
       * detaches from the left edge and crawls rightward across an empty plot,
       * and the run's first crossing times — where the segregation this page is
       * about actually happens — are gone. Halving instead keeps t = 0 in frame
       * for an arbitrarily long run: the record thins, it does not truncate.
       */
      if (hist.length > MAX_SAMPLES) hist = hist.filter((_, i) => i % 2 === 0);

      setStat("t", s.t.toFixed(1));
      setStat("tcr", s.tCross.toFixed(1));
      setStat("rhi", hi.toFixed(2));
      setStat("rlo", lo.toFixed(2));
      setStat("bound", (d.boundMassFraction * 100).toFixed(0));
      clockEl.textContent = `t = ${s.t.toFixed(1)} Myr`;
      driftEl.textContent = s.energyDrift.toExponential(1);
      /* `healthy` latches false once drift has ever breached tolerance, so this
         cannot flicker back to reassuring after a bad excursion. */
      driftEl.classList.toggle("is-bad", !run.monitor.healthy);
    }

    /* ── drawing ───────────────────────────────────────────────── */
    const fit = (cv: HTMLCanvasElement) => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const r = cv.getBoundingClientRect();
      cv.width = Math.max(1, Math.round(r.width * dpr));
      cv.height = Math.max(1, Math.round(r.height * dpr));
      const ctx = cv.getContext("2d")!;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      return { ctx, w: r.width, h: r.height };
    };

    const css = (name: string, fb: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fb;

    /*
     * The cluster is drawn by the three.js / WebGPU starfield — the render stack
     * ADR 0015 chose (WebGPURenderer + TSL, three pinned to 0.185.1, the
     * renderer's own WebGL 2 backend where WebGPU is absent).
     *
     * IT REPLACED THE RAW-WebGL ENGINE HERE FOR A MEASURED REASON, not a
     * preference. That engine sized the box from the 98th percentile of the
     * cluster's radii, and this cluster's radial distribution has a heavy tail
     * (p50 0.67 pc, p98 4.69, max 13.47), so the box came out at 15 pc and the
     * bulk of the cluster was crushed into the middle 5% of the frame: 400 stars
     * rendered as 87 resolvable blobs around a saturated core. ADR 0015 records
     * the same failure on the same engine family ("48 stars visible and the core
     * saturated into one blob") and defers the port until there is evidence; this
     * is that evidence. The starfield scene frames on the cluster's own half-mass
     * radius instead, derived from the stars actually drawn.
     *
     * Colour and brightness come from Teff and R via star(), so they are the
     * contract's values rather than a heavy/light hack of my own — explore-
     * authoring rule 1. The packing below is already the table `prepare` reads.
     */
    let lab: StarLab | null = null;
    /* A mount is async (the renderer awaits device init), and reset / new draw /
       the N slider can all fire another before the first lands. Without a token
       the loser's scene would win the canvas. */
    let mountToken = 0;

    /** n*6: x, y, z, mass, Teff, radius — the layout the engine expects. */
    function packStars(): Float32Array {
      const st = run!.built.state;
      const out = new Float32Array(st.n * 6);
      for (let i = 0; i < st.n; i++) {
        const M = st.mass[i];
        const sv = star(M, 0.02, 0);
        out[6 * i] = st.pos[3 * i];
        out[6 * i + 1] = st.pos[3 * i + 1];
        out[6 * i + 2] = st.pos[3 * i + 2];
        out[6 * i + 3] = M;
        out[6 * i + 4] = sv.Teff;
        out[6 * i + 5] = sv.R;
      }
      return out;
    }

    function positions(): Float32Array {
      const st = run!.built.state;
      const out = new Float32Array(st.n * 3);
      out.set(st.pos.subarray(0, st.n * 3));
      return out;
    }

    async function mountField() {
      if (!run) return;
      const token = ++mountToken;
      const previous = lab;
      lab = null;
      previous?.dispose();
      /* No box, no framing guess: the scene derives its own from the supplied
         table's half-mass radius. */
      /*
       * PHOTOMETRIC, and the exposure opened up to pay for it.
       *
       * This page is about WHERE THE MASSIVE STARS GO, so a star's apparent size
       * has to follow its own luminosity — the census cluster's rule, and ADR
       * 0015's ("apparent size and brightness derive from each star's own
       * luminosity"). The `population` default discards luminosity and draws every
       * star at unit luminance: measured on this cluster it renders the heaviest
       * 10% just 1.7x the typical star, so the sinking has nothing to show.
       * Photometric renders them 19.4x, which is the picture.
       *
       * The cost is that ZAMS luminosity spans ~9 dex, so at the lab's default
       * exposure (0.995, cut for 10,000 stars) only 8 of these 400 clear 1% of
       * display white. `whitePercentile` is TONE MAPPING — which flux maps to
       * white, i.e. how the frame is developed — and changes nothing about any
       * star. Opening it to 0.8 puts all 400 above 1% while KEEPING the 19.4x
       * contrast. Measured across the sweep; 0.9 still leaves 233 stars dark.
       */
      /*
       * NO DIFFRACTION SPIKES, AND RESTRAINED BLOOM. Both are instrument
       * signature — what a telescope's spider and a bright source do to an
       * image — and `prepare` records that spikes were measured "owning 58.2% of
       * the drawn quad area from SEVEN stars of 1200". At this exposure that is
       * exactly what happened here: the two most massive stars turned into lens
       * flares and the cluster disappeared behind them. On a page whose claim is
       * read off the POSITIONS of the massive stars, an instrument artefact that
       * large is not atmosphere, it is occlusion.
       */
      const next = await initStarLab(field, {
        stars: packStars(),
        colorMode: "photometric",
        whitePercentile: 0.8,
        spikeStrength: 0,
        bloom: 0.12,
      });
      if (token !== mountToken) {
        next.dispose(); // a newer mount started while this one was awaiting
        return;
      }
      /*
       * NO CAMERA DRIFT. The lab auto-rotates because a static portrait wants
       * parallax; here every pixel of motion has to be attributable to gravity,
       * and a turning camera would make "the massive stars sink" ambiguous with
       * "the view moved". Dragging still orbits.
       */
      next.setDrifting(false);
      lab = next;
      lab.setPositions(positions());
    }

    /*
     * Plot margins, sized for AXIS_FONT (14px) rather than for the 9px these were
     * cut for — which never rendered anyway, so the old 34/18 was reserving room
     * for a label size that did not exist. Left has to clear "1.00"-width labels
     * at 14px; bottom has to clear one line plus its gap.
     */
    const AX = { l: 64, r: 14, t: 12, b: 32 };

    function drawSeries(
      cv: HTMLCanvasElement,
      series: { get: (p: (typeof hist)[number]) => number; colour: string; dash: number[] }[],
      opts: { zeroBase?: boolean; refOne?: boolean; fmt?: (v: number) => string } = {},
    ) {
      const { ctx, w, h } = fit(cv);
      ctx.clearRect(0, 0, w, h);
      const ink = css("--ink-faint", "#8b8f9a");
      const grid = css("--bg-hairline", "#2b2d38");
      const fmt = opts.fmt ?? ((v: number) => (Math.abs(v) >= 100 ? v.toFixed(0) : v.toFixed(2)));

      const tMax = hist.length > 1 ? hist[hist.length - 1].t || 1 : 1;
      let lo = Infinity;
      let hiV = -Infinity;
      for (const p of hist)
        for (const sr of series) {
          const v = sr.get(p);
          if (Number.isFinite(v)) {
            lo = Math.min(lo, v);
            hiV = Math.max(hiV, v);
          }
        }
      if (opts.zeroBase) lo = Math.min(lo, 0);
      if (opts.refOne) {
        lo = Math.min(lo, 1);
        hiV = Math.max(hiV, 1);
      }
      if (!Number.isFinite(lo) || !Number.isFinite(hiV)) {
        lo = 0;
        hiV = 1;
      }
      if (hiV === lo) hiV = lo + 1;
      const pad = (hiV - lo) * 0.08;
      lo -= pad;
      hiV += pad;

      const X = (t: number) => AX.l + (t / tMax) * (w - AX.l - AX.r);
      const Y = (v: number) => h - AX.b - ((v - lo) / (hiV - lo)) * (h - AX.t - AX.b);

      ctx.font = AXIS_FONT;
      ctx.fillStyle = ink;
      ctx.strokeStyle = grid;
      ctx.lineWidth = 1;

      for (const v of niceTicks(lo, hiV)) {
        const y = Y(v);
        ctx.beginPath();
        ctx.moveTo(AX.l, y);
        ctx.lineTo(w - AX.r, y);
        ctx.stroke();
        ctx.textAlign = "right";
        ctx.textBaseline = "middle";
        ctx.fillText(fmt(v), AX.l - 8, y);
      }
      /* Vertical gridlines too, as the H–R diagram has: reading a time off a plot
         with horizontal rules only means tracking across bare space. */
      for (const t of niceTicks(0, tMax, 4)) {
        const x = X(t);
        ctx.beginPath();
        ctx.moveTo(x, AX.t);
        ctx.lineTo(x, h - AX.b);
        ctx.stroke();
        ctx.textAlign = "center";
        ctx.textBaseline = "top";
        ctx.fillText(t.toFixed(t < 10 ? 1 : 0), x, h - AX.b + 8);
      }
      /* Axis frame, matching renderHR's strokeRect — it separates the plotting
         area from the panel, which matters now that both panels have a filled
         background rather than the transparent one this file wrongly attributed
         to census. */
      ctx.strokeStyle = css("--border", "#2a2c31");
      ctx.strokeRect(AX.l, AX.t, w - AX.l - AX.r, h - AX.t - AX.b);
      ctx.strokeStyle = grid;

      if (opts.refOne) {
        ctx.save();
        ctx.setLineDash([2, 3]);
        ctx.strokeStyle = ink;
        ctx.beginPath();
        ctx.moveTo(AX.l, Y(1));
        ctx.lineTo(w - AX.r, Y(1));
        ctx.stroke();
        ctx.restore();
      }

      if (hist.length < 2) return;
      for (const sr of series) {
        ctx.beginPath();
        ctx.setLineDash(sr.dash);
        ctx.strokeStyle = sr.colour;
        ctx.lineWidth = 1.6;
        let started = false;
        for (const p of hist) {
          const v = sr.get(p);
          if (!Number.isFinite(v)) continue;
          if (!started) {
            ctx.moveTo(X(p.t), Y(v));
            started = true;
          } else ctx.lineTo(X(p.t), Y(v));
        }
        ctx.stroke();
      }
      ctx.setLineDash([]);
    }

    const drawPlots = () => {
      const rose = css("--spec-rose-bright", "#e58fb4");
      const teal = css("--spec-teal-bright", "#4fd6c4");
      drawSeries(
        radiiCv,
        [
          { get: (p) => p.hi, colour: rose, dash: [] },
          { get: (p) => p.lo, colour: teal, dash: [4, 3] },
        ],
        { refOne: true },
      );
      drawSeries(energyCv, [{ get: (p) => p.e, colour: css("--spec-amber", "#fbbf24"), dash: [] }], {
        zeroBase: true,
        fmt: (v) => (v === 0 ? "0" : v.toExponential(0)),
      });
    };

    const redraw = () => {
      lab?.setPositions(positions());
      drawPlots();
    };

    /* ── loop ──────────────────────────────────────────────────── */
    /*
     * Cancelled on pause, when the page is hidden, and when the engine scrolls
     * out of view. The dynamics LAB re-schedules unconditionally and never
     * stops — tolerable on an unlinked development surface, not on a page a
     * reader leaves open in a background tab.
     */
    let raf = 0;
    let onScreen = true;

    function frame() {
      raf = 0;
      if (!run || !playing || !gravity) return;
      const dt = (run.built.timeUnit / 64) * Number(speedInput.value);
      run.integrator.step(dt);
      sample();
      redraw();
      if (playing && onScreen && !document.hidden) raf = requestAnimationFrame(frame);
    }

    const start = () => {
      if (!raf && playing && gravity && onScreen && !document.hidden) raf = requestAnimationFrame(frame);
    };
    const stop = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    };

    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
    new IntersectionObserver((entries) => {
      onScreen = entries[0]?.isIntersecting ?? true;
      onScreen ? start() : stop();
    }).observe(root);

    /* ── wiring ────────────────────────────────────────────────── */
    const syncPlay = () => {
      playBtn.textContent = playing ? "❙❙ pause" : "▶ run";
      playBtn.classList.toggle("is-active", playing);
      /* Short phrases, as census's under-canvas hint is ("click to zoom & orbit").
         These were full sentences and made the strip read as a paragraph pinned
         under the frame; what each mode MEANS is the console's job, not this
         line's. */
      hint.textContent = gravity
        ? playing
          ? "integrating — every pair interacts"
          : "paused"
        : "frozen as drawn";
    };

    const rebuild = () => {
      stop();
      run = build();
      hist = [];
      void mountField();
      hi0 = null;
      lo0 = null;
      playing = false;
      sample();
      redraw();
      syncPlay();
    };

    playBtn.addEventListener("click", () => {
      /*
       * Run used to be DISABLED while gravity was isolated, so the page's
       * primary action did nothing on arrival and gave no reason why — you had
       * to discover that another control gates it. Pressing run now turns
       * gravity on, which is what pressing run plainly means.
       */
      if (!gravity) setGravity(true);
      playing = !playing;
      syncPlay();
      playing ? start() : stop();
    });

    $<HTMLButtonElement>("[data-reset]").addEventListener("click", rebuild);
    $<HTMLButtonElement>("[data-reseed]").addEventListener("click", () => {
      seed += 1;
      rebuild();
    });

    function setGravity(on: boolean) {
      gravity = on;
      for (const o of gravBtns) {
        const active = (o.dataset.grav === "on") === on;
        o.classList.toggle("is-active", active);
        o.setAttribute("aria-pressed", String(active));
      }
      gravNote.textContent = gravity
          ? "N-body: every pair interacts. Mass segregation below is not a rule that was added — it is what this same gravity does."
        : "Isolated: the stars hold the positions they were born with. Nothing moves, and nothing segregates.";
      if (!gravity) {
        playing = false;
        stop();
      }
      syncPlay();
    }

    for (const b of gravBtns) {
      b.addEventListener("click", () => setGravity(b.dataset.grav === "on"));
    }

    nInput.addEventListener("input", () => {
      nVal.value = nInput.value;
    });
    nInput.addEventListener("change", rebuild);
    speedInput.addEventListener("input", () => {
      speedVal.value = Number(speedInput.value).toFixed(2);
    });

    for (const chip of lensChips) {
      chip.addEventListener("click", () => {
        const key = chip.dataset.lensChip!;
        for (const c of lensChips) {
          const on = c === chip;
          c.classList.toggle("is-active", on);
          c.setAttribute("aria-pressed", String(on));
        }
        for (const s of lensSections) s.hidden = s.dataset.lens !== key;
        for (const p of litPanels)
          p.classList.toggle("is-lit", (p.dataset.lit ?? "").split(" ").includes(key));
      });
    }

    window.addEventListener("resize", redraw);
    rebuild();
  }
</script>

<style>
  /* Capped like census's root, which is what turns the top row into near-squares
     instead of letting the two panels stretch on a wide screen. */
  .xpl-dyn {
    display: grid;
    max-inline-size: 76rem;
    margin-inline: auto;
  }
  .xpl-dyn__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m);
    align-items: stretch; /* each row's two cells match height → columns align */
  }
  /*
   * Census's panel treatment, read from its stylesheet rather than remembered.
   * The note that used to sit here claimed census's figure panels are
   * "TRANSPARENT with zero padding"; they are not — `.xpl-census__panel` carries
   * a radial-gradient background and `overflow: hidden`, and that mistaken note
   * is why these two pages never looked like siblings.
   */
  .xpl-dyn__panel {
    margin: 0;
    padding: 0;
    background: radial-gradient(
      120% 120% at 50% 0%,
      color-mix(in srgb, var(--bg-surface) 92%, black),
      var(--bg-void)
    );
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    overflow: hidden;
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .xpl-dyn__panel.is-lit {
    border-color: color-mix(in srgb, var(--spec-teal) 45%, var(--border));
  }
  /* Flat surface, not the gradient — census's control panel is the one box that
     reads as a console rather than an instrument. */
  .xpl-dyn__panel--pad {
    padding: var(--space-s);
    background: var(--bg-surface);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .xpl-dyn__panel--strip {
    grid-column: 1 / -1;
  }
  /* Census's caption bar: a titled header rule, not a floating line of text. */
  .xpl-dyn__panel figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink);
    border-block-end: 1px solid var(--border);
  }
  .xpl-dyn__panel figcaption span {
    font-size: var(--step--2);
    color: var(--ink-faint);
  }
  .xpl-dyn__panel canvas {
    display: block;
    inline-size: 100%;
    touch-action: none;
  }
  /*
   * BOTH viewscreens are square, as census's cluster and H–R are. That is what
   * removes the dead band under the radii plot: at 4/3 the plot panel was
   * ~290 px shorter than the field beside it, and `align-items: stretch` turned
   * the difference into empty panel rather than into plot.
   */
  .xpl-dyn__panel [data-field],
  .xpl-dyn__panel [data-radii] {
    aspect-ratio: 1;
    block-size: auto;
  }
  .xpl-dyn__panel [data-field] {
    cursor: grab;
  }
  .xpl-dyn__panel [data-field]:active {
    cursor: grabbing;
  }
  /* The frame the HUD is positioned against — the canvas box, not the panel, so
     the controls cannot drift over the caption rule. */
  .xpl-dyn__stage {
    position: relative;
  }
  .xpl-dyn__hud {
    position: absolute;
    inset-block-start: var(--space-2xs);
    inset-inline: var(--space-2xs);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    pointer-events: none; /* the canvas keeps the drag; only the controls take clicks */
  }
  .xpl-dyn__hud > * {
    pointer-events: auto;
  }
  /* Legible over a star field of unknown brightness: the readout gets the same
     panel-tinted plate census gives its H–R card, rather than bare text that
     disappears the moment a bright star drifts under it. */
  .xpl-dyn__hud .xpl-dyn__clock {
    padding: 0.15em 0.6em;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-surface) 88%, black);
    color: var(--ink);
    font-size: var(--step--2);
  }
  /* 12:1 left no room for tick labels; the strip is small but it is a plot. */
  .xpl-dyn__panel [data-energy] {
    aspect-ratio: 9 / 1;
    inline-size: 100%;
    block-size: auto;
  }
  /*
   * Axis titles exactly as census sets them: the y-title absolutely positioned
   * and rotated over the canvas's own left margin, both at --step-0.
   *
   * They were at --step--2 here — two steps below census — while the tick labels
   * silently fell back to the canvas default. So the whole axis furniture was
   * smaller than the diagram it was labelling, on a plot that carries the page's
   * central claim.
   */
  .xpl-dyn__plot {
    position: relative;
  }
  .xpl-dyn__xtitle {
    display: block;
    text-align: center;
    padding-block: 0.25rem 0.4rem;
    font-size: var(--step-0);
    color: var(--ink-soft);
  }
  .xpl-dyn__ytitle {
    position: absolute;
    /* 1.15rem, not census's 0.85rem: rotated, this label's height becomes its
       width, and `r_h(t)/r_h(0)` has subscripts that make it 32px tall against
       census's `L/L_\odot`. At 0.85rem it overran the panel edge and `overflow:
       hidden` clipped it — measured, left 733 against a panel starting at 734. */
    inset-inline-start: 1.15rem;
    inset-block-start: 50%;
    transform: translate(-50%, -50%) rotate(-90deg);
    transform-origin: center;
    line-height: 1;
    font-size: var(--step-0);
    color: var(--ink-soft);
    white-space: nowrap;
    pointer-events: none;
  }
  .xpl-dyn__hint {
    display: block;
    padding: 0 var(--space-s) var(--space-2xs);
    margin-block-start: var(--space-3xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
    line-height: 1.5;
  }
  /* The plot's hint is still an explanation of what two curves mean, so it keeps
     its measure and its reading colour; only the field's is a status phrase. */
  .xpl-dyn__panel--strip .xpl-dyn__hint,
  .xpl-dyn__plot ~ .xpl-dyn__hint {
    color: var(--ink-soft);
    padding-block-end: var(--space-xs);
  }
  /* Census's presets row: ghost pills, full width of the panel, sharing the row
     equally, sitting directly under the frame they act on. */
  .xpl-dyn__modes--under {
    display: flex;
    gap: var(--space-3xs);
    padding: 0 var(--space-s) var(--space-s);
  }
  .xpl-dyn__modes--under button {
    flex: 1 1 auto;
    text-align: center;
  }
  .xpl-dyn__clock {
    font-family: var(--font-mono);
  }
  .xpl-dyn__toolbar,
  .xpl-dyn__lenses,
  .xpl-dyn__modes,
  .xpl-dyn__seg {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    align-items: center;
  }
  .xpl-dyn__toolbar {
    justify-content: space-between;
  }
  .xpl-dyn__lenses button,
  .xpl-dyn__modes button,
  .xpl-dyn__seg button,
  .xpl-dyn__reseed {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-soft);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25em 0.7em;
    cursor: pointer;
  }
  .xpl-dyn__lenses button.is-active,
  .xpl-dyn__modes button.is-active,
  .xpl-dyn__seg button.is-active {
    color: var(--bg-void);
    background: var(--spec-teal-bright);
    border-color: var(--spec-teal-bright);
  }
  .xpl-dyn__lenses button:disabled,
  .xpl-dyn__modes button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .xpl-dyn__lenshd {
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-block-end: var(--space-2xs);
  }
  .xpl-dyn__note {
    margin-block-start: var(--space-2xs);
    font-size: var(--step--2);
    color: var(--ink-faint);
    line-height: 1.5;
  }
  .xpl-dyn__lensgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s);
  }
  .xpl-dyn__ctrl {
    display: grid;
    gap: 2px;
    font-size: var(--step--2);
    color: var(--ink-soft);
  }
  .xpl-dyn__ctrl-val {
    font-family: var(--font-mono);
    color: var(--ink);
  }
  .xpl-dyn__ctrl small {
    color: var(--ink-faint);
  }
  .xpl-dyn__ctrl input[type="range"] {
    inline-size: 100%;
  }
  .xpl-dyn__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
    gap: var(--space-2xs);
    margin: 0;
    padding-block-start: var(--space-2xs);
    border-block-start: 1px solid var(--border);
  }
  .xpl-dyn__stats dt {
    font-size: var(--step--2);
    color: var(--ink-faint);
  }
  .xpl-dyn__stats dd {
    margin: 0;
    font-family: var(--font-mono);

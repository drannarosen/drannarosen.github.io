---
/*
 * DynamicsEngine — the /explore/dynamics explorable.
 *
 * Structure follows CensusEngine: a panel grid, a live `<dl>` summary, and every
 * `<input>` wrapped INSIDE its `<label>`. That last one is not cosmetic — it is
 * what gives the controls accessible names. The dynamics LAB put the value in a
 * `<legend>` and left the sliders unnamed, so a screen reader announces
 * "slider, 1". Mimicking census fixes that by construction.
 *
 * It does NOT copy census's lens chips. Census has three real control groups to
 * switch between; this page has one, so the chips were choosing between
 * "controls" and "a paragraph", and the `data-lit` panel highlighting they drove
 * had nothing to distinguish.
 *
 * HEARTBEAT TOGGLE: gravity off <-> N-body, and "off" means FREE STREAMING, not
 * a frozen frame. An earlier version held the cluster static to avoid "inventing
 * a zero-force model" — but zero force is not invented, it is `x += v dt`, and
 * the stars already carry velocities. Static made the toggle indistinguishable
 * from paused, which is why the page had two controls doing one thing and why
 * `run` had to override the toggle to do anything. Free streaming is both the
 * honest limit and the page's own title: remove the coupling and the cluster
 * comes apart.
 *
 * RUNG: the backend knows ZAMS values and a main-sequence lifetime. Stars here
 * MOVE; they do not evolve. The page states that. Nothing in this component may
 * imply otherwise.
 *
 * NAMING: this is `dynamics`, never "gravax". The browser does not run gravax;
 * it runs a symplectic integrator of the same family. See explore-authoring.
 */
import Math from "../../components/Math.astro";
const m = (tex: string) => tex;
---

<div class="xpl-dyn" data-dyn>
  <div class="xpl-dyn__grid">
    <figure class="xpl-dyn__panel">
      <figcaption>
        The cluster
        <span>drag to orbit · scroll to zoom</span>
      </figcaption>
      {/*
        EVERY CONTROL RIDES ON THE FRAME, in the two corners the cluster does not
        use: transport and clock along the top, the physics toggle bottom-left.
        The cluster is centred and roughly circular, so the corners are the free
        space — and putting the toggle on the canvas rather than in a row beneath
        it is what lets the metrics strip sit directly under the image.

        "gravity" / "no gravity", not the spec's "isolated". `isolated` is the
        right physics term — each star isolated from the others — but it reads as
        a property of the CLUSTER (isolated from a tide? a galaxy?) rather than as
        the force being switched off. Gravity leads, because it is the term being
        added and the one the page is about; "no gravity" is the control.
      */}
      <div class="xpl-dyn__stage">
        <canvas data-field aria-label="Star cluster in projection; brighter, larger points are more luminous stars"></canvas>
        <div class="xpl-dyn__hud xpl-dyn__hud--top">
          <span class="xpl-dyn__modes" role="group" aria-label="Clock and cluster">
            <button type="button" data-play class="is-active">▶ run</button>
            <button type="button" data-reset>↻ reset</button>
            {/* "new draw" belongs beside reset because the two are the same kind of
                action — start over — differing only in whether the seed changes.
                It was across the panel in a toolbar of its own. */}
            <button type="button" data-reseed>↻ new draw</button>
          </span>
          <span class="xpl-dyn__clock" data-clock aria-live="off">t = 0.0 Myr</span>
        </div>
        <div class="xpl-dyn__hud xpl-dyn__hud--bottom">
          <span class="xpl-dyn__modes" role="group" aria-label="Gravity">
            <button type="button" data-grav="on" aria-pressed="false">gravity</button>
            <button type="button" data-grav="off" class="is-active" aria-pressed="true">no gravity</button>
          </span>
          {/* The scale bar is what makes a frame that moves honest: it reports how
              far the picture now spans, so an expanding cluster reads as expansion
              rather than as a camera trick. Census puts one in the same corner. */}
          <span class="xpl-dyn__scale" aria-hidden="true">
            <span class="xpl-dyn__scale-bar" data-scalebar></span>
            <span class="xpl-dyn__scale-label" data-scalelabel>1 pc</span>
          </span>
        </div>
      </div>
      {/* The readout sits DIRECTLY under the image it describes, one line, rather
          than in the console two panels away — these five numbers are what the
          picture above is doing, and reading them meant looking somewhere else. */}
      <dl class="xpl-dyn__stats" data-summary aria-live="polite">
        <div><dt>t</dt><dd><span data-v="t">0.0</span> <Math tex={m("\\mathrm{Myr}")} /></dd></div>
        <div><dt><Math tex={m("t/t_\\mathrm{cr}")} /></dt><dd data-v="tcr">0.0</dd></div>
        <div><dt><Math tex={m("r_h")} /> hi</dt><dd><span data-v="rhi">—</span></dd></div>
        <div><dt><Math tex={m("r_h")} /> lo</dt><dd><span data-v="rlo">—</span></dd></div>
        {/* TWO cells, not one labelled "bound". They disagree and the gap is the
            story: mass-bound is dominated by a few heavy stars that stay put,
            so it reads high while half the STARS have already left. */}
        <div><dt>bound <Math tex={m("M")} /></dt><dd><span data-v="boundm">—</span>%</dd></div>
        <div><dt>bound <Math tex={m("N")} /></dt><dd><span data-v="boundn">—</span>%</dd></div>
      </dl>
      <small class="xpl-dyn__hint" data-hint>paused — press run to let them drift apart</small>
      {/*
        THE CLUSTER CONTROLS LIVE IN THIS PANEL, not in a console of their own.
        A separate control box cost a whole grid row, and that row is what pushed
        the energy strip below the fold — so you could not watch the cluster and
        its own error trace at the same time, which is the one thing the strip is
        for. Folded in here they fill the space under the status line instead.
      */}
      <div class="xpl-dyn__controls" aria-label="Cluster controls" role="group">
        <label class="xpl-dyn__ctrl">
          <span class="xpl-dyn__ctrl-val"
            ><Math tex={m("N")} /> = <output data-n-val>400</output></span
          >
          {/* The max is the scenario's OWN ceiling (`clamp(n, 20, 800)` in
              scenarios.ts), not a number chosen here. The slider used to run to
              1200 while the scenario clamped at 512, so the readout printed
              "N = 1200" over a 512-star run. */}
          <input type="range" data-n min="100" max="800" step="10" value="400" />
        </label>
        <label class="xpl-dyn__ctrl">
          <span class="xpl-dyn__ctrl-val"
            >speed <output data-speed-val>1.0</output><Math tex={m("\\times")} /></span
          >
          <input type="range" data-speed min="0.25" max="4" step="0.25" value="1" />
        </label>
      </div>
    </figure>

    {/*
      THE LEGEND IS THE KEY, AND IT CARRIES THE EXPLANATION BEHIND A "?".

      What the two curves ARE was a three-line paragraph under the plot, which is
      the one place a reader is not looking while watching them move — and it cost
      more vertical space than the metrics strip. A legend puts the key on the
      figure, and census's `data-info` / `data-popover` pair (its spatial-profile
      note) is the pattern for the prose behind it: it pops OVER the panel rather
      than pushing it taller, so the plot keeps its height.

      The swatches take their colours from the same `--spec-*` tokens the canvas
      reads through `css()`, so a legend cannot end up a different colour from the
      line it labels.
    */}
    <figure class="xpl-dyn__panel">
      <figcaption>
        {/* TABS, not a third panel. A separate panel per curve is what pushed the
            energy strip off the same screen as the cluster; tabs keep the
            footprint fixed and let each plot be full size. The energy strip stays
            OUTSIDE them deliberately — it is the receipt that vouches for whichever
            tab you are on, and behind a tab it could not do that job. */}
        <span class="xpl-dyn__modes" role="group" aria-label="Plot">
          <button type="button" data-plot-tab="radii" class="is-active" aria-pressed="true">
            half-mass radius
          </button>
          <button type="button" data-plot-tab="bound" aria-pressed="false">bound fraction</button>
        </span>
        <span class="xpl-dyn__legend">
          <span class="xpl-dyn__keys" data-legend="radii">
            <span class="xpl-dyn__key"><i class="xpl-dyn__swatch xpl-dyn__swatch--hi"></i>heaviest 10%</span>
            <span class="xpl-dyn__key"><i class="xpl-dyn__swatch xpl-dyn__swatch--lo"></i>lightest half</span>
          </span>
          <span class="xpl-dyn__keys" data-legend="bound" hidden>
            <span class="xpl-dyn__key"><i class="xpl-dyn__swatch xpl-dyn__swatch--hi"></i>by mass</span>
            <span class="xpl-dyn__key"><i class="xpl-dyn__swatch xpl-dyn__swatch--lo"></i>by number</span>
          </span>
          <button
            type="button"
            class="xpl-dyn__info"
            data-info="plot"
            aria-expanded="false"
            aria-label="About this plot"
          >?</button>
          <span class="xpl-dyn__popover" data-popover="plot" role="tooltip" hidden>
            <span data-note="radii">
              Each curve is the half-mass radius of its own group, divided by that group's value at
              <Math tex={m("t = 0")} />, so both start at 1. The split is fixed at the first frame,
              so the same stars are followed all run and the curves cannot separate by relabelling
              who counts as heavy. With gravity on, both are measured about the bound cluster's own
              centre and over its bound stars — a dissolving cluster recoils, and its escapers would
              otherwise dominate the radius.
              <br /><br />
              <b>A gap on its own is not the evidence.</b> With gravity off the curves still
              separate by about 20% within eight crossing times and then hold there, because the two
              groups begin at different radii and with different speeds. What gravity does is
              different in kind: the heavy curve drops <em>below</em> 1 while the light one climbs.
              Measured here, the heaviest 10% reach 0.46 of their starting radius by fifty crossing
              times.
            </span>
            <span data-note="bound" hidden>
              The fraction of the cluster still gravitationally bound, by <b>mass</b> and by
              <b>number</b>. They disagree, and the gap is the point: the heaviest stars carry most
              of the mass and are the last to leave, so the mass curve stays high while the star
              count falls away beneath it. Measured on this cluster at a thousand crossing times,
              64% of the mass was still bound but only 49% of the stars.
              <br /><br />
              Both are blank with gravity off. Boundness is measured against a potential that is not
              being integrated then, so a number there would be a counterfactual rather than a
              property of what you are watching.
            </span>
          </span>
        </span>
      </figcaption>
      <div class="xpl-dyn__plot">
        <span class="xpl-dyn__ytitle" data-ytitle="radii"
          ><Math tex={m("r_h(t)\\,/\\,r_h(0)")} /></span
        >
        <span class="xpl-dyn__ytitle" data-ytitle="bound" hidden>bound fraction</span>
        <canvas data-radii aria-label="Cluster evolution against time: half-mass radius of the heaviest and lightest stars, or the bound fraction"></canvas>
        <span class="xpl-dyn__xtitle"><Math tex={m("t\\;(\\mathrm{Myr})")} /></span>
      </div>
    </figure>

    {/* The energy strip is the RECEIPT, not a co-star. On the lab, drift is the
        subject; here it is the evidence that the run above can be trusted, so it
        is persistent and small rather than a fourth equal panel. */}
    <figure class="xpl-dyn__panel xpl-dyn__panel--strip">
      <figcaption>
        Energy drift
        <span class="xpl-dyn__legend">
          <span class="xpl-dyn__key"><i class="xpl-dyn__swatch xpl-dyn__swatch--e"></i><Math tex={m("|\\Delta E/E|")} /></span>
          <span class="xpl-dyn__val" data-drift>—</span>
          <button
            type="button"
            class="xpl-dyn__info"
            data-info="energy"
            aria-expanded="false"
            aria-label="About the energy drift trace"
          >?</button>
          <span class="xpl-dyn__popover" data-popover="energy" role="tooltip" hidden>
            Fractional energy error against the tolerance this run is checked at (the dashed line).
            A symplectic integrator's error does not run away, but it does not sit still either:
            measured on this cluster it climbs about three orders of magnitude in steps — each step
            a close encounter — and then holds at a few times
            <Math tex={m("10^{-4}")} />, well under the limit. If the trace crosses that line the
            arithmetic has stopped being trustworthy and nothing above it means anything.
            <br /><br />
            The reverse does not follow. A conserved energy says the integrator solved the equations
            it was given; it says nothing about whether those equations still describe a star
            cluster. See the note under the figure for where the model runs out.
            <br /><br />
            With gravity off the strip stays empty: there is no integrator running to make a claim
            about.
          </span>
        </span>
      </figcaption>
      <canvas data-energy aria-label="Fractional energy error against time"></canvas>
    </figure>
  </div>

  <noscript>
    <p class="xpl-dyn__noscript">
      This explorable integrates a star cluster in your browser, so it needs JavaScript. The
      physics it demonstrates is described in the text below.
    </p>
  </noscript>
</div>

<script>
  import {
    scenario,
    chooseIntegrator,
    createConservationMonitor,
    measure,
    lagrangianRadii,
    centreOfMass,
  } from "@novascope/core/dynamics";
  /*
   * The renderer is named directly, never through the `viz` barrel — the barrel
   * is three-free so the node gates can import the pure modules, exactly as
   * viz/starfield/index.ts documents for its own.
   *
   * `toRenderModel` is CENSUS'S selector, not a copy of it. Both pages get their
   * cluster's size, colour and alpha from that one function, which is what
   * "the ONE physics→pixel mapping" in state/render.ts means and what stops the
   * two clusters drifting into two different-looking objects.
   */
  import { createClusterPoints, type ClusterPoints } from "@novascope/viz/clusterPoints";
  import { toRenderModel } from "@novascope/state";
  /* Shared with the H–R diagram and the IMF histogram. AXIS_FONT is a LITERAL
     font string on purpose — see the note in axis.ts; this page is the reason it
     is there. */
  import { AXIS_FONT, niceTicks, drawPower } from "@novascope/viz/axis";

  const root = document.querySelector<HTMLElement>("[data-dyn]");
  if (root) {
    const $ = <T extends HTMLElement>(sel: string): T => root.querySelector<T>(sel)!;

    const field = $<HTMLCanvasElement>("[data-field]");
    const radiiCv = $<HTMLCanvasElement>("[data-radii]");
    const energyCv = $<HTMLCanvasElement>("[data-energy]");
    const nInput = $<HTMLInputElement>("[data-n]");
    const nVal = $<HTMLOutputElement>("[data-n-val]");
    const speedInput = $<HTMLInputElement>("[data-speed]");
    const speedVal = $<HTMLOutputElement>("[data-speed-val]");
    const playBtn = $<HTMLButtonElement>("[data-play]");
    const clockEl = $<HTMLElement>("[data-clock]");
    const hint = $<HTMLElement>("[data-hint]");
    const driftEl = $<HTMLElement>("[data-drift]");
    const scaleBar = root.querySelector<HTMLElement>("[data-scalebar]");
    /** Which evolution curve the shared plot canvas is showing. */
    let plotTab: "radii" | "bound" = "radii";
    const scaleLabel = root.querySelector<HTMLElement>("[data-scalelabel]");
    const summary = $<HTMLElement>("[data-summary]");

    const gravBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-grav]"));

    const setStat = (key: string, v: string) => {
      const el = summary.querySelector<HTMLElement>(`[data-v="${key}"]`);
      if (el) el.textContent = v;
    };

    /* ── state ─────────────────────────────────────────────────── */
    let gravity = false;
    let playing = false;
    let run: ReturnType<typeof build> | null = null;
    /* History of (t, r_h heavy, r_h light) and of fractional energy error. */
    let hist: { t: number; hi: number; lo: number; e: number; bm: number; bn: number }[] = [];
    /* Halving threshold, not a cap on the run: see the decimation in sample().
       600 samples is already ~4x the horizontal pixels of the plot at 1440px. */
    const MAX_SAMPLES = 600;
    /* A cluster property, not a per-star one — a coeval cluster is chemically
       uniform (explore-authoring rule 2). Solar; the dynamics scenario carries no
       composition of its own, so stating it here is stating an assumption rather
       than reading one. */
    const CLUSTER_Z = 0.02;
    /*
     * STEP SIZE, AND WHY IT IS t_cross/128 RATHER THAN /64.
     *
     * The scheme was never the problem — this page runs FSI4, fourth order and
     * symplectic, confirmed from the scenario's own `defaultScheme`. The step was.
     * Measured on this cluster, N = 400, worst |dE/E| over ten crossing times:
     *
     *   dt = t_cross/64    3.95e-4      <- what shipped
     *   dt = t_cross/128   7.46e-6      53x better
     *   dt = t_cross/256   2.91e-7
     *
     * A 53x gain for one halving is far steeper than the 16x a fourth-order scheme
     * gives in its asymptotic regime, which is the tell: /64 was not a slightly
     * coarse step, it was outside the range where the scheme's order applies at
     * all. /128 puts it back inside, and the error drops two orders below the
     * monitor's 1e-3 trust limit instead of sitting a factor of two under it.
     *
     * SUBSTEPS keeps the clock rate unchanged: two half-steps per frame advance
     * the same model time per frame as one whole one did, so the cluster evolves
     * at the pace it always did and only the cost goes up (2x the force
     * evaluations — measured in the browser before relying on it).
     */
    const STEP_DIVISOR = 128;
    const SUBSTEPS = 2;
    let hi0: number | null = null;
    let lo0: number | null = null;
    /** Elapsed model time [Myr]. Advanced by BOTH integration paths — see sample(). */
    let tSim = 0;
    /** Model time between STORED history samples; grows as the run outlives the buffer. */
    let storeEvery = 0;
    let lastStored = -Infinity;

    /* Bumped by "new draw" only. Reset keeps the seed, so "reset" means "same
       cluster from t=0" and "new draw" means "a different cluster" — two
       distinct things that were previously the same button twice. */
    let seed = 2026;

    function build() {
      const s = scenario("cluster");
      const built = s.build({ n: Number(nInput.value), seed });
      /*
       * The scenario's OWN default scheme, not a faster one chosen here.
       * Forcing leapfrog measured 1.3e-2 energy drift by ten crossing times —
       * past the monitor's 1e-3 tolerance, so `healthy` latched false and the
       * page's own "stop believing this" threshold had been crossed while the
       * page went on presenting the result. fsi4 holds 6e-5..3.8e-4 over the
       * same run with identical segregation. The scenario knows which schemes
       * are honest for its configuration; overriding that was the bug.
       */
      const picked = chooseIntegrator(built.state, built.force, {
        prefer: s.defaultScheme,
        maxStep: built.timeUnit / STEP_DIVISOR,
      });
      /* Mass split is fixed once per draw, so the two curves follow the SAME
         stars all run — a split recomputed each frame would track whichever
         stars happen to be heavy now and could not show sinking. */
      const idx = Array.from({ length: built.state.n }, (_, i) => i).sort(
        (a, b) => built.state.mass[b] - built.state.mass[a],
      );
      const nHeavy = Math.max(1, Math.round(idx.length * 0.1));
      const heavy = new Set(idx.slice(0, nHeavy));
      const light = new Set(idx.slice(Math.floor(idx.length * 0.5)));
      return {
        built,
        integrator: picked.integrator,
        monitor: createConservationMonitor(picked.integrator),
        heavy,
        light,
      };
    }

    /*
     * TIME IS THE PAGE'S OWN ACCUMULATOR; the monitor supplies the crossing-time
     * clock and the drift.
     *
     * It used to be the monitor's `s.t` for all three, on the reasoning that a
     * separate accumulator would be a second clock that could disagree. That was
     * right while the integrator was the only thing advancing the state — and it
     * broke the moment "no gravity" became free streaming, because that path
     * never calls `integrator.step()` and so never advances the monitor's `t`.
     * The symptom was the clock reading 0.0 Myr while the cluster visibly
     * dispersed, and the radius plot collapsing every sample onto t = 0.
     *
     * There is exactly one accumulator and both integration paths advance it by
     * the same dt, so the two cannot disagree. tCross and energyDrift still come
     * off the monitor, and both are only meaningful with gravity on.
     */
    function sample() {
      if (!run) return;
      const st = run.built.state;
      const s = run.monitor.sample();
      /*
       * BOUNDNESS IS A GRAVITY QUANTITY, so it is only measured when gravity is
       * acting. `measure` computes each star's energy against the force model's
       * potential; during free streaming that potential is not being integrated,
       * so a "bound fraction" there is a counterfactual — it answers "what would
       * be bound IF gravity were on", presented as a live property. (It also
       * costs two O(N^2) passes per frame in the one mode that needs none.)
       */
      const d = gravity ? measure(st, run.built.force, tSim) : null;
      /*
       * RADII ABOUT THE BOUND CLUSTER, AND OVER BOUND STARS ONLY.
       *
       * Both halves were wrong and both mattered by ~100 crossing times:
       *
       *  - About the ORIGIN, `lagrangianRadii` measured displacement as much as
       *    size. Momentum is conserved so the whole system's centre stays put, but
       *    the bound remnant recoils against its escapers: measured, |COM_bound|
       *    reaches 12.3 pc by 800 t_cross while r_h(heavy) read 11.6 pc.
       *
       *  - Over ALL members of a subset, the light curve became an escaper
       *    diagnostic. Measured at t/t_cr = 1064: r_h(light) = 92.7 pc unfiltered
       *    against 21.8 pc over bound light stars. Its late rise was half the
       *    light subset's mass sitting beyond 90 pc — stars that had left, not a
       *    cluster that had grown. `diagnostics.ts` documents this exact filtered
       *    call as the intended use.
       *
       * With gravity off there is no bound set and no cluster to centre on, so
       * both fall back to every star about the origin — which is the honest
       * description of a cloud that is simply dispersing.
       */
      const boundOnly = d ? (i: number) => d.bound[i] === 1 : null;
      const centre = d ? centreOfMass(st, boundOnly!).position : undefined;
      const inSet = (set: Set<number>) => (i: number) =>
        set.has(i) && (!boundOnly || boundOnly(i));
      const hi = lagrangianRadii(st, [0.5], inSet(run.heavy), centre)[0];
      const lo = lagrangianRadii(st, [0.5], inSet(run.light), centre)[0];
      /* Baseline on the FIRST sample so both curves start at exactly 1.
         Absolute r_h of the heaviest 10% is a ~40-star estimate and lands well
         off the light-star value at t=0 by sampling noise alone — measured 0.48
         vs 0.70 pc with no primordial segregation in the ICs at all
         (params.ts defaults segregation to 0). Plotting the raw radii would
         show the curves already apart before gravity had done anything, which
         reads as segregation that was imposed. The claim is about CHANGE, so
         the plot shows change; the absolute radii stay in the readout below. */
      if (hi0 === null) hi0 = hi || 1;
      if (lo0 === null) lo0 = lo || 1;
      /* Energy drift is a claim ABOUT THE INTEGRATOR, so it is only recorded
         while the integrator is running. Free streaming never calls it: the
         monitor would still difference kinetic against a potential nothing is
         solving, report a large and growing "drift", and the strip would tell the
         reader to stop believing a panel that is perfectly fine. NaN breaks the
         trace rather than drawing a false one — drawSeries already skips
         non-finite samples. */
      /*
       * KEEP THE WHOLE RUN AT UNIFORM RESOLUTION IN TIME.
       *
       * Two earlier versions of this were wrong, in opposite ways.
       *
       * `shift()` past 600 samples dropped the OLDEST point while the x-axis still
       * spanned 0..t_now, so the curve detached from the left edge and crawled
       * rightward across an empty plot.
       *
       * Halving the array (`filter(i % 2 === 0)`) was meant to fix that, and the
       * comment here claimed "the record thins, it does not truncate". THAT WAS
       * FALSE, and measurably so. Halving thins everything already stored while
       * fresh samples keep arriving at full rate, so a sample that has survived k
       * halvings sits at spacing 2^k while the newest sit at spacing 1 —
       * exponentially biased against the past. Simulated over the 72,300 frames of
       * an 821 Myr run: 600 samples retained, and the first EIGHTY PERCENT of the
       * timeline held exactly ONE of them, with a 789.7 Myr gap between the first
       * two. The plot drew a point at the origin, a straight line across most of
       * the run, and all of its detail in the last 4% — which is what "the energy
       * plot loses most of the line" was.
       *
       * The fix is to thin the INPUT as well as the record: store a sample only
       * every `storeEvery` of model time, and after each halving reset that
       * interval to the spacing the surviving samples actually have. The record
       * then stays uniform in time at every length, and the readouts below still
       * update every frame — only the history is thinned.
       */
      if (tSim - lastStored >= storeEvery) {
        hist.push({
          t: tSim,
          hi: hi / hi0,
          lo: lo / lo0,
          e: gravity ? s.energyDrift : NaN,
          /* Same rule as the drift: boundness is a gravity quantity, so with the
             force switched off there is nothing to record rather than a zero. */
          bm: d ? d.boundMassFraction : NaN,
          bn: d ? d.boundFraction : NaN,
        });
        lastStored = tSim;
      }
      if (hist.length > MAX_SAMPLES) {
        hist = hist.filter((_, i) => i % 2 === 0);
        const span = hist[hist.length - 1]!.t - hist[0]!.t;
        /* Measured from what survived, not doubled blindly, so the interval can
           never drift out of step with the array it is meant to describe. */
        storeEvery = hist.length > 1 ? span / (hist.length - 1) : storeEvery * 2;
      }

      setStat("t", tSim.toFixed(1));
      setStat("tcr", gravity ? s.tCross.toFixed(1) : "—");
      setStat("rhi", hi.toFixed(2));
      setStat("rlo", lo.toFixed(2));
      /*
       * BOTH FRACTIONS, because they disagree and the difference is the story.
       * `boundMassFraction` is the quantity the literature quotes and it is
       * dominated by a handful of heavy stars that stay put — measured 65% by mass
       * against 52.5% by NUMBER at the same instant, because the heaviest 40 carry
       * 61.7% of the cluster's mass. Labelled bare, the mass figure reads as "most
       * of the cluster is still there" while half the stars have gone.
       */
      /*
       * FOLLOW THE CLUSTER, BUT DO NOT CHASE IT.
       *
       * The camera was fixed at the t=0 framing, so the cluster expanded straight
       * out of frame: measured, 372 of 400 stars visible at t=0, 122 by 100
       * crossing times, and ONE by 700, while every readout went on describing it.
       *
       * Refitting EVERY frame would be the opposite error — a cluster that expands
       * by a factor of thirty would look motionless, with only the scale bar
       * moving, and the expansion is physics this page is meant to show. So the
       * frame only grows, only when the cluster is about to overflow it (15%
       * hysteresis), and the scale bar underneath reports what it did. Expansion
       * stays visible as stars spreading; the frame steps to keep them on screen.
       */
      const want = Math.max(hi, lo) * 2.5;
      if (want > frameR * 1.15 || want < frameR / 2.5) {
        frameR = want;
        points?.setFraming({ radiusPc: frameR });
      }
      /* Centre on the bound remnant every frame — it recoils, and following it is
         what keeps the thing being measured in the middle of the picture. */
      if (centre) points?.setFraming({ centre: Array.from(centre) });
      updateScaleBar();

      setStat("boundm", d ? (d.boundMassFraction * 100).toFixed(0) : "—");
      setStat("boundn", d ? (d.boundFraction * 100).toFixed(0) : "—");
      clockEl.textContent = `t = ${tSim.toFixed(1)} Myr`;
      driftEl.textContent = gravity ? s.energyDrift.toExponential(1) : "no integrator running";
      /* `healthy` latches false once drift has ever breached tolerance, so this
         cannot flicker back to reassuring after a bad excursion. */
      driftEl.classList.toggle("is-bad", gravity && !run.monitor.healthy);
    }

    /*
     * ADAPTIVE SCALE BAR — the thing that makes a moving frame honest.
     *
     * Same rule census uses in `renderClusterField`: pick a round length that is
     * about 22% of the frame, from a 1/2/5 ladder. Drawn as DOM rather than into
     * the canvas because the canvas is WebGPU and has no text; the HUD is already
     * an overlay, so it costs nothing extra.
     */
    const NICE_PC = [
      0.01, 0.02, 0.05, 0.1, 0.2, 0.5, 1, 2, 5, 10, 20, 50, 100, 200, 500, 1000,
    ];
    function updateScaleBar() {
      if (!points || !scaleBar) return;
      const cssPerPc = points.pxPerPc / Math.min(2, window.devicePixelRatio || 1);
      if (!(cssPerPc > 0)) return;
      const target = field.clientWidth * 0.22;
      let Lpc = NICE_PC[0]!;
      for (const c of NICE_PC) if (c * cssPerPc <= target) Lpc = c;
      scaleBar.style.inlineSize = `${(Lpc * cssPerPc).toFixed(1)}px`;
      if (scaleLabel) scaleLabel.textContent = Lpc >= 1 ? `${Lpc} pc` : `${Lpc} pc`;
    }

    /* ── drawing ───────────────────────────────────────────────── */
    const fit = (cv: HTMLCanvasElement) => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const r = cv.getBoundingClientRect();
      cv.width = Math.max(1, Math.round(r.width * dpr));
      cv.height = Math.max(1, Math.round(r.height * dpr));
      const ctx = cv.getContext("2d")!;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      return { ctx, w: r.width, h: r.height };
    };

    const css = (name: string, fb: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fb;

    /*
     * The cluster is drawn by `viz/clusterPoints` — three.js / WebGPU, the stack
     * ADR 0015 chose — fed by CENSUS'S OWN SELECTOR.
     *
     * Two separate things had to be right here, and conflating them cost a
     * session's worth of knob-turning:
     *
     * 1. THE STACK. The raw-WebGL engine sized its box from the 98th percentile
     *    of this cluster's radii, and the radial distribution has a heavy tail
     *    (p50 0.67 pc, p98 4.69, max 13.47), so the box came out at 15 pc and 400
     *    stars rendered as 87 resolvable blobs around a saturated core. ADR 0015
     *    records the same failure on the same engine family and defers the port
     *    until there is evidence; this was that evidence.
     *
     * 2. THE LOOK, which is NOT a property of the stack. `viz/starfield` draws a
     *    photograph — apparent size is the quad containing a real PSF — and no
     *    exposure setting turns that into census's diagram. Measured on this
     *    cluster, the photographic path drew the heaviest 10% at 19.4x the
     *    typical star (flares over an empty frame) and the unit-luminance path at
     *    1.7x (a flat haze with the segregation invisible).
     *
     * `toRenderModel` is the answer to (2) and it already existed. It is census's
     * selector, called here rather than reimplemented, so both pages' clusters
     * come from one law: sizePx from log-luminosity compressed into 0.6-5 px,
     * alpha floored at 0.55 so the faint majority never disappears, framing on
     * the 90th-percentile radius — which is, independently, the fix for (1).
     *
     * It also satisfies explore-authoring rule 1 by construction: `toRenderModel`
     * derives every star's state through `star()`, so nothing here reaches past
     * the contract.
     */
    let points: ClusterPoints | null = null;

    /**
     * The integrator's state as LatentStar[] — the shape `toRenderModel` takes.
     *
     * Z is the cluster's, not the star's: a coeval cluster is chemically uniform
     * (explore-authoring rule 2), which is also why it is not carried per particle
     * by the dynamics state.
     */
    function latentStars() {
      const st = run!.built.state;
      const out = [];
      for (let i = 0; i < st.n; i++) {
        out.push({
          id: i,
          mass: st.mass[i]!,
          Z: CLUSTER_Z,
          x: st.pos[3 * i]!,
          y: st.pos[3 * i + 1]!,
          z: st.pos[3 * i + 2]!,
          vx: st.vel[3 * i]!,
          vy: st.vel[3 * i + 1]!,
          vz: st.vel[3 * i + 2]!,
        });
      }
      return out;
    }

    /*
     * `toRenderModel` SORTS its output (painter's order, render.ts), so the model's
     * k-th star is NOT the k-th particle of the integrator state. `renderOrder[k]`
     * is the state index the k-th drawn instance belongs to.
     *
     * THIS IS THE MAPPING THAT WAS MISSING, and its absence was the worst bug on
     * the page. `positions()` returned `st.pos` in state order while the renderer
     * had packed sizes and colours in SORTED order, so every frame each instance
     * was moved to a different star's position. Measured: 400 of 400 instances
     * mismatched, mean displacement 1.51 pc on a cluster with r_h = 0.55 pc. The
     * biggest, bluest points were drawn wherever, which means "the heaviest stars
     * sink" — the entire claim of this page — was never visible in the canvas,
     * from the first frame.
     *
     * It was invisible to me because the frame still looked like a plausible
     * cluster: the right stars with the wrong coordinates is a correct-looking
     * picture of nothing.
     */
    let renderOrder: number[] = [];
    /** Half-width of the view [pc], grown to follow the cluster — see sample(). */
    let frameR = 0;

    /* t = 0 always: at this rung a star MOVES but does not evolve, so asking
       toRenderModel for an age would claim evolution the backend cannot compute.
       The page says so in as many words. */
    function renderModel() {
      const model = toRenderModel(latentStars(), { t: 0, selectedId: null, toggles: {} });
      renderOrder = model.stars.map((st) => st.id); // latentStars() sets id = state index
      return model;
    }

    function positions(): Float32Array {
      const st = run!.built.state;
      const out = new Float32Array(renderOrder.length * 3);
      for (let k = 0; k < renderOrder.length; k++) {
        const i = renderOrder[k]!;
        out[3 * k] = st.pos[3 * i]!;
        out[3 * k + 1] = st.pos[3 * i + 1]!;
        out[3 * k + 2] = st.pos[3 * i + 2]!;
      }
      return out;
    }

    function mountField() {
      if (!run) return;
      /* Synchronous now, so the async mount token that guarded reset / new draw /
         the N slider racing each other is gone with it. */
      if (points) {
        points.setModel(renderModel());
        return;
      }
      /*
       * NO CAMERA DRIFT (the default, stated here because it is a claim). Every
       * pixel of motion on this page has to be attributable to gravity; a turning
       * camera would make "the massive stars sink" ambiguous with "the view
       * moved". Dragging still orbits.
       */
      points = createClusterPoints(field, renderModel(), {
        drifting: false,
        /* pxPerPc is a placeholder until the device is up; the scale bar has to
           wait for it or it reports the placeholder's scale. */
        onReady: updateScaleBar,
      });
    }

    /*
     * Plot margins, sized for AXIS_FONT (14px) rather than for the 9px these were
     * cut for — which never rendered anyway, so the old 34/18 was reserving room
     * for a label size that did not exist. Left has to clear "1.00"-width labels
     * at 14px; bottom has to clear one line plus its gap.
     */
    const AX = { l: 64, r: 14, t: 12, b: 32 };
    /** Decades shown below a log axis's threshold — see the floor in drawSeries. */
    const LOG_DECADES = 5;

    function drawSeries(
      cv: HTMLCanvasElement,
      series: { get: (p: (typeof hist)[number]) => number; colour: string; dash: number[] }[],
      opts: {
        zeroBase?: boolean;
        refOne?: boolean;
        fmt?: (v: number) => string;
        /**
         * A FIXED reference the axis must always contain, drawn as a line.
         *
         * Without one an autoscaled axis rescales to whatever the data does, so a
         * trace can never leave the frame — which made the energy strip's own note
         * ("if this walks steadily off the strip, stop believing the panel above
         * it") describe something the plot could not show. Pinning the axis to the
         * monitor's tolerance makes "off the strip" mean the same thing the
         * `healthy` verdict means, so the picture and the readout cannot disagree.
         */
        threshold?: { value: number; colour: string; label: string };
        /**
         * Plot log10(value) instead of the value.
         *
         * Energy drift spans DECADES — measured on this cluster it runs from below
         * 1e-7 early to a few times 1e-4 by ten crossing times — and the axis is
         * pinned to a 1e-3 trust limit. On a linear scale that put the entire trace
         * inside 4 pixels of a 276-pixel plot, hard against the bottom axis, which
         * reads exactly like a plot that has lost its history. It had not: 2,266 of
         * 2,428 columns carried trace pixels. The scale was wrong, not the record.
         *
         * `/dynamics-lab` plots the same quantity on fixed decades for the same
         * reason. Non-positive samples are dropped rather than clamped — log of a
         * zero drift is not a small number, it is not a number.
         */
        logY?: boolean;
        /** Pin the y-axis. A fraction plot must not autoscale — 0 and 1 are the
         *  meaningful ends, and a curve that never leaves 0.6-1.0 would otherwise
         *  be drawn as though it had swung across the whole panel. */
        fixed?: [number, number];
      } = {},
    ) {
      const { ctx, w, h } = fit(cv);
      ctx.clearRect(0, 0, w, h);
      const ink = css("--ink-faint", "#8b8f9a");
      const grid = css("--bg-hairline", "#2b2d38");
      const fmt = opts.fmt ?? ((v: number) => (Math.abs(v) >= 100 ? v.toFixed(0) : v.toFixed(2)));

      const tMax = hist.length > 1 ? hist[hist.length - 1].t || 1 : 1;
      /* The one place the log transform is applied. Everything downstream — the
         extent, the ticks, the threshold and the polyline — works in plotted
         units, so the two scales cannot disagree about where a value sits. */
      const toPlot = (v: number): number =>
        opts.logY ? (v > 0 ? Math.log10(v) : NaN) : v;
      let lo = Infinity;
      let hiV = -Infinity;
      for (const p of hist)
        for (const sr of series) {
          const v = toPlot(sr.get(p));
          if (Number.isFinite(v)) {
            lo = Math.min(lo, v);
            hiV = Math.max(hiV, v);
          }
        }
      if (opts.zeroBase && !opts.logY) lo = Math.min(lo, 0);
      if (opts.refOne) {
        lo = Math.min(lo, 1);
        hiV = Math.max(hiV, 1);
      }
      if (opts.threshold) {
        const tv = toPlot(opts.threshold.value);
        if (Number.isFinite(tv)) {
          lo = Math.min(lo, tv);
          hiV = Math.max(hiV, tv);
          /*
           * FLOOR THE RANGE at a fixed number of decades below the limit.
           *
           * A log axis autoscaled to its data is at the mercy of its smallest
           * sample, and the first few drifts of a fresh run are near machine
           * precision — one of them would stretch the axis to a dozen decades and
           * squash the part anyone cares about into a sliver, which is the same
           * failure the linear axis had, mirrored. Anchoring the bottom to the
           * trust limit also makes the plot's shape comparable between runs
           * instead of rescaling under you every time.
           */
          if (opts.logY) lo = Math.max(lo, tv - LOG_DECADES);
        }
      }
      if (!Number.isFinite(lo) || !Number.isFinite(hiV)) {
        lo = 0;
        hiV = 1;
      }
      if (opts.fixed) {
        lo = opts.fixed[0];
        hiV = opts.fixed[1];
      }
      if (hiV === lo) hiV = lo + 1;
      if (!opts.fixed) {
        const pad = (hiV - lo) * 0.08;
        lo -= pad;
        hiV += pad;
      }

      const X = (t: number) => AX.l + (t / tMax) * (w - AX.l - AX.r);
      const Y = (v: number) => h - AX.b - ((v - lo) / (hiV - lo)) * (h - AX.t - AX.b);

      ctx.font = AXIS_FONT;
      ctx.fillStyle = ink;
      ctx.strokeStyle = grid;
      ctx.lineWidth = 1;

      for (const v of niceTicks(lo, hiV)) {
        const y = Y(v);
        ctx.beginPath();
        ctx.moveTo(AX.l, y);
        ctx.lineTo(w - AX.r, y);
        ctx.stroke();
        ctx.textAlign = "right";
        ctx.textBaseline = "middle";
        if (opts.logY) {
          /* 10^x with a raised exponent — the same helper the H–R diagram and the
             IMF histogram label their decades with. */
          drawPower(ctx, v, AX.l - 8, y, "right", ink);
          ctx.font = AXIS_FONT;
        } else {
          ctx.fillText(fmt(v), AX.l - 8, y);
        }
      }
      /* Vertical gridlines too, as the H–R diagram has: reading a time off a plot
         with horizontal rules only means tracking across bare space. */
      for (const t of niceTicks(0, tMax, 4)) {
        const x = X(t);
        ctx.beginPath();
        ctx.moveTo(x, AX.t);
        ctx.lineTo(x, h - AX.b);
        ctx.stroke();
        ctx.textAlign = "center";
        ctx.textBaseline = "top";
        ctx.fillText(t.toFixed(t < 10 ? 1 : 0), x, h - AX.b + 8);
      }
      /* Axis frame, matching renderHR's strokeRect — it separates the plotting
         area from the panel, which matters now that both panels have a filled
         background rather than the transparent one this file wrongly attributed
         to census. */
      ctx.strokeStyle = css("--border", "#2a2c31");
      ctx.strokeRect(AX.l, AX.t, w - AX.l - AX.r, h - AX.t - AX.b);
      ctx.strokeStyle = grid;

      if (opts.threshold) {
        const { value, colour, label } = opts.threshold;
        ctx.save();
        ctx.setLineDash([5, 4]);
        ctx.strokeStyle = colour;
        ctx.lineWidth = 1.25;
        ctx.beginPath();
        ctx.moveTo(AX.l, Y(toPlot(value)));
        ctx.lineTo(w - AX.r, Y(toPlot(value)));
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = colour;
        ctx.textAlign = "left";
        ctx.textBaseline = "bottom";
        ctx.fillText(label, AX.l + 6, Y(toPlot(value)) - 3);
        ctx.restore();
        ctx.fillStyle = ink;
      }

      if (opts.refOne) {
        ctx.save();
        ctx.setLineDash([2, 3]);
        ctx.strokeStyle = ink;
        ctx.beginPath();
        ctx.moveTo(AX.l, Y(1));
        ctx.lineTo(w - AX.r, Y(1));
        ctx.stroke();
        ctx.restore();
      }

      if (hist.length < 2) return;
      for (const sr of series) {
        ctx.beginPath();
        ctx.setLineDash(sr.dash);
        ctx.strokeStyle = sr.colour;
        ctx.lineWidth = 1.6;
        let started = false;
        for (const p of hist) {
          const raw = toPlot(sr.get(p));
          if (!Number.isFinite(raw)) continue;
          /* Clamped to the floor, not dropped: a sample quieter than the axis
             bottom is still a sample, and dropping it would break the trace into
             segments that look like missing history. */
          const v = Math.max(raw, lo);
          if (!started) {
            ctx.moveTo(X(p.t), Y(v));
            started = true;
          } else ctx.lineTo(X(p.t), Y(v));
        }
        ctx.stroke();
      }
      ctx.setLineDash([]);
    }

    const drawPlots = () => {
      const rose = css("--spec-rose-bright", "#e58fb4");
      const teal = css("--spec-teal-bright", "#4fd6c4");
      if (plotTab === "bound") {
        /* Fractions, so the axis is PINNED to 0..1. Autoscaled, a run that never
           left 0.6-1.0 would be drawn as though it had swung across the whole
           panel, and the one number that matters — how far from 1 — would be
           unreadable. */
        drawSeries(
          radiiCv,
          [
            { get: (p) => p.bm, colour: rose, dash: [] },
            { get: (p) => p.bn, colour: teal, dash: [4, 3] },
          ],
          { fixed: [0, 1], fmt: (v) => v.toFixed(1) },
        );
      } else {
        drawSeries(
          radiiCv,
          [
            { get: (p) => p.hi, colour: rose, dash: [] },
            { get: (p) => p.lo, colour: teal, dash: [4, 3] },
          ],
          { refOne: true },
        );
      }
      /* The tolerance comes from the MONITOR, not from a number typed here — it is
         the same value `healthy` latches on, so the line a reader sees and the
         verdict the page reports cannot drift apart. */
      const tol = run?.monitor.energyTolerance;
      drawSeries(energyCv, [{ get: (p) => p.e, colour: css("--spec-amber", "#fbbf24"), dash: [] }], {
        logY: true,
        ...(tol
          ? { threshold: { value: tol, colour: css("--spec-rose-bright", "#e58fb4"), label: "trust limit" } }
          : {}),
      });
    };

    const redraw = () => {
      points?.setPositions(positions());
      drawPlots();
      updateScaleBar(); // zoom and resize both change it without a physics step
    };

    /* ── loop ──────────────────────────────────────────────────── */
    /*
     * Cancelled on pause, when the page is hidden, and when the engine scrolls
     * out of view. The dynamics LAB re-schedules unconditionally and never
     * stops — tolerable on an unlinked development surface, not on a page a
     * reader leaves open in a background tab.
     */
    let raf = 0;
    let onScreen = true;

    /*
     * FREE STREAMING — what "no gravity" actually looks like.
     *
     * This used to hold the cluster STATIC, on the reasoning that a zero-force
     * model would have to be invented. It does not: removing the mutual force
     * leaves `x += v dt`, which is exact, and the stars already carry the
     * velocities the initial conditions drew for them. So a cluster without
     * gravity is not a still image — it disperses in straight lines, because
     * nothing is holding it together.
     *
     * That mistake is what made the toggle useless. "Static" is indistinguishable
     * from "paused", so the page had two controls doing one thing, and the button
     * marked run had to override the toggle to do anything at all. The physical
     * answer removes the redundancy instead of papering over it — and it is the
     * page's own title: take the coupling away and there is no cluster.
     */
    function drift(dt: number) {
      const st = run!.built.state;
      for (let i = 0; i < st.n * 3; i++) st.pos[i] += st.vel[i] * dt;
    }

    function frame() {
      raf = 0;
      if (!run || !playing) return;
      const dt = (run.built.timeUnit / STEP_DIVISOR) * Number(speedInput.value);
      for (let k = 0; k < SUBSTEPS; k++) {
        if (gravity) run.integrator.step(dt);
        else drift(dt);
        tSim += dt;
      }
      sample();
      redraw();
      if (playing && onScreen && !document.hidden) raf = requestAnimationFrame(frame);
    }

    const start = () => {
      if (!raf && playing && onScreen && !document.hidden) raf = requestAnimationFrame(frame);
    };
    const stop = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    };

    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
    new IntersectionObserver((entries) => {
      onScreen = entries[0]?.isIntersecting ?? true;
      onScreen ? start() : stop();
    }).observe(root);

    /* ── wiring ────────────────────────────────────────────────── */
    const syncPlay = () => {
      playBtn.textContent = playing ? "❙❙ pause" : "▶ run";
      playBtn.classList.toggle("is-active", playing);
      /*
       * The line says WHAT IS HAPPENING, not what mode is selected — the toggle
       * beneath it already shows the mode, and a hint that only restated it was
       * the reason "frozen as drawn" meant nothing to anyone but its author.
       */
      hint.textContent = playing
        ? gravity
          ? "every star pulling on every other"
          : "no gravity — the stars just keep going"
        : gravity
          ? "paused — press run to integrate"
          : "paused — press run to let them drift apart";
    };

    const rebuild = () => {
      stop();
      run = build();
      hist = [];
      mountField();
      hi0 = null;
      lo0 = null;
      frameR = 0;
      /* Reset, new draw, an N change and a gravity switch all mean "start over",
         and the VIEW is part of the state you started over from — a zoom left
         from the last look would otherwise silently reframe the new run. */
      points?.setZoom(1);
      tSim = 0;
      storeEvery = 0;
      lastStored = -Infinity;
      playing = false;
      sample();
      redraw();
      syncPlay();
    };

    playBtn.addEventListener("click", () => {
      /*
       * Run RUNS THE CLOCK. It does not choose the physics.
       *
       * It has been wrong in both directions. First it was DISABLED while gravity
       * was off, so the page's primary action did nothing on arrival and gave no
       * reason why. The fix for that was to have it silently switch gravity on —
       * which then overrode the reader's own choice, and contradicted the page
       * body's instruction to start with gravity off and watch. Now that "off"
       * integrates something worth watching, run needs to do neither.
       */
      playing = !playing;
      syncPlay();
      playing ? start() : stop();
    });

    $<HTMLButtonElement>("[data-reset]").addEventListener("click", rebuild);
    $<HTMLButtonElement>("[data-reseed]").addEventListener("click", () => {
      seed += 1;
      rebuild();
    });

    function setGravity(on: boolean) {
      gravity = on;
      for (const o of gravBtns) {
        const active = (o.dataset.grav === "on") === on;
        o.classList.toggle("is-active", active);
        o.setAttribute("aria-pressed", String(active));
      }
      syncPlay();
    }

    /*
     * CHANGING THE PHYSICS RESTARTS THE RUN, from the same seed and therefore the
     * same initial conditions.
     *
     * It did not, and that produced two wrong pictures at once. The natural path
     * through this page is: arrive with gravity off, press run, watch the cluster
     * disperse, then switch gravity on. Before this:
     *
     *  - Every free-streaming sample stored `e: NaN`, so the energy trace began
     *    only where gravity was switched on while the x-axis still spanned from
     *    t = 0 — the trace occupied a sliver at the late end of an otherwise empty
     *    plot, which is what "the data does not persist" looked like. The record
     *    was complete; the run it described had simply not started yet.
     *
     *  - Worse, `energyDrift` is |E - E0|/|E0| against the energy captured when
     *    the monitor was built. Free streaming moves every star with no force
     *    integration, so the potential changes while the kinetic energy does not:
     *    the total is genuinely different by the time gravity comes on, and the
     *    "drift" then reported was that difference rather than any integrator
     *    error. A trust readout measuring the wrong thing is worse than none.
     *
     *  - And the r_h curves were normalised to hi0/lo0 from the free-streaming
     *    phase, so the two modes were spliced into one trace as though they were
     *    one experiment.
     *
     * Restarting makes each mode a controlled experiment against identical ICs,
     * which is exactly what the page's own copy asks the reader to do ("switch to
     * N-body and run it again from the start"). The clock keeps running if it was
     * running, so flipping the toggle plays the other experiment immediately
     * rather than making you press run again.
     */
    function selectGravity(on: boolean) {
      if (on === gravity) return;
      const wasPlaying = playing;
      setGravity(on); // mode + button state; rebuild touches neither
      rebuild(); // same seed => same initial conditions; fresh monitor, clock and history
      if (wasPlaying) {
        playing = true;
        syncPlay();
        start();
      }
    }

    for (const b of gravBtns) {
      b.addEventListener("click", () => selectGravity(b.dataset.grav === "on"));
    }

    nInput.addEventListener("input", () => {
      nVal.value = nInput.value;
    });
    nInput.addEventListener("change", rebuild);
    speedInput.addEventListener("input", () => {
      speedVal.value = Number(speedInput.value).toFixed(2);
    });


    /*
     * The "?" notes, census's pattern. Open one at a time, close on Escape or on
     * a click outside — a tooltip that can only be dismissed by finding the same
     * small button again is a trap, and there are two of them on this page.
     */
    const infoBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-info]"));
    const closeInfo = (except?: string) => {
      for (const b of infoBtns) {
        const key = b.dataset.info!;
        if (key === except) continue;
        b.setAttribute("aria-expanded", "false");
        const pop = root.querySelector<HTMLElement>(`[data-popover="${key}"]`);
        if (pop) pop.hidden = true;
      }
    };
    for (const b of infoBtns) {
      b.addEventListener("click", (e) => {
        e.stopPropagation();
        const key = b.dataset.info!;
        const pop = root.querySelector<HTMLElement>(`[data-popover="${key}"]`);
        if (!pop) return;
        const open = pop.hidden;
        closeInfo(key);
        pop.hidden = !open;
        b.setAttribute("aria-expanded", String(open));
      });
    }
    document.addEventListener("click", () => closeInfo());
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeInfo();
    });

    /* Zooming changes the scale with no physics step behind it, and while paused
       nothing else would redraw the bar. rAF so the renderer's own wheel handler
       has already applied the new zoom by the time this reads pxPerPc. */
    field.addEventListener("wheel", () => requestAnimationFrame(updateScaleBar), { passive: true });

    /* Tabs swap the SERIES, the legend, the y-title and the note together — one
       state, four things that must agree, so they are set in one place. */
    for (const b of root.querySelectorAll<HTMLButtonElement>("[data-plot-tab]")) {
      b.addEventListener("click", () => {
        plotTab = (b.dataset.plotTab as "radii" | "bound") ?? "radii";
        for (const o of root.querySelectorAll<HTMLButtonElement>("[data-plot-tab]")) {
          const on = o === b;
          o.classList.toggle("is-active", on);
          o.setAttribute("aria-pressed", String(on));
        }
        for (const el of root.querySelectorAll<HTMLElement>("[data-legend]"))
          el.hidden = el.dataset.legend !== plotTab;
        for (const el of root.querySelectorAll<HTMLElement>("[data-ytitle]"))
          el.hidden = el.dataset.ytitle !== plotTab;
        for (const el of root.querySelectorAll<HTMLElement>("[data-note]"))
          el.hidden = el.dataset.note !== plotTab;
        drawPlots();
      });
    }

    window.addEventListener("resize", redraw);
    rebuild();
  }
</script>

<style>
  /* Capped like census's root, which is what turns the top row into near-squares
     instead of letting the two panels stretch on a wide screen. */
  .xpl-dyn {
    display: grid;
    max-inline-size: 76rem;
    margin-inline: auto;
  }
  .xpl-dyn__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m);
    align-items: stretch; /* each row's two cells match height → columns align */
  }
  /*
   * Census's panel treatment, read from its stylesheet rather than remembered.
   * The note that used to sit here claimed census's figure panels are
   * "TRANSPARENT with zero padding"; they are not — `.xpl-census__panel` carries
   * a radial-gradient background and `overflow: hidden`, and that mistaken note
   * is why these two pages never looked like siblings.
   */
  .xpl-dyn__panel {
    margin: 0;
    padding: 0;

    align-items: center;
    gap: var(--space-2xs);
    flex-wrap: wrap;
  }
  .xpl-dyn__key {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    white-space: nowrap;
  }
  /* Drawn from the SAME tokens the canvas reads through css(), so the key cannot

    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    overflow: hidden;
    transition: border-color var(--dur-base) var(--ease-out);
  }
  /* Flat surface, not the gradient — census's control panel is the one box that
     reads as a console rather than an instrument. */
  .xpl-dyn__panel--pad {
    padding: var(--space-s);
    background: var(--bg-surface);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .xpl-dyn__panel--strip {
    grid-column: 1 / -1;
  }
  /* Census's caption bar: a titled header rule, not a floating line of text. */
  .xpl-dyn__panel figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--1);

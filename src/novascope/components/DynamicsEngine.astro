  }
  @media (max-width: 52rem) {
    .xpl-dyn__controls { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /*
   * Label ABOVE the slider, not beside it.
   *
   * Inline, five controls across the console left 73 px of travel each — and r_h
   * steps 0.05 across 0.3-5 pc, so that is 94 steps in 73 px, under a pixel
   * apiece. Stacking gives the full ~205 px of cell width to the track and costs
   * about 16 px of figure height, which is the right way round: the row is still
   * one row, each cell is just two lines.
   */
  .xpl-dyn__ctrl {
    display: grid;
    gap: 1px;
    min-inline-size: 0;
    font-size: var(--step--2);
    color: var(--ink-soft);
  }

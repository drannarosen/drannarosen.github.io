  /*
   * FIXED, and positioned by JS — see `placePopover`.
   *
   * Absolute positioning put it inside `.xpl-dyn__panel`, which carries
   * `overflow: hidden` to clip the canvas to the border radius. Measured on the
   * concentration note: the popover ran from x=31 to x=447 while its panel began
   * at x=208, so 177 px of it was cut off. An earlier check of mine tested only
   * whether the TOP edge escaped and reported it fine, which is why this shipped.
   *
   * Fixed takes it out of the panel's clipping context altogether, so no note can
   * ever be trimmed by the box it happens to live in — and the placement can then
   * flip and clamp against the VIEWPORT, which is the thing that actually
   * constrains it.
   */
  .xpl-dyn__popover {
    position: fixed;
    z-index: 20;
    inline-size: min(26rem, 70vw);
    padding: var(--space-2xs) var(--space-s);
    border: 1px solid color-mix(in srgb, var(--spec-teal) 30%, var(--border));
    border-radius: var(--radius-m);
    background: color-mix(in srgb, var(--bg-surface) 94%, black);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.45);

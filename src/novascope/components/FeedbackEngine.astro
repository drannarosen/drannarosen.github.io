---
/*
 * FeedbackEngine — the /explore/feedback-budget explorable.
 *
 * Renders a gravoturb cluster and, beside it, the feedback ACCOUNTING: two
 * ratio bars (momentum delivered vs the gas threshold, energy vs binding), the
 * two-stage gas-expulsion verdict, and (collapsed) the per-channel
 * momentum-vs-time plot.
 *
 * Two deliberately SEPARATE axes: the scrub is expulsion PROGRESS (embedded →
 * cleared) driving the outward gas render (setExpel), because the gas clears
 * early in the window and time would make a blink-and-miss animation. (How
 * early is environment- and prescription-dependent — re-measured 2026-09-04
 * under the Björklund default, t_remove is 5.2% of the window for `diffuse`,
 * 42.5-46.7% for the Orion-like set, and `compact` never reaches the threshold
 * at all. This comment said "~10%" as though it were a property of the engine;
 * it was the Orion-like case alone. The 2026-08-09 figures it then carried —
 * 6.2% / ~14% / 54% — were themselves superseded by the re-sampled export, so
 * this is the second time this sentence has gone stale by being written down
 * instead of derived.)
 *
 * The real-time story -- how fast, which channel leads -- lives in the plot,
 * with t_remove marked. The bars and verdict are the accounting the spectacle
 * exists to make legible.
 *
 * Data flow: viz/loadScene + createCloudScene render the cloud; state/feedback runs
 * the Layer-0 budget. The two share the browser-cached fetches but nothing else,
 * keeping the import boundary intact.
 */
import PresentFrame from "../../components/explore/PresentFrame.astro";
import RatioBar from "./RatioBar.astro";
import Math from "../../components/Math.astro";
const m = (tex: string) => tex;
---

<div class="fbe" data-fbe>
  {/*
    TYPESET ONCE AT BUILD, CLONED BY THE SCRIPT — the same arrangement
    DynamicsEngine uses, and for the same reason. The verdict line, the ratio
    readouts and the stat list are assembled in JS, so they cannot use `<Math>`
    inline the way static copy can. Unicode (M⊙, Σ, ψ, ×) is not the same
    typography as the rest of the page and breaks as soon as a symbol needs an
    exponent outside the superscript block; importing KaTeX into the client
    would ship ~270 kB to typeset a handful of glyphs.

    So they are rendered here, hidden, at build time, and `tex()` copies the
    HTML. Zero bundle cost, and identical KaTeX to the rest of the site by
    construction.
  */}
  <div class="fbe__texlib" hidden aria-hidden="true">
    <span data-tex="times"><Math tex={m("\\times")} /></span>
    <span data-tex="msun"><Math tex={m("M_\\odot")} /></span>
    <span data-tex="sigma"><Math tex={m("\\Sigma")} /></span>
    <span data-tex="sigmaunit"><Math tex={m("M_\\odot\\,\\mathrm{pc}^{-2}")} /></span>
    <span data-tex="psi"><Math tex={m("\\psi")} /></span>
    <span data-tex="rch"><Math tex={m("r_\\mathrm{ch}")} /></span>
    <span data-tex="mgas"><Math tex={m("M_\\mathrm{gas}")} /></span>
    <span data-tex="pc"><Math tex={m("\\mathrm{pc}")} /></span>
    <span data-tex="cf"><Math tex={m("C_f")} /></span>
    <span data-tex="approx"><Math tex={m("\\approx")} /></span>
    <span data-tex="arrow"><Math tex={m("\\rightarrow")} /></span>
  </div>
  <PresentFrame
    label="A star cluster and its feedback budget"
    hint="drag to rotate · scroll to zoom · ←/→ steps through time · space steps · F fullscreen"
  >
    <canvas slot="stage" data-cluster aria-label="A young star cluster embedded in its natal gas."></canvas>

    <div slot="controls" class="fbe__controls">
      {/*
        THREE TIERS, not one flat column. Twenty controls at equal visual weight
        made "which cloud am I looking at" (the comparison the page is for) look
        exactly like "what covering fraction should the shell have" (a parameter
        most readers should never touch). The order is the order of the
        questions: which cloud, then when, then which channel, then — folded
        away — the modelling choices behind the numbers.
      */}

      {/* 1 ── WHICH CLOUD. The comparison; the only control that changes the data. */}
      <div class="fbe__tier fbe__tier--env">
        <span class="fbe__tier-lead">environment</span>
        <div class="fbe__pills" data-realizations role="group" aria-label="Choose an environment">
          <!-- realization pills injected from the manifest -->
        </div>
      </div>

      {/* 2 ── WHEN. Time drives the gas through the ledger, so this is the axis
              everything else is read against. */}
      <div class="fbe__tier fbe__tier--time">
        <button type="button" class="fbe__action" data-play aria-pressed="false">▶ play</button>
        <label class="fbe__scrub">
          <span class="fbe__scrub-head">
            <span class="fbe__cleared" data-cleared>embedded</span>
            <span class="fbe__endpts">0 <Math tex={m("\\rightarrow")} /> first supernova</span>
          </span>
          <input type="range" min="0" max="1" step="0.005" value="0" autocomplete="off"
                 data-scrub aria-label="Time through the pre-supernova window" />
        </label>
      </div>

      {/* 3 ── WHICH CHANNEL. Stays visible: this is the page's heartbeat, the
              toggle that visibly stalls the gas. */}
      <div class="fbe__tier fbe__tier--ch">
        <span class="fbe__tier-lead">channels</span>
        <div class="fbe__chiprow" role="group" aria-label="Feedback channels — turn one off to see what it was carrying">
          <button type="button" class="fbe__chip is-active" data-ch="winds" aria-pressed="true">winds</button>
          <button type="button" class="fbe__chip is-active" data-ch="photoionization" aria-pressed="true">H II</button>
          <button type="button" class="fbe__chip is-active" data-ch="radiation" aria-pressed="true">radiation</button>
        </div>
        <p class="fbe__chnote" data-chnote hidden></p>
      </div>

      {/* 4 ── THE MODELLING CHOICES, folded. Not hidden because they are
              unimportant — the prose calls two of them the least certain things
              in the accounting — but because a reader meeting this page should
              not have to decide about a covering fraction before they have seen
              the gas move. `data-nondefault` surfaces above whenever any of
              these leaves its default, so folding cannot hide a changed state. */}
      <details class="fbe__adv">
        <summary class="fbe__adv-summary">
          <span>model settings</span>
          <span class="fbe__adv-hint">wind recipe · shell covering · H II leakage · coupling</span>
        </summary>

        <div class="fbe__tier">
          <span class="fbe__tier-lead">wind recipe</span>
          <div class="fbe__chiprow" role="group" aria-label="Mass-loss prescription">
            <button type="button" class="fbe__chip is-active" data-presc="bjorklund" aria-pressed="true">Björklund 2023</button>
            <button type="button" class="fbe__chip" data-presc="vink" aria-pressed="false">Vink 2001</button>
          </div>
        </div>

        <div class="fbe__knobs">
          <label class="fbe__knob">
            <span class="fbe__knob-head">
              <span>shell covering <Math tex={m("C_f")} /></span>
              <output data-cf-out>0.50</output>
            </span>
            <input type="range" min="0" max="1" step="0.01" value="0.5" autocomplete="off"
                   data-cf aria-label="Shell covering fraction C_f" />
            <span class="fbe__knob-foot">porous ← → sealed</span>
          </label>

          <label class="fbe__knob">
            <span class="fbe__knob-head">
              <span>H II leakage</span>
              <output data-hii-out>0.50</output>
            </span>
            <input type="range" min="0" max="1" step="0.01" value="0.5" autocomplete="off"
                   data-hii aria-label="H II leakage fraction" />
            <span class="fbe__knob-foot">confined ← → champagne flow</span>
          </label>
        </div>

        <div class="fbe__tier">
          <span class="fbe__tier-lead">coupling</span>
          <div class="fbe__chiprow" role="group" aria-label="How shell porosity couples to the wind">
            <button type="button" class="fbe__chip is-active" data-coup="simple" aria-pressed="true"><Math tex={m("f_\\mathrm{vent} = 1 - C_f")} /></button>
            <button type="button" class="fbe__chip" data-coup="km09" aria-pressed="false">KM09 porous</button>
            <button type="button" class="fbe__chip" data-coup="independent" aria-pressed="false">uncoupled</button>
          </div>
        </div>
      </details>

      <p class="fbe__status" data-status aria-live="polite">Loading cluster…</p>
    </div>
  </PresentFrame>

  <div class="fbe__panel">
    {/* The prose under the figure describes the DEFAULTS. When the reader moves
        off them the numbers here stop matching that prose, so the panel says so
        rather than letting the two silently disagree. */}
    <p class="fbe__nondefault" data-nondefault hidden></p>

    {/* Polite live region: these two lines ARE the answer, and they are rewritten
        on every knob change. Without this a screen-reader user could move a
        control and get no feedback that anything had happened. */}
    <div class="fbe__verdict" data-verdict role="status" aria-live="polite">
      <p class="fbe__stage fbe__stage--1" data-stage1>—</p>
      <p class="fbe__stage fbe__stage--2" data-stage2>—</p>
    </div>

    <div class="fbe__bars">
      <RatioBar
        id="momentum"
        label="Momentum delivered"
        thresholdLabel="expel the gas"
        ariaLabel="Feedback momentum delivered, relative to the momentum needed to expel the residual gas."
      />
      <RatioBar
        id="energy"
        label="Energy retained"
        thresholdLabel="unbind"
        ariaLabel="Feedback energy retained, relative to the cloud's binding energy."
      />
    </div>

    <details class="fbe__more">
      <summary>components over time</summary>
      <figure class="fbe__plot">
        <svg data-plot viewBox="0 0 340 170" preserveAspectRatio="xMidYMid meet" role="img"
          aria-label="Momentum delivered by each feedback channel versus time.">
        </svg>
        <figcaption class="fbe__legend" data-legend></figcaption>
      </figure>
      <dl class="fbe__nums" data-nums></dl>
    </details>
  </div>
</div>

<script>
  import { loadScene } from "../viz/webgl/scene.ts";
  import { createCloudScene } from "../viz/cloudScene.ts";
  import { loadFeedbackRealization, recomputeFeedback, type FeedbackRealization }
    from "../state/feedback";
  import { decode, encode } from "../core/params/urlState.ts";
  import {
    FEEDBACK_SCHEMA, enabledFromState, envFromPath, leakageFromState,
    pathFromEnv, prescriptionFromState,
  } from "../core/params/feedbackParams.ts";

  /** Build-time KaTeX, cloned on demand. See the texlib note in the markup. */
  const texCache = new Map<string, string>();
  function tex(name: string): string {
    const hit = texCache.get(name);
    if (hit !== undefined) return hit;
    const el = document.querySelector<HTMLElement>(`[data-tex="${name}"]`);
    const html = el ? el.innerHTML : "";
    texCache.set(name, html);
    return html;
  }

  const root = document.querySelector<HTMLElement>("[data-fbe]");
  /* The entry call lives at the BOTTOM of this module, below every const it
     reaches. It used to sit here, above CH_COLORS/ratioFill/fmt/count, and
     worked only because nothing before mount's first `await` touched them --
     one `fmt()` added above that await and the page would have thrown
     ReferenceError at load. */

  type Ch = "winds" | "photoionization" | "radiation";
  const CH_COLORS: Record<Ch | "total", string> = {
    winds: "#9ab8ff", photoionization: "#4fd6c4", radiation: "#f3c95a", total: "#f7f3e2",
  };

  /** Fill fraction for a ratio: threshold (1) sits at 0.62; above it log-compresses. */
  function ratioFill(r: number): number {
    if (r <= 0) return 0;
    if (r <= 1) return 0.62 * r;
    return 0.62 + 0.38 * Math.min(1, Math.log10(r) / Math.log10(12));
  }
  function ratioState(r: number): "bound" | "marginal" | "blow-out" {
    return r >= 1.2 ? "blow-out" : r <= 0.8 ? "bound" : "marginal";
  }
  const fmt = (x: number, d = 1) =>
    x >= 1e4 ? x.toExponential(1) : x.toLocaleString("en-US", { maximumFractionDigits: d });
  /** Exact integer with thousands separators — for COUNTS, which must not
   *  become "1.0e+4" the way fmt's exponential branch renders them. */
  const count = (n: number) => Math.round(n).toLocaleString("en-US");

  async function mount(el: HTMLElement) {
    const canvas = el.querySelector<HTMLCanvasElement>("[data-cluster]")!;
    const status = el.querySelector<HTMLElement>("[data-status]")!;
    const scrub = el.querySelector<HTMLInputElement>("[data-scrub]")!;
    const play = el.querySelector<HTMLButtonElement>("[data-play]")!;
    const clearedOut = el.querySelector<HTMLElement>("[data-cleared]")!;
    const frame = el.querySelector<HTMLElement>("[data-present]");

    let engine: ReturnType<typeof createCloudScene> | null = null;
    let fb: FeedbackRealization | null = null;
    let currentPath = "/data/gravoturb";
    /* Bumped by every select(); a load whose token is stale drops its result. */
    let loadGen = 0;
    let raf = 0;
    /* Autoplay OFF. A 6 s loop against a 1-3 s load meant a reader typically
       arrived mid-expulsion, on a frame the canvas label ("embedded in its natal
       gas") no longer described; it read as a physics animation while running on
       wall-clock time unrelated to the window; and it made the scrub look like
       something already moving rather than something to grab. The layer plan
       asked for "no autoplay; scrub only" and this is that. */
    let playing = false;
    // The animation clock is this float, NOT the range input: a stepped
    // <input type=range> snaps every assignment to its step, so driving the
    // animation through scrub.value quantized the sub-step increments and
    // stalled it. animT drives setExpel; the slider is written for display only.
    let animT = 0;
    let playStart = 0; // wall-clock origin; 0 = recompute from animT next frame
    const PERIOD_MS = 6000;

    const setPlaying = (on: boolean) => {
      playing = on;
      playStart = 0; // resume from the current animT, not from where it began
      play.classList.toggle("is-active", on);
      play.setAttribute("aria-pressed", String(on));
      play.textContent = on ? "❙❙ pause" : "▶ play";
      // `tick` stops scheduling itself when paused, so starting playback has to
      // start the loop again rather than rely on a frame that is still queued.
      if (on && !raf) raf = requestAnimationFrame(tick);
    };
    play.addEventListener("click", () => setPlaying(!playing));

    const seek = (v: number) => {
      animT = Math.min(1, Math.max(0, v));
      scrub.value = String(animT);
      applyScrub(animT);
    };

    // ── realization picker from the manifest (labels never retyped) ──
    const manifest = await fetch("/data/gravoturb/manifest.json").then((r) => r.json());
    const picker = el.querySelector<HTMLElement>("[data-realizations]")!;
    for (const r of manifest.realizations as { label: string; path: string }[]) {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "fbe__pill";
      b.textContent = r.label;
      b.dataset.path = r.path;
      b.setAttribute("aria-pressed", "false");
      b.addEventListener("click", () => void select(r.path));
      picker.appendChild(b);
    }

    const prescription = (): "bjorklund" | "vink" =>
      (el.querySelector<HTMLButtonElement>("[data-presc].is-active")?.dataset.presc as
        "bjorklund" | "vink") ?? "bjorklund";

    /* The address IS the state. Decoded once at mount to seed the controls, and
       rewritten (replaceState, so the back button still leaves the page) on every
       change. Only non-defaults are written, so a fresh load has a clean URL and a
       shared link carries exactly what was changed. */
    const urlState = decode(FEEDBACK_SCHEMA, location.search);

    const cfEl = el.querySelector<HTMLInputElement>("[data-cf]")!;
    const hiiEl = el.querySelector<HTMLInputElement>("[data-hii]")!;
    const coupling = (): "independent" | "simple" | "km09" =>
      (el.querySelector<HTMLButtonElement>("[data-coup].is-active")?.dataset.coup as
        "independent" | "simple" | "km09") ?? "simple";
    /** Every knob the ledger takes, read straight from the controls. */
    const leakage = () => ({
      coveringFraction: +cfEl.value,
      hiiLeak: +hiiEl.value,
      porosityCoupling: coupling(),
    });

    const enabled = (): Record<Ch, boolean> => {
      const on = {} as Record<Ch, boolean>;
      for (const c of el.querySelectorAll<HTMLButtonElement>("[data-ch]"))
        on[c.dataset.ch as Ch] = c.classList.contains("is-active");
      return on;
    };

    /** Push the live controls into the address bar. */
    function writeUrl() {
      const on = enabled();
      const q = encode(FEEDBACK_SCHEMA, {
        env: envFromPath(currentPath) as never,
        presc: prescription() as never,
        cf: +cfEl.value,
        hii: +hiiEl.value,
        coup: coupling() as never,
        winds: on.winds,
        photo: on.photoionization,
        rad: on.radiation,
      });
      history.replaceState(null, "", q ? `${location.pathname}?${q}` : location.pathname);
    }

    /** Set a chip group's pressed state from a value, without firing its handler. */
    /* The ONE exclusive-group toggle. This existed and was used only for URL
       seeding while the pill, prescription and coupling handlers each hand-rolled
       the same loop -- three copies, and `aria-pressed` was written in three
       places for the channel chips with only one of them getting it right. */
    const setGroup = (attr: string, value: string) => {
      for (const b of el.querySelectorAll<HTMLButtonElement>(`[${attr}]`)) {
        const on = b.getAttribute(attr) === value;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-pressed", String(on));
      }
    };

    async function select(path: string) {
      /* Generation token. Two fast pill clicks race: `currentPath`, the lit pill
         and the URL are set synchronously, but the fetches resolve in whatever
         order the network returns them, so the slower realization could install
         its scene after the faster one and leave the page showing one cloud
         under another's labels. Stale responses are dropped here. */
      const gen = ++loadGen;
      currentPath = path;
      setGroup("data-path", path);
      status.textContent = "Loading…";
      const name = path === "/data/gravoturb" ? undefined : path.split("/").pop();
      let scene, budget;
      try {
        [scene, budget] = await Promise.all([
          loadScene(path),
          loadFeedbackRealization(name, { enabled: enabled(), prescription: prescription(), leakage: leakage() }),
        ]);
      } catch (err) {
        /* On a page whose claim IS the picture, silence is the one unacceptable
           failure mode -- sceneHost.ts's words, and it built a reporter for
           exactly this that nothing was calling. A dead fetch used to leave
           "Loading…" on screen forever. */
        if (gen !== loadGen) return;
        status.textContent =
          `Could not load ${name ?? "the fiducial"} — ${err instanceof Error ? err.message : String(err)}`;
        return;
      }
      if (gen !== loadGen) return; // a newer selection won while we waited
      engine?.cleanup();
      /* One three.js scene for the gas AND the stars — see viz/cloudScene. Drag-to-orbit and
         wheel-zoom come from the shared host, so there is no separate interaction layer to
         attach. */
      engine = createCloudScene(canvas, scene);
      fb = budget;
      renderBudget();
      applyScrub(+scrub.value);
      /* Default OFF under reduced motion, but do NOT disable the control.
         sceneHost.ts argues the case at length: motion the reader starts and a
         visible pause stops is what the preference asks for, so denying opt-in
         goes further than the preference does. */
      if (engine.reducedMotion) setPlaying(false);
      // count(), NOT fmt(): fmt switches to exponential above 1e4 and rendered
      // a 10,301-star population as "1.0e+4 stars".
      status.textContent =
        `${count(budget.meta.n_stars as number)} stars · budget is an accounting tool, not a hydro sim`;
      // The environment is part of the address too. This was missed once because
      // the replacement that should have added it silently matched nothing.
      writeUrl();
    }

    /**
     * Announce a non-default wind recipe.
     *
     * Björklund is the default; the prose under the figure is written against
     * it. Vink is not a "wrong" setting — it is a second calibrated model, and
     * switching it changes which channel leads in every environment — so the
     * badge states what changed rather than warning.
     */
    function renderNonDefault(el: HTMLElement) {
      const p = el.querySelector<HTMLElement>("[data-nondefault]")!;
      const parts: string[] = [];
      if (prescription() !== "bjorklund")
        parts.push("wind recipe Vink (2001), with its own calibrated leakage");
      if (Math.abs(+cfEl.value - 0.5) > 1e-9)
        parts.push(`covering fraction ${tex("cf")} = ${(+cfEl.value).toFixed(2)} (default 0.50)`);
      if (Math.abs(+hiiEl.value - 0.5) > 1e-9)
        parts.push(`H II leakage ${(+hiiEl.value).toFixed(2)} (default 0.50)`);
      if (coupling() !== "simple")
        parts.push(coupling() === "km09"
          ? `KM09 porous coupling, which returns no wind boost below ${tex("cf")} ${tex("approx")} 0.56`
          : "wind uncoupled from C_f");
      p.innerHTML = parts.length
        ? `Not the defaults the notes below describe — ${parts.join("; ")}.`
        : "";
      p.hidden = parts.length === 0;
    }

    // ── the budget readouts (bars, verdict, plot, numbers) ──
    function renderBudget() {
      if (!fb) return;
      const L = fb.ledger, g = L.gasExpulsion;
      setBar(el, "momentum", g.gasMomentumRatio);
      setBar(el, "energy", L.energyRatio);
      // stage 1. The regime comes from the TRAJECTORY, which interpolates the
      // real accumulation curve — the ledger no longer carries a second,
      // linear-approximation t_remove for this line to disagree with.
      const s1 = el.querySelector<HTMLElement>("[data-stage1]")!;
      // innerHTML, not textContent: these carry typeset symbols. Everything
      // interpolated is this file's own formatted number — never reader input.
      s1.innerHTML = g.gasExpelled
        ? `Gas expelled — momentum ${g.gasMomentumRatio.toFixed(1)}${tex("times")} the threshold, ${fb.trajectory.removalRegime} removal`
        : `Gas retained — only ${(g.gasMomentumRatio * 100).toFixed(0)}% of the momentum needed; cluster stays embedded`;
      renderChannelStates(el, fb);
      renderNonDefault(el);
      // stage 2
      const s2 = el.querySelector<HTMLElement>("[data-stage2]")!;
      s2.textContent = g.gasExpelled
        ? `Cluster ${g.survivalLabel} — q = ${g.qVirialPost.toFixed(3)} after expulsion (bound below 1): born dynamically cold`
        : `Survival moot while the gas stays`;
      s2.dataset.fate = g.survivalLabel;
      drawPlot(el, fb);
      renderNums(el, fb);
      // The gas is downstream of the ledger now, so re-apply the scrub whenever
      // the ledger moves. Without this, switching a channel off would change
      // the bars and leave the picture exactly as it was — which is the split
      // this phase exists to remove.
      applyScrub(animT);
    }

    /*
     * The scrub is TIME over the pre-SN window, and the gas clears exactly as
     * fast as the budget clears it: `trajectory.clearedFraction` is min(1,
     * p_total(t)/p_needed), so setExpel is downstream of the ledger rather than
     * beside it.
     *
     * IT USED TO BE EXPULSION PROGRESS, decoupled from the numbers, and the
     * argument for that was measured: "the gas clears well before the pre-SN
     * window closes, so time is a poor scrub axis -- the animation would finish
     * in a blink." That was true of the figures then in hand (6.2% of the window
     * for `diffuse`, ~14% for the Orion-like set). Re-measured 2026-09-04 those
     * are 5.2% and 42.5-46.7% -- the Orion-like set clears mid-slider, not in a
     * blink -- so the reason for decoupling had expired. No warp is applied to
     * the axis: a non-linear time scale would buy `diffuse` some room and cost
     * the reader the ability to read the scrub against the plot, which shares
     * this axis.
     *
     * What this buys is the thing the page was missing: turning off a channel
     * now visibly stalls the gas, and `compact` visibly fails to clear at all,
     * because every control that moves the ledger moves the picture with it.
     */
    function applyScrub(tFrac: number) {
      if (!engine) return;
      const tr = fb?.trajectory;
      if (!tr) { engine.setExpel(0); return; }
      const n = tr.clearedFraction.length;
      const x = Math.max(0, Math.min(1, tFrac)) * (n - 1);
      const i = Math.floor(x);
      const a = tr.clearedFraction[i] ?? 0;
      const b = tr.clearedFraction[Math.min(n - 1, i + 1)] ?? a;
      const cleared = a + (b - a) * (x - i);
      engine.setExpel(cleared);
      const tMyr = tFrac * tr.windowMyr;
      clearedOut.textContent =
        cleared <= 0.005
          ? `${tMyr.toFixed(2)} Myr — embedded`
          : cleared >= 0.995
            ? `${tMyr.toFixed(2)} Myr — gas cleared`
            : `${tMyr.toFixed(2)} Myr — gas ${Math.round(cleared * 100)}% expelled`;
      const cur = el.querySelector<SVGLineElement>("[data-plot-cursor]");
      if (cur) {
        const x0 = scaleX(tMyr, tr.windowMyr || 1);
        cur.setAttribute("x1", x0.toFixed(1));
        cur.setAttribute("x2", x0.toFixed(1));
      }
    }

    // ── controls ──
    // Prescription switch. Recomputes from the already-loaded arrays — no
    // refetch — so the two recipes are compared on identical stars.
    for (const b of el.querySelectorAll<HTMLButtonElement>("[data-presc]"))
      b.addEventListener("click", () => {
        setGroup("data-presc", b.dataset.presc ?? "");
        if (!fb) return;
        fb = recomputeFeedback(fb, { enabled: enabled(), prescription: prescription(), leakage: leakage() });
        renderBudget();
        // Every other control does this; this one did not, so the address went
        // stale on the switch the prose calls out as changing which channel
        // leads in every environment.
        writeUrl();
      });

    // Knobs recompute from the loaded arrays; no refetch, so dragging is cheap.
    const onKnob = () => {
      el.querySelector<HTMLOutputElement>("[data-cf-out]")!.value = (+cfEl.value).toFixed(2);
      el.querySelector<HTMLOutputElement>("[data-hii-out]")!.value = (+hiiEl.value).toFixed(2);
      if (!fb) return;
      fb = recomputeFeedback(fb, { enabled: enabled(), prescription: prescription(), leakage: leakage() });
      renderBudget();
      writeUrl();
    };
    cfEl.addEventListener("input", onKnob);
    hiiEl.addEventListener("input", onKnob);
    for (const b of el.querySelectorAll<HTMLButtonElement>("[data-coup]"))
      b.addEventListener("click", () => {
        setGroup("data-coup", b.dataset.coup ?? "");
        onKnob();
      });

    scrub.addEventListener("input", () => { setPlaying(false); animT = +scrub.value; applyScrub(animT); });
    for (const c of el.querySelectorAll<HTMLButtonElement>("[data-ch]"))
      c.addEventListener("click", () => {
        const on = !c.classList.contains("is-active");
        c.classList.toggle("is-active", on);
        c.setAttribute("aria-pressed", String(on));
        if (!fb) return;
        fb = recomputeFeedback(fb, { enabled: enabled(), prescription: prescription(), leakage: leakage() });
        renderBudget();
        writeUrl();
      });
    frame?.addEventListener("present:next", () => { setPlaying(false); seek(animT + 0.04); });
    frame?.addEventListener("present:prev", () => { setPlaying(false); seek(animT - 0.04); });
    frame?.addEventListener("present:reset", () => { setPlaying(false); seek(0); });

    // ── play loop: absolute wall-clock, immune to frame jitter and to the
    // range input's step-snapping (drives animT, writes the slider for show) ──
    function tick(ts: number) {
      /* Only schedule while actually playing. This used to re-arm
         unconditionally as its first statement, so a paused page still ran 60
         callbacks a second forever -- and while playing it defeated sceneHost's
         own IntersectionObserver: `redraw()` paints immediately when the host
         loop is stopped, so setExpel kept a 112-step volumetric raymarch running
         off-screen while the reader was scrolled down reading the prose. */
      if (!playing || !engine) { raf = 0; return; }
      raf = requestAnimationFrame(tick);
      if (!playStart) playStart = ts - animT * PERIOD_MS;
      animT = ((ts - playStart) % PERIOD_MS) / PERIOD_MS;
      scrub.value = String(animT);
      applyScrub(animT);
    }
    /* The loop is started by setPlaying, not here: the page lands paused and a
       paused loop has nothing to do. */
    window.addEventListener("pagehide", () => { cancelAnimationFrame(raf); engine?.cleanup(); });

    /* Seed every control from the address, THEN load. Doing it in this order
       means the first budget is already the shared state — no flash of the
       default followed by a recompute, and no URL rewritten to the default
       before the reader's own link has been read. */
    cfEl.value = String(urlState.cf);
    hiiEl.value = String(urlState.hii);
    setGroup("data-presc", urlState.presc);
    setGroup("data-coup", urlState.coup);
    for (const [attr, on] of [
      ["winds", urlState.winds], ["photoionization", urlState.photo], ["radiation", urlState.rad],
    ] as const) {
      const c = el.querySelector<HTMLButtonElement>(`[data-ch="${attr}"]`);
      if (c) { c.classList.toggle("is-active", on); c.setAttribute("aria-pressed", String(on)); }
    }
    el.querySelector<HTMLOutputElement>("[data-cf-out]")!.value = urlState.cf.toFixed(2);
    el.querySelector<HTMLOutputElement>("[data-hii-out]")!.value = urlState.hii.toFixed(2);

    await select(pathFromEnv(urlState.env));
  }

  // ── small DOM helpers ──
  function setBar(el: HTMLElement, id: string, ratio: number) {
    const bar = el.querySelector<HTMLElement>(`[data-ratiobar="${id}"]`);
    if (!bar) return;
    bar.dataset.state = ratioState(ratio);
    bar.querySelector<HTMLElement>("[data-ratiobar-fill]")!.style.inlineSize =
      `${(ratioFill(ratio) * 100).toFixed(1)}%`;
    bar.querySelector<HTMLElement>("[data-ratiobar-value]")!.innerHTML =
      `${ratio.toFixed(2)}${tex("times")}`;
    // Keep the meter in step with the glyph: the KaTeX multiplication sign is
    // decorative, so the spoken form says "times" in words.
    const meter = bar.querySelector<HTMLElement>("[data-ratiobar-meter]");
    if (meter) {
      meter.setAttribute("aria-valuenow", ratio.toFixed(2));
      meter.setAttribute("aria-valuetext", `${ratio.toFixed(2)} times the threshold`);
    }
  }

  /**
   * Reflect each channel's PHYSICAL availability onto its chip.
   *
   * A channel can be switched off by the reader, or it can be unable to act in
   * this environment at all — `compact`'s H II region is trapped, because the
   * cloud escape speed (20.3 km/s) exceeds the ~10 km/s sound speed of
   * photoionized gas. Those are different states and looked identical: the chip
   * stayed lit and the channel contributed exactly zero, while ledger.ts's
   * `disabledReason` explaining why went unrendered.
   */
  function renderChannelStates(el: HTMLElement, fb: FeedbackRealization) {
    const note = el.querySelector<HTMLElement>("[data-chnote]")!;
    const reasons: string[] = [];
    for (const c of el.querySelectorAll<HTMLButtonElement>("[data-ch]")) {
      const entry = fb.ledger.channels.find((x) => x.name === c.dataset.ch);
      const inert = Boolean(entry?.disabled);
      c.classList.toggle("is-inert", inert);
      c.disabled = inert;
      // The chip is no longer a control when the physics has taken it away, so
      // it stops claiming to be pressable rather than merely looking greyed.
      //
      // DERIVED every render, never set once on the way in: setting it only
      // when inert left the chip announcing aria-pressed="false" after
      // switching back to an environment where the channel works, so it looked
      // pressed and read unpressed. `is-active` is the reader's switch; `inert`
      // is the physics; the announced state is the AND of them.
      c.setAttribute("aria-pressed", String(!inert && c.classList.contains("is-active")));
      c.title = inert ? (entry?.disabledReason ?? "") : "";
      if (inert && entry?.disabledReason) reasons.push(entry.disabledReason);
    }
    note.textContent = reasons.join(" · ");
    note.hidden = reasons.length === 0;
  }

  function renderNums(el: HTMLElement, fb: FeedbackRealization) {
    const L = fb.ledger, m = fb.meta;
    const wb = L.diagnostics.windBudget;
    const rows: [string, string][] = [
      ["window", `${L.windowMyr.toFixed(2)} Myr`],
      [tex("sigma"), `${(m.env_sigma_msun_pc2 as number).toFixed(0)} ${tex("sigmaunit")}`],
      [tex("psi"), L.diagnostics.radiation.psi.toFixed(2)],
      [tex("rch"), `${L.diagnostics.radiation.rCh.toFixed(2)} ${tex("pc")}`],
      [tex("mgas"), `${fmt(L.gasExpulsion.mGas)} ${tex("msun")}`],
      // How much of the population the wind recipe actually covers. winds.ts
      // computes this "so a caller can report how much of the population a
      // recipe actually covers instead of silently summing over a subset" — and
      // no caller did. It is not a footnote: Björklund's box stops at 80 M⊙,
      // above which these clusters keep their most massive stars, so the
      // denominator is the honest context for the wind bar.
      // Counts use toLocaleString, NOT fmt: fmt switches to exponential above
      // 1e4, which rendered a population of 10,301 stars as "1.0e+4".
      ["wind sources", `${count(wb.nDriving)} of ${count(wb.nDriving + wb.nOutOfRange)} stars`],
    ];
    el.querySelector<HTMLElement>("[data-nums]")!.innerHTML = rows
      .map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join("");
  }

  // ── the momentum-vs-time plot (pure SVG from the trajectory) ──
  const PW = 340, PH = 170, PAD = 26;
  function scaleX(t: number, win: number) { return PAD + (t / win) * (PW - PAD - 6); }
  function scaleY(p: number, pmax: number) { return PH - PAD - (p / pmax) * (PH - PAD - 10); }

  function drawPlot(el: HTMLElement, fb: FeedbackRealization) {
    const svg = el.querySelector<SVGSVGElement>("[data-plot]")!;
    const tr = fb.trajectory;
    const win = tr.windowMyr || 1;
    const pmax = Math.max(tr.gasMomentumNeeded, ...tr.totalMomentum) * 1.08 || 1;
    const line = (ys: number[], color: string, w = 1.5) =>
      `<polyline fill="none" stroke="${color}" stroke-width="${w}" points="${
        tr.tMyr.map((t, i) => `${scaleX(t, win).toFixed(1)},${scaleY(ys[i]!, pmax).toFixed(1)}`).join(" ")
      }"/>`;
    const yThresh = scaleY(tr.gasMomentumNeeded, pmax);
    const vline = (t: number, color: string, dash: string, label: string) => {
      if (!isFinite(t) || t <= 0 || t > win) return "";
      const x = scaleX(t, win);
      return `<line x1="${x.toFixed(1)}" y1="8" x2="${x.toFixed(1)}" y2="${PH - PAD}" stroke="${color}" stroke-width="1" stroke-dasharray="${dash}" opacity="0.7"/>`
        + `<text x="${(x + 2).toFixed(1)}" y="16" fill="${color}" font-size="8" font-family="monospace">${label}</text>`;
    };
    svg.innerHTML =
      `<line x1="${PAD}" y1="${PH - PAD}" x2="${PW - 6}" y2="${PH - PAD}" stroke="currentColor" stroke-width="1" opacity="0.4"/>`
      + `<line x1="${PAD}" y1="8" x2="${PAD}" y2="${PH - PAD}" stroke="currentColor" stroke-width="1" opacity="0.4"/>`
      + `<line x1="${PAD}" y1="${yThresh.toFixed(1)}" x2="${PW - 6}" y2="${yThresh.toFixed(1)}" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" opacity="0.55"/>`
      + `<text x="${PW - 8}" y="${(yThresh - 3).toFixed(1)}" text-anchor="end" fill="currentColor" font-size="8" font-family="monospace" opacity="0.7">gas threshold</text>`
      + vline(tr.tCrossMyr, "#c98", "2 2", "t_cross")
      + vline(tr.tRemoveMyr, "#8c8", "2 2", "t_remove")
      + line(tr.windMomentum, CH_COLORS.winds)
      + line(tr.hiiMomentum, CH_COLORS.photoionization)
      + line(tr.radMomentum, CH_COLORS.radiation)
      + line(tr.totalMomentum, CH_COLORS.total, 2)
      // Where the scrub is. Same axis as the curves, so the reader can see the
      // gas clear at the moment the total crosses the threshold line.
      + `<line data-plot-cursor x1="${PAD}" y1="8" x2="${PAD}" y2="${PH - PAD}" stroke="currentColor" stroke-width="1.5" opacity="0.85"/>`
      + `<text x="${PAD}" y="${PH - 8}" fill="currentColor" font-size="8" font-family="monospace" opacity="0.6">0</text>`
      + `<text x="${PW - 6}" y="${PH - 8}" text-anchor="end" fill="currentColor" font-size="8" font-family="monospace" opacity="0.6">${win.toFixed(1)} Myr</text>`;
    el.querySelector<HTMLElement>("[data-legend]")!.innerHTML =
      (["winds", "photoionization", "radiation", "total"] as const)
        .map((c) => `<span style="--c:${CH_COLORS[c]}">${c === "photoionization" ? "H II" : c}</span>`).join("");
  }

  /* Entry point, deliberately last: see the note where this used to be. */
  if (root) void mount(root);
</script>

<style is:global>
  /* GLOBAL, not scoped: the realization pills are created client-side (Astro's
   * data-astro-cid is not stamped on runtime nodes, so scoped rules would miss
   * them — the same trap Census documents). Every selector is .fbe*-prefixed, so
   * nothing leaks. Shared visual language with Census: --xpl-* tokens, pill
   * controls (999px, teal-active), and the radial-gradient panel. */
  .fbe {
    --xpl-ink: var(--ink, #e8e8ea);
    --xpl-dim: var(--ink-dim, #9aa0aa);
    --xpl-teal: var(--spec-teal-bright, #4fd1c5);
    --xpl-rose: var(--spec-rose-bright, #f472b6);
    --xpl-border: var(--border, #2a2c31);
    --xpl-panel: var(--surface-1, #14151a);
    display: grid;
    gap: var(--space-l);
    grid-template-columns: 1fr;
  }
  @media (min-width: 60rem) {
    .fbe { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: start; }
  }
  .fbe__controls { display: grid; gap: 0.7rem; }
  .fbe__toolbar { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-s); flex-wrap: wrap; }
  .fbe__pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  /* ── three tiers ────────────────────────────────────────────────────────
     Weight follows importance: the environment picker reads first, time
     second, channels third, and the modelling knobs sit behind a fold. Each
     tier is separated by a rule rather than by more whitespace, so the groups
     are legible without the column growing. */
  .fbe__tier { display: grid; gap: 0.45rem; padding-block: 0.7rem; }
  .fbe__tier + .fbe__tier { border-block-start: 1px solid var(--bg-hairline, #2b2d38); }
  .fbe__tier-lead {
    font-family: var(--font-mono); font-size: var(--step--2);
    letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-faint);
  }
  .fbe__chiprow { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  /* Time is the axis everything else is read against, so it gets the row to
     itself with the play control beside it rather than above it. */
  /* Play sits on the slider's row, not above its label: the readout is a
     property of the slider and belongs on its line. */
  .fbe__tier--time {
    grid-template-columns: auto 1fr;
    grid-template-areas: "lead head" "play track";
    align-items: center; gap: 0.35rem 0.75rem;
    border-block-start: 1px solid var(--bg-hairline, #2b2d38);
  }
  .fbe__tier--time .fbe__action { grid-area: play; }
  .fbe__tier--time .fbe__scrub {
    grid-area: head / head / track / track;
    display: grid; grid-template-columns: subgrid; margin: 0;
  }
  @supports not (grid-template-columns: subgrid) {
    .fbe__tier--time { grid-template-columns: auto 1fr; }
    .fbe__tier--time .fbe__scrub { display: grid; gap: 0.35rem; }
  }
  .fbe__tier--time .fbe__scrub-head {
    grid-area: head; display: flex; justify-content: space-between;
    align-items: baseline; gap: 0.75rem;
  }
  .fbe__tier--time input[type="range"] { grid-area: track; }

  /* ── the fold ───────────────────────────────────────────────────────────
     Closed by default. `data-nondefault` above still reports any knob that has
     left its default, so folding cannot hide a changed state from the reader. */
  .fbe__adv { border-block-start: 1px solid var(--bg-hairline, #2b2d38); margin-block-start: 0.2rem; }
  .fbe__adv-summary {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem;
    padding-block: 0.7rem; cursor: pointer; list-style: none;
    font-family: var(--font-mono); font-size: var(--step--2);
    letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-dim);
  }
  .fbe__adv-summary::-webkit-details-marker { display: none; }
  .fbe__adv-summary::before {
    content: "▸"; display: inline-block; transition: transform var(--dur-fast) var(--ease-out);
    color: var(--ink-faint);
  }
  .fbe__adv[open] .fbe__adv-summary::before { transform: rotate(90deg); }
  .fbe__adv-summary:hover { color: var(--ink); }
  .fbe__adv-summary:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }
  .fbe__adv-hint {
    text-transform: none; letter-spacing: 0; color: var(--ink-faint);
    font-size: var(--step--2);
  }
  @media (prefers-reduced-motion: reduce) {
    .fbe__adv-summary::before { transition: none; }
  }

  /* pills + chips share the Census chip recipe */
  .fbe__pill, .fbe__chip, .fbe__action {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--step--2);
    color: var(--xpl-dim);
    background: transparent;
    border: 1px solid var(--xpl-border);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    cursor: pointer;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }
  .fbe__pill:hover, .fbe__chip:hover, .fbe__action:hover { color: var(--xpl-ink); border-color: var(--xpl-teal); }
  .fbe__pill.is-active, .fbe__chip.is-active { color: #0a0b0e; background: var(--xpl-teal); border-color: var(--xpl-teal); }

  /* Physically inert in this environment — distinct from switched off by the
     reader. Struck through rather than merely dimmed, so the two states cannot
     be confused at a glance, and :hover does not offer it as pressable. */
  .fbe__chip.is-inert,
  .fbe__chip.is-inert.is-active {
    color: var(--xpl-dim);
    background: transparent;
    border-color: var(--xpl-border);
    border-style: dashed;
    text-decoration: line-through;
    cursor: not-allowed;
    opacity: 0.75;
  }
  .fbe__chip.is-inert:hover { color: var(--xpl-dim); border-color: var(--xpl-border); }
  .fbe__chnote {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--spec-amber, #e8a33d);
    line-height: 1.45;
    margin: 0;
  }
  .fbe__action { color: var(--xpl-ink); white-space: nowrap; }
  .fbe__action.is-active { border-color: var(--xpl-teal); }
  .fbe__action:disabled { opacity: 0.5; cursor: not-allowed; }

  .fbe__scrub { display: grid; gap: 0.3rem; }
  .fbe__scrub-head { display: flex; gap: 0.6em; align-items: baseline; flex-wrap: wrap; font-family: var(--font-mono); font-size: var(--step--2); }
  .fbe__scrub-name { color: var(--xpl-dim); }
  .fbe__cleared { color: var(--xpl-teal); }
  .fbe__endpts { color: var(--xpl-dim); opacity: 0.7; margin-inline-start: auto; }
  .fbe__scrub input[type="range"] { inline-size: 100%; accent-color: var(--xpl-rose); }

  .fbe__channels { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .fbe__channels-lead { font-family: var(--font-mono); font-size: var(--step--2); color: var(--xpl-dim); text-transform: uppercase; letter-spacing: 0.05em; margin-inline-end: 0.1rem; }
  .fbe__status { font-family: var(--font-mono); font-size: var(--step--3, 0.68rem); color: var(--ink-faint); } /* type-scale-exempt: dense status line */

  .fbe__panel {
    display: grid; gap: var(--space-l); align-content: start;
    padding: var(--space-m);
    border: 1px solid var(--xpl-border);
    border-radius: var(--radius, 10px);
    background: radial-gradient(120% 120% at 50% 0%, color-mix(in srgb, var(--xpl-panel) 92%, black), #0a0b0e);
  }

  .fbe__knobs { display: grid; gap: 0.7rem; }
  @media (min-width: 34rem) { .fbe__knobs { grid-template-columns: 1fr 1fr; gap: 0.7rem 1.2rem; } }
  .fbe__knob { display: grid; gap: 0.25rem; }
  .fbe__knob-head {
    display: flex; justify-content: space-between; align-items: baseline; gap: 0.6em;
    font-family: var(--font-mono); font-size: var(--step--2); color: var(--xpl-dim);
  }
  .fbe__knob-head output { color: var(--xpl-teal); font-variant-numeric: tabular-nums; }
  .fbe__knob-head em { font-style: normal; color: var(--xpl-ink); }
  .fbe__knob input[type="range"] { inline-size: 100%; accent-color: var(--xpl-teal); }
  .fbe__knob-foot {
    font-family: var(--font-mono); font-size: var(--step--3, 0.68rem);
    color: var(--ink-faint); opacity: 0.85;
  } /* type-scale-exempt: slider end-label */

  .fbe__nondefault {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    line-height: 1.45;
    color: var(--spec-amber, #e8a33d);
    border-inline-start: 2px solid currentColor;
    padding-inline-start: 0.6em;
  }

  /* verdict is the hero: the answer, in plain language, first */
  .fbe__verdict { display: grid; gap: 0.5rem; }
  .fbe__stage { margin: 0; }
  .fbe__stage--1 { font-size: var(--step-1); line-height: 1.3; color: var(--xpl-ink); }
  .fbe__stage--2 { font-size: var(--step--1); line-height: 1.4; color: var(--xpl-dim); }
  .fbe__stage--2[data-fate="dissolves"] { color: var(--spec-amber, #e8a33d); }

  .fbe__bars { display: grid; gap: var(--space-m); }

  /* everything quantitative-but-secondary folds away */
  .fbe__more { border-block-start: 1px solid var(--xpl-border); padding-block-start: var(--space-s); }
  .fbe__more > summary {
    cursor: pointer; font-family: var(--font-mono); font-size: var(--step--2);
    color: var(--xpl-dim); text-transform: uppercase; letter-spacing: 0.05em;
    list-style: none;
  }
  .fbe__more > summary::-webkit-details-marker { display: none; }
  .fbe__more > summary::before { content: "› "; display: inline-block; transition: transform 0.15s; }
  .fbe__more[open] > summary::before { transform: rotate(90deg); }
  .fbe__plot { margin: var(--space-s) 0 0; display: grid; gap: 0.3rem; }
  .fbe__plot svg { inline-size: 100%; block-size: auto; color: var(--xpl-dim); }
  .fbe__legend { display: flex; flex-wrap: wrap; gap: 0.8em; font-family: var(--font-mono); font-size: var(--step--2); color: var(--xpl-dim); }
  .fbe__legend span { display: inline-flex; align-items: center; gap: 0.35em; }
  .fbe__legend span::before { content: ""; inline-size: 10px; block-size: 2px; background: var(--c); border-radius: 2px; }
  .fbe__nums { display: flex; flex-wrap: wrap; gap: 0.6rem 1.1rem; margin: var(--space-s) 0 0; }
  .fbe__nums div { display: grid; }
  .fbe__nums dt { font-family: var(--font-mono); font-size: var(--step--3, 0.68rem); color: var(--ink-faint); } /* type-scale-exempt: compact stat key */
  .fbe__nums dd { font-family: var(--font-mono); font-size: var(--step--1); color: var(--ink); margin: 0; font-variant-numeric: tabular-nums; }
</style>

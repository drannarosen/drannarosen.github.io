---
/*
 * JaxstroEcosystem — the signature software visualization.
 *
 * The differentiable birth-to-observation pipeline. Shows the five STAGES only:
 * the jaxstro foundation used to repeat here as a card, but it is now row 00 of
 * the list below, so a second copy was pure duplication. Built from the
 * `packages` content collection, not hard-coded nodes.
 *
 * Accessibility: the pipeline is a real ordered list; every node is a link to
 * its detailed card below (so no information is hover-only). Connectors are
 * decorative (aria-hidden). Works with no JavaScript; reduced-motion safe.
 */
import { getPipeline } from "../lib/packages";

/*
 * `compact` is the homepage's version: ONE LINE of linked package names, not
 * the card row. The homepage already ends in a four-card grid, and a second
 * five-card grid above it made the page read as two stacks of boxes saying
 * overlapping things — two of those four cards point at /software, which the
 * strip had just covered.
 *
 * A PROP rather than a second component: the homepage must not be able to show
 * a different chain than /software, which is exactly what retyping the node
 * names into another file would allow.
 */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const { stages: pipeline, steps } = await getPipeline();
if (pipeline.length === 0) {
  // In a build this means real data trouble. In dev it nearly always means the
  // server was started before src/content.config.ts declared this collection,
  // so its content store never learned about it — restart, do not debug.
  throw new Error(
    "packages collection is empty. If the dev server was running when the " +
      "collection was added, restart it: `astro dev stop && astro dev --background`.",
  );
}
---

<figure class:list={["eco", compact && "eco--compact"]}>
  {/* The chain in one line, derived from the same steps drawn below so the
      sentence and the picture cannot disagree. Hidden from screen readers:
      the arrows announce as "right arrow … left right arrow", and the caption
      states the same thing in prose. */}
  {/* Rendered as segments, not one string: as a string the line broke wherever
      it ran out of room, and at some widths that was mid-phrase — "collisional
      / dynamics". Each stage is now unbreakable and the line wraps between
      stages instead. */}
  <p class="eco__chain" aria-hidden="true">
    {steps.map((step, i) => (
      <>
        {i > 0 && <span class="eco__sep">→</span>}
        {step.map((pkg, j) => (
          <>
            {j > 0 && <span class="eco__sep">↔</span>}
            <span class="eco__chain-stage">{pkg.data.stage.toLowerCase()}</span>
          </>
        ))}
      </>
    ))}
  </p>

  {/* Compact: the package names on one line, each a link, with the same
      connectors the full diagram uses. Built from `steps`, so a coupled pair
      shows ↔ here for the same reason it does there. */}
  {compact && (
    <p class="eco__chain-pkgs">
      {steps.map((step, i) => (
        <>
          {i > 0 && <span class="eco__sep" aria-hidden="true">→</span>}
          {step.map((pkg, j) => (
            <>
              {j > 0 && <span class="eco__sep" aria-hidden="true">↔</span>}
              <a class="eco__pkg-link" href={`/software/${pkg.id}`}>{pkg.data.name}</a>
            </>
          ))}
        </>
      ))}
    </p>
  )}

  {!compact && (
  <ol class="eco__pipeline" role="list">
    {
      steps.map((step) => (
        <li class:list={["eco__step", step.length > 1 && "eco__step--coupled"]}>
          {/* Stage + name only. The status badge was identical on all five
              nodes (zero information) and the maturity note repeated the
              readiness meter in the list below, with 35 characters at 11px in
              an 81px box. A diagram shows flow and order; detail lives below. */}
          {step.map((pkg) => (
            <a class="eco__node-link" href={`/software/${pkg.id}`}>
              {/* The same number the package carries in the list below, so the
                  diagram and the list are visibly one thing. */}
              <span class="eco__num" aria-hidden="true">
                {String(pkg.data.order).padStart(2, "0")}
              </span>
              <span class="eco__stage">{pkg.data.stage}</span>
              <span class="eco__name">{pkg.data.name}</span>
            </a>
          ))}
          {step.length > 1 && (
            <span class="eco__couple-label" aria-hidden="true">
              coupled
            </span>
          )}
        </li>
      ))
    }
  </ol>
  )}

  {/* The return path is half the argument, so it is drawn as a path rather
      than mentioned in a caption: a full-width rule under every stage, which
      is the span the gradients actually cross. */}
  <p class="eco__return" aria-hidden="true">
    <span class="eco__return-label">gradients &amp; observing-design information flow back</span>
  </p>

  {compact ? (
    <figcaption class="eco__caption eco__caption--compact">
      The differentiable chain from a cluster's birth to its survey observables.
      <a href="/software">See the software →</a>
    </figcaption>
  ) : (
  <figcaption class="eco__caption">
    The Jaxstro ecosystem: a differentiable model from a cluster's birth to its
    survey observables, returning the gradients that reveal what the data can
    recover. Stellar evolution and collisional dynamics are one coupled step by
    design — a star loses mass while it is being moved, and an encounter changes
    the path it evolves along, so neither finishes before the other begins.
    Every stage composes on the shared <code>jaxstro</code> foundation.
    Select any stage for detail.
  </figcaption>
  )}
</figure>

<style>
  .eco {
    margin: 0;
  }

  /* The chain in one line: the whole argument before any detail. */
  .eco__chain {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: var(--space-3xs);
    margin-block-end: var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    color: var(--ink-dim);
  }
  .eco__chain-stage {
    white-space: nowrap;
  }

  /* Five columns for four steps: the coupled pair spans two, so every package
     node keeps the same width whether or not it shares a step. The gap is wide
     enough to hold an arrow at a size that reads — at --space-2xs the
     connectors were 4px of clearance and looked incidental. */
  .eco__pipeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-m);
    align-items: stretch;
  }

  /* A continuous spine behind every card, so the row reads as one pipeline
     rather than five detached boxes. The cards are opaque, so it shows only in
     the gaps — the arrows then sit ON a line instead of floating in space. */
  .eco__pipeline::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-start: 50%;
    block-size: 1px;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--spec-teal) 85%, transparent),
      color-mix(in srgb, var(--spec-teal) 45%, transparent)
    );
    pointer-events: none;
  }

  .eco__step {
    position: relative;
    display: flex;
    z-index: 1;
  }
  /* The coupled pair is a panel, not a dashed outline: the two share a well,
     which reads as one stage containing two packages rather than as two boxes
     someone drew a rectangle around. */
  .eco__step--coupled {
    grid-column: span 2;
    gap: var(--space-m);
    padding: var(--space-xs);
    background: color-mix(in srgb, var(--spec-teal) 7%, var(--bg-void));
    border: 1px solid color-mix(in srgb, var(--spec-teal) 40%, transparent);
    border-radius: var(--radius-l, var(--radius-m));
  }

  /* Decorative connector between steps, sized to be part of the diagram. */
  .eco__step + .eco__step::before {
    content: "→";
    position: absolute;
    inset-inline-start: calc(var(--space-m) * -1);
    inset-block-start: 50%;
    inline-size: var(--space-m);
    transform: translateY(-50%);
    text-align: center;
    color: var(--spec-teal-bright);
    font-size: var(--step-2);
    line-height: 1;
    pointer-events: none;
  }

  /* …and a two-headed one INSIDE a coupled step: the pair is simultaneous,
     not sequential, which is the one thing this diagram must not blur.
     Drawn on the PANEL, not on the second card: the card sets overflow:hidden
     so its accent rule respects the corner radius, which silently clips any
     pseudo-element positioned outside it — the arrow rendered as nothing. */
  .eco__step--coupled::after {
    content: "↔";
    position: absolute;
    inset-inline-start: 50%;
    inset-block-start: 50%;
    transform: translate(-50%, -50%);
    color: var(--spec-teal-bright);
    font-size: var(--step-2);
    line-height: 1;
    pointer-events: none;
  }
  .eco__step--coupled .eco__node-link {
    position: relative;
    flex: 1;
  }

  /* A chip straddling the panel's top edge, so the label belongs to the group
     rather than hovering above it. */
  .eco__couple-label {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 50%;
    transform: translate(-50%, -50%);
    padding-inline: 0.6em;
    padding-block: 0.15em;
    border: 1px solid color-mix(in srgb, var(--spec-teal) 40%, transparent);
    border-radius: 999px;
    /* Notches the line/border behind it. --bg-void is the page base; there is
       no `--bg` token, and naming one silently yields a transparent label with
       the rule struck through the text. */
    background: var(--bg-void);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--spec-teal-bright) 85%, white);
  }

  /* NOTE: this rule was destroyed by an over-broad regex when the foundation
     card was removed; its selectors were left dangling and silently merged
     into .eco__stage. Restored explicitly. */
  /* A card with a light source: the surface lifts from --bg-surface at the top
     to --bg-deep at the foot, over an accent rule. A flat fill and a hairline
     border read as a wireframe of a card rather than a card. */
  .eco__node-link {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    inline-size: 100%;
    padding: var(--space-m) var(--space-s) var(--space-s);
    text-decoration: none;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--bg-surface) 85%, var(--spec-teal) 4%),
      var(--bg-deep)
    );
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 6%, transparent),
      0 1px 2px rgb(0 0 0 / 0.35);
    overflow: hidden;
    transition:
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  /* The accent rule across the card's head — the one mark that makes the row
     read as instruments rather than nav tiles. */
  .eco__node-link::after {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 2px;
    background: linear-gradient(
      90deg,
      var(--spec-teal-bright),
      color-mix(in srgb, var(--spec-teal) 40%, transparent)
    );
    opacity: 0.55;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .eco__node-link:hover,
  .eco__node-link:focus-visible {
    border-color: color-mix(in srgb, var(--spec-teal) 60%, var(--border));
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 9%, transparent),
      0 6px 16px rgb(0 0 0 / 0.45);
    transform: translateY(-2px);
  }
  .eco__node-link:hover::after,
  .eco__node-link:focus-visible::after {
    opacity: 1;
  }
  /* Motion here is decoration, not information — the hover state still reads
     through border and shadow without it. */
  @media (prefers-reduced-motion: reduce) {
    .eco__node-link {
      transition: border-color var(--dur-base) var(--ease-out);
    }
    .eco__node-link:hover,
    .eco__node-link:focus-visible {
      transform: none;
    }
  }

  .eco__num {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--spec-teal-bright) 60%, var(--ink-faint));
  }

  .eco__stage {
    font-family: var(--font-mono);
    /* Was 0.66rem — unreadably small for the label that carries the pipeline's
       meaning. The name is decoration by comparison; the stage is the point. */
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .eco__name {
    font-family: var(--font-mono);
    /* The package name is what a reader is looking for in this row; at
       --step-0 it sat level with the caption text beneath the diagram. */
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--spec-teal-bright);
  }

  /* The return path is drawn, not described: a rule spanning every stage,
     because that whole span is what the gradients cross. Dusty rose, so the two
     directions never read as one flow — teal goes forward, rose comes back. */
  .eco__return {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-block: var(--space-l) var(--space-2xs);
    isolation: isolate;
  }
  .eco__return::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-start: 50%;
    block-size: 1px;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--spec-rose-bright) 75%, transparent),
      color-mix(in srgb, var(--spec-rose-bright) 25%, transparent)
    );
  }
  /* The arrowhead, at the left end — the direction is the point. */
  .eco__return::after {
    content: "◀";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 50%;
    transform: translate(-10%, -50%);
    font-size: var(--step--2);
    color: color-mix(in srgb, var(--spec-rose-bright) 80%, transparent);
  }
  .eco__return-label {
    position: relative;
    z-index: 1;
    padding-inline: var(--space-xs);
    /* Notches the line/border behind it. --bg-void is the page base; there is
       no `--bg` token, and naming one silently yields a transparent label with
       the rule struck through the text. */
    background: var(--bg-void);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--spec-rose-bright);
  }


  .eco__caption {
    margin-block-start: var(--space-m);
    max-inline-size: var(--width-prose);
    color: var(--ink-soft);
    /* This sentence explains the whole diagram — body copy, not a label. */
    font-size: var(--step-0);
    line-height: 1.6;
  }
  .eco__caption code {
    font-family: var(--font-mono);
    color: var(--spec-teal-bright);
  }

  /* ── Compact: the homepage signpost ─────────────────────────────
     Two lines, no cards. The homepage ends in a four-card grid; a five-card
     grid above it made the page read as two stacks of boxes. */
  /* A step below the package names beneath it, and small enough to hold one
     line at desktop widths — the stage chain reads as a single phrase, so
     wrapping it costs more than the extra size buys. */
  .eco--compact .eco__chain {
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-block-end: var(--space-2xs);
  }
  /* Spacing lives here rather than at the call site: scoped styles in a page
     do not reach into a child component's root. */
  .eco--compact {
    margin-block-end: var(--space-xl);
  }

  .eco__chain-pkgs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: var(--space-3xs);
    font-family: var(--font-mono);
    font-size: var(--step-0);
  }
  .eco__pkg-link {
    color: var(--spec-teal-bright);
    text-decoration: none;
    border-block-end: 1px solid transparent;
  }
  .eco__pkg-link:hover,
  .eco__pkg-link:focus-visible {
    border-block-end-color: currentColor;
  }
  /* Fixed width so every gap in the row is identical. The glyphs differ — ↔ is
     visibly wider than → — so at natural width the coupled pair opened a larger
     gap than the sequential steps and the row read as unevenly spaced. */
  .eco__sep {
    display: inline-block;
    inline-size: 1.35em;
    text-align: center;
    color: color-mix(in srgb, var(--spec-teal) 70%, transparent);
  }
  .eco--compact .eco__return {
    margin-block: var(--space-m) 0;
  }
  .eco--compact .eco__return-label {
    font-size: var(--step--2);
  }
  .eco__caption--compact {
    margin-block-start: var(--space-s);
    max-inline-size: none;
    font-size: var(--step--1);
    color: var(--ink-dim);
    text-align: center;
  }
  .eco__caption--compact a {
    margin-inline-start: var(--space-2xs);
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  /* ── Narrow screens: stack the pipeline vertically ─────────────── */
  @media (max-width: 52rem) {
    .eco__pipeline {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
    .eco__step--coupled {
      grid-column: auto;
      flex-direction: column;
      gap: var(--space-m);
    }
    .eco__step + .eco__step::before {
      content: "↓";
      inset-inline-start: 50%;
      inset-block-start: calc(var(--space-m) * -1);
      transform: translate(-50%, -30%);
    }
    /* Stacked, the pair reads top-to-bottom, so the coupling arrow must too. */
    .eco__step--coupled .eco__node-link + .eco__node-link::before {
      content: "↕";
      inset-inline-start: 50%;
      inset-block-start: calc(var(--space-m) * -1);
      transform: translate(-50%, -30%);
    }
    .eco__chain {
      text-align: start;
    }
  }
</style>

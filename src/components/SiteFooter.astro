---
/*
 * SiteFooter — affiliation, direct email (no form), profile links, and
 * authorship/license line. Only links with a known href render (see site.ts).
 */
import { siteConfig, activeLinks } from "../lib/site";
import ProfileIcon from "./ProfileIcon.astro";

const links = activeLinks();
const year = 2026; // build-time constant; bump on next content refresh
---

<footer class="site-footer">
  <div class="site-footer__inner wrap-wide">
    <div class="site-footer__identity">
      <p class="site-footer__name">{siteConfig.name}</p>
      <p class="site-footer__meta">
        {siteConfig.title}, {siteConfig.affiliation}
      </p>
      <a class="site-footer__email" href={`mailto:${siteConfig.email}`}>
        {siteConfig.email}
      </a>
    </div>

    {
      links.length > 0 && (
        <nav class="site-footer__links" aria-label="Profiles and documents">
          <ul role="list">
            {links.map((l) => (
              <li>
                {/* rel="me" is the point of this row: it is the machine-readable
                    claim that these profiles are the same person as this site. */}
                <a href={l.href} rel="me noopener">
                  {l.icon && <ProfileIcon name={l.icon} />}
                  <span>{l.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>

  {/* Attributed on purpose. This site ships a public AI-provenance badge and a
      build gate that refuses unreviewed AI content; quoting a model without
      saying so would contradict all of it for the sake of a joke. */}
  <div class="site-footer__quote wrap-wide">
    <blockquote>
      <p>The universe may be cruel, but at least it's consistent.</p>
      <footer>
        <cite>ChatGPT</cite>
      </footer>
    </blockquote>
  </div>

  {/*
    The pages that are not in the header. The primary nav is capped at nine, so
    these need a second path that is not just /about's "Elsewhere" block — a
    reader deep in a post should not have to go via the biography to reach
    them. Keep this list in sync with that block: they are the same three.
  */}
  <nav class="site-footer__more wrap-wide" aria-label="More pages">
    <a href="/now">Now</a> ·{" "}
    <a href="/news">News</a> ·{" "}
    <a href="/outreach">Outreach</a>
  </nav>

  <div class="site-footer__legal wrap-wide">
    <p>
      © {year} {siteConfig.name}. Views are the author's own. ·{" "}
      <a href="/search">Search</a> ·{" "}
      <a href="/astrobytes/rss.xml">RSS</a>
    </p>
    <p>
      Built with Astro. Source on GitHub. Content licensed for reuse with
      attribution unless noted.
    </p>
  </div>
</footer>

<style>
  /* Quiet by design: it appears on every page, so it has to read as a
     signature rather than a punchline. */
  .site-footer__quote {
    padding-block: var(--space-m) 0;
  }
  .site-footer__quote blockquote {
    margin: 0;
    max-inline-size: 52ch;
  }
  .site-footer__quote p {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .site-footer__quote footer {
    margin-block-start: var(--space-3xs);
  }
  .site-footer__quote cite {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-style: normal;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }
  .site-footer__quote cite::before {
    content: "— ";
  }

  .site-footer {
    margin-block-start: var(--space-3xl);
    border-block-start: 1px solid var(--border);
    background: var(--bg-deep);
    padding-block: var(--space-xl);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    justify-content: space-between;
    align-items: start;
  }
  .site-footer__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--ink);
  }
  .site-footer__meta {
    color: var(--ink-dim);
    font-size: var(--step--1);
    margin-block: var(--space-3xs) var(--space-2xs);
  }
  .site-footer__email {
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .site-footer__links ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  /* Icon and label are one target and wrap together — a row that broke between
     a mark and its word would read as an unlabelled glyph. */
  .site-footer__links a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    white-space: nowrap;
  }
  /* These inherit the site's link style — teal and underlined, exactly like the
     email above them. They used to be grey with the underline held back until
     hover, which reads as plain text: there is currently ONE active profile
     link (ORCID; the others are null in site.ts), so it sat alone with nothing
     beside it to suggest the row was navigable at all. A link that only looks
     like a link once the pointer is on it cannot be found by someone who has
     not already guessed. */
  .site-footer__links a:hover {
    color: var(--ink);
  }
  .site-footer__more {
    margin-block-start: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  .site-footer__legal {
    margin-block-start: var(--space-m);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-l);
    justify-content: space-between;
    color: var(--ink-faint);
    font-size: var(--step--1);
  }
</style>

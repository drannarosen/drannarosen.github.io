---
/*
 * ProfileIcon — a small mark beside a profile link.
 *
 * Inline SVG, never an icon font or a CDN sprite: the site ships no external
 * requests, and an icon that fails to load leaves a link looking broken.
 *
 * MONOCHROME, inheriting `currentColor`. These sit in a row of teal text links,
 * and three saturated brand colours (ORCID green, Scholar blue, LinkedIn blue)
 * would be the loudest thing in the footer while carrying no more information
 * than the word beside them. They are simplified marks — recognisable in
 * silhouette at 1em — not the official trademarked logos; the label is always
 * rendered too, so recognition never depends on the glyph.
 *
 * Decorative by design: every icon is aria-hidden because the link's visible
 * text already names the destination. An icon that repeats the label to a
 * screen reader is noise.
 */
interface Props {
  name: "orcid" | "scholar" | "linkedin" | "github";
}
const { name } = Astro.props;
---

<svg
  class="pico"
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "orcid" && (
      <>
        <circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.6" />
        <circle cx="8.4" cy="6.9" r="1.15" fill="currentColor" />
        <rect x="7.6" y="9.4" width="1.6" height="8.2" fill="currentColor" />
        {/* The D bowl: a stem with an arc closing back to it. */}
        <path
          d="M11.6 9.4h3.3a4.1 4.1 0 0 1 0 8.2h-3.3z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
      </>
    )
  }
  {
    name === "scholar" && (
      <>
        {/* Mortarboard over a book — Scholar's silhouette. */}
        <path d="M12 3 1.5 8.4 12 13.8l10.5-5.4z" fill="currentColor" />
        <path
          d="M5.6 10.8v4.1c0 2.2 2.9 3.9 6.4 3.9s6.4-1.7 6.4-3.9v-4.1"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
        />
      </>
    )
  }
  {
    name === "linkedin" && (
      <>
        <rect x="1.5" y="1.5" width="21" height="21" rx="3.2" fill="none" stroke="currentColor" stroke-width="1.6" />
        <circle cx="7" cy="7.1" r="1.3" fill="currentColor" />
        <rect x="6" y="9.9" width="2" height="8" fill="currentColor" />
        {/* The n: a stem, and a shoulder rising into a second stem. */}
        <path
          d="M11.2 17.9v-8m0 2.6a2.9 2.9 0 0 1 5.6 1.1v4.3"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        />
      </>
    )
  }
  {
    name === "github" && (
      <path
        d="M12 1.8a10.2 10.2 0 0 0-3.2 19.9c.5.1.7-.2.7-.5v-1.9c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 3 .8.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.5 9.5 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7 1 .7 2v2.9c0 .3.2.6.7.5A10.2 10.2 0 0 0 12 1.8z"
        fill="currentColor"
      />
    )
  }
</svg>

<style>
  .pico {
    /* Sits on the text baseline rather than the line box, so the mark aligns
       with the label instead of riding above it. */
    vertical-align: -0.13em;
    flex: none;
  }
</style>
